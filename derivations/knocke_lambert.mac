/* Which cosine Lambert's law puts in the Knocke sum, and what Orekit's choice costs.

   `spacelab-propagation::earth_radiation` sums, over elements dA of a sphere of radius R seen from a
   satellite at r, the flux

       dF = M dA cos(alpha) (r - p) / (pi |r - p|^3),    M = a Phi cos(theta_sun) + e Phi/4,

   which is Lambert's law when alpha is the angle between the element's normal p/|p| and the ray
   r - p it emits along. Orekit 13.1.7's `KnockeRediffusedForceModel.computeElementaryFlux` takes
   cos(alpha) = p.r/(|p||r|) instead, the geocentric angle between the element and the satellite
   (read from its bytecode with javap). The two agree only at the sub-satellite point.

   A uniform Lambertian sphere settles which is right: a flat plate facing it at distance r receives
   M (R/r)^2, the sphere's view factor, and at r -> R a plate on the surface receives the exitance M
   itself, which nothing can exceed. Writing x = cos(gamma) for the element's angle from the
   sub-satellite point, the radial flux is an integral over x from R/r (the horizon) to 1; it is
   done here in the slant distance q, where both integrands are rational.                         */

must(ok, what) := if ok then print(what) else error("FAILED:", what)$
assume(r > R, R > 0, q > 0)$
xq : (r^2 + R^2 - q^2)/(2*r*R)$
dxdq : diff(xq, q)$
/* d(Omega) R^2 dx over the azimuth, times the radial component (r - R x)/q of the ray. */
emission : (r*x - R)/q$
geocentric : x$
radial(w, e) := block([A],
  A : integrate(ratsimp(subst(x = xq, 2*R^2*e*w*(r - R*x)/q^3)*(-dxdq)), q),
  subst(q = sqrt(r^2 - R^2), A) - subst(q = r - R, A))$

/* ---- (1) the view factor ---------------------------------------------------------------------- */
FL : radial(emission, 1)$
FG : radial(geocentric, 1)$
must(is(ratsimp(radcan(FL - R^2/r^2)) = 0),
     "(1) holds: Lambert's cosine gives the view factor (R/r)^2 exactly")$
print("Orekit's cosine gives", ratsimp(radcan(FG)))$
ratio(h) := float(subst([R = 6378137, r = 6378137 + h], FG/FL))$
print("  over the view factor: 500 km", ratio(500e3), " 2000 km", ratio(2000e3),
      " 20200 km", ratio(20200e3))$
must(is(ratsimp(limit(radcan(FG), r, R, plus)) = 2),
     "(1) holds: at the surface Orekit's cosine gives 2M, twice the exitance")$
must(is(limit(radcan(FL), r, R, plus) = 1),
     "(1) holds: at the surface Lambert's cosine gives M")$

/* ---- (2) the visibility gate ----------------------------------------------------------------- *
   p.(r - p) > 0 is x > R/r: the emission cosine's sign is the horizon the crown walk stops at,
   while Orekit's p.r > 0 is a hemisphere the walk never reaches.                                 */
must(is(ratsimp(subst(x = R/r, r*x - R)) = 0),
     "(2) holds: the emission cosine vanishes exactly on the horizon x = R/r")$

/* ---- (3) the element areas are exact, not first-order ---------------------------------------- */
assume(D > 0, D < %pi)$
cap : integrate(integrate(R^2*sin(g), g, 0, D), f, 0, 2*%pi)$
must(is(ratsimp(cap - 2*%pi*R^2*(1 - cos(D))) = 0),
     "(3) holds: the central cap is 2 pi R^2 (1 - cos D)")$
sector : D*R^2*(cos(g0 - D/2) - cos(g0 + D/2))$
must(is(trigsimp(trigexpand(sector - R^2*2*D*sin(D/2)*sin(g0))) = 0),
     "(3) holds: a sector of a crown is R^2 2 D sin(D/2) sin(g0)")$

/* ---- (4) polar night, the test's closed forms ------------------------------------------------
   500 km over the pole with the Sun beneath it: no albedo, and Knocke's emissivity
   e = E0 + E1 P1(x) + E2 P2(x) with x the element's sine of latitude, E1 = K1 at the reference
   epoch. Phi = ES_COEFF c at 1 AU; the flux carries the 1/c.                                     */
fpprec : 30$
ex : 68/100 - 7/100*x - 18/100*(3*x^2 - 1)/2$
at_pole : [R = 637813646/100, r = 637813646/100 + 500000]$
k : 45606/10^10/4$
lambert_z : bfloat(k*subst(at_pole, radial(emission, ex)))$
orekit_z : bfloat(k*subst(at_pole, radial(geocentric, ex)))$
print("polar night, Lambert's cosine:", lambert_z)$
print("polar night, Orekit's cosine: ", orekit_z, " ratio", orekit_z/lambert_z)$
must(is(abs(lambert_z/4.2495742060546961b-7 - 1) < 10^-16)
     and is(abs(orekit_z/8.4737886501643365b-7 - 1) < 10^-16),
     "(4) holds: the test's LAMBERT and OREKIT constants are these two integrals")$

/* The same two numbers by quadrature in x, so the closed forms are not trusted alone. */
rho : sqrt(r^2 + R^2 - 2*r*R*x)$
x_hor : float(subst(at_pole, R/r))$
ql : k*quad_qags(float(subst(at_pole, 2*R^2*ex*(r*x - R)*(r - R*x)/rho^4)), x, x_hor, 1,
                 'epsrel = 1e-13)[1]$
qg : k*quad_qags(float(subst(at_pole, 2*R^2*ex*x*(r - R*x)/rho^3)), x, x_hor, 1,
                 'epsrel = 1e-13)[1]$
print("quadrature:", float(ql), float(qg))$
must(is(abs(ql/lambert_z - 1) < 1e-10) and is(abs(qg/orekit_z - 1) < 1e-10),
     "(4) holds: quadrature agrees with both closed forms to 1e-10")$

/* ---- (5) the central cap, exactly (plans/17 Ф17.F) ---------------------------------------------
   The grid's central cap of half-angle D about the sub-satellite point is one element: its whole area
   2 pi R^2 (1 - cos D) at the sub-satellite point, a distance r - R away, with both cosines 1. That is
   the first term of the cap's integral only. The cap's own integral is radial(emission, 1) taken from
   x = cos D instead of the horizon; cut at the horizon when D reaches past it.                      */
assume(c0 > R/r, c0 < 1)$
cap_exact : block([A],
  A : integrate(ratsimp(subst(x = xq, 2*R^2*emission*(r - R*x)/q^3)*(-dxdq)), q),
  subst(q = sqrt(r^2 + R^2 - 2*r*R*c0), A) - subst(q = r - R, A))$
closed : R^2*(1 - c0^2)/(r^2 + R^2 - 2*r*R*c0)$
must(is(ratsimp(radcan(cap_exact - closed)) = 0),
     "(5) holds: the cap of half-angle D gives R^2 sin^2 D / (r^2 + R^2 - 2 r R cos D)")$
must(is(ratsimp(subst(c0 = R/r, closed) - R^2/r^2) = 0),
     "(5) holds: at the horizon the cap is the whole view factor (R/r)^2")$
/* The rim distance in the form the code evaluates, free of the cancellation in 1 - cos D. */
must(is(trigsimp(trigreduce((r - R)^2 + 4*r*R*sin(D/2)^2 - (r^2 + R^2 - 2*r*R*cos(D)))) = 0),
     "(5) holds: r^2 + R^2 - 2 r R cos D = (r - R)^2 + 4 r R sin^2(D/2)")$
/* A crown between half-angles D1 < D2 (cosines c1 > c2) integrated directly, against the
   difference of the two caps the code takes. */
assume(c2 > R/r, c2 < c1, c1 < 1)$
crown : block([A],
  A : integrate(ratsimp(subst(x = xq, 2*R^2*emission*(r - R*x)/q^3)*(-dxdq)), q),
  subst(q = sqrt(r^2 + R^2 - 2*r*R*c2), A) - subst(q = sqrt(r^2 + R^2 - 2*r*R*c1), A))$
must(is(ratsimp(radcan(crown - (subst(c0 = c2, closed) - subst(c0 = c1, closed)))) = 0),
     "(5) holds: a crown is the difference of its two caps")$
/* The lumped element: area/(pi (r - R)^2), both cosines 1. */
lumped : 2*R^2*(1 - cos(D))/(r - R)^2$
capD : subst(c0 = cos(D), closed)$
must(is(ratsimp(taylor(capD - lumped, D, 0, 2)) = 0),
     "(5) holds: the lumped cap is the exact cap's series to D^2, so its error starts at D^4")$
print("  the D^4 term of exact minus lumped:", factor(ratsimp(coeff(taylor(capD - lumped, D, 0, 4), D, 4))))$
/* Measured, not quoted: the exact cap, cut at the horizon, and the lumped cap over it, at 30 digits
   with the R of the Rust test (`the_central_cap_is_its_closed_form`), Orekit's 6378136.46 m. */
fpprec : 30$
cap_at(h, deg) := block([Rv : 637813646/100, rv, Dv, cv],
  rv : Rv + h, Dv : bfloat(deg*%pi/180), cv : max(cos(Dv), bfloat(Rv/rv)),
  [bfloat(subst([R = Rv, r = rv, c0 = cv], closed)),
   bfloat(subst([R = Rv, r = rv, D = Dv], lumped)/subst([R = Rv, r = rv, c0 = cv], closed))])$
for h in [500000, 20000000] do for deg in [1, 15, 30] do
  print("  cap and lumped over exact,", h, "m,", deg, "deg:", cap_at(h, deg))$

/* ---- (6) the flux across r, under an exitance that varies across it (plans/17 Ф17.F) -----------
   A uniform sphere's flux lies along r, so it cannot test where the grid's rays point. The exitance
   1 + m sin(gamma) cos(phi) = 1 + m p.e/|p|, with e a unit vector across r and phi the element's
   azimuth from it, pushes the flux along e. The element at (x = cos(gamma), phi) has area
   R^2 dx dphi and emits along r - p, whose component along r is r - R x and along e is
   -R sin(gamma) cos(phi). sg stands for sin(gamma) until the azimuth is integrated out.          */
qq : r^2 + R^2 - 2*r*R*x$
element(component) := (1 + m*sg*cos(phi))*(r*x - R)/sqrt(qq)*component*R^2/(%pi*qq^(3/2))$
radial_phi : ratsimp(integrate(element(r - R*x), phi, 0, 2*%pi))$
across_phi : ratsimp(subst(sg = sqrt(1 - x^2), integrate(element(-R*sg*cos(phi)), phi, 0, 2*%pi)))$
must(is(ratsimp(radial_phi - 2*R^2*(r*x - R)*(r - R*x)/qq^2) = 0),
     "(6) holds: the varying part leaves the radial flux the uniform sphere's, (R/r)^2")$
across_kernel : -R^3*(1 - x^2)*(r*x - R)/qq^2$
must(is(ratsimp(across_phi - m*across_kernel) = 0),
     "(6) holds: over the azimuth, the flux along e is m times -R^3 (1 - x^2)(r x - R)/q^4 dx")$
/* The antiderivative's logs take negative arguments, log(-(r - R)^2) and log(R^2 - r^2), whose
   i pi parts cancel in the difference. */
across_A : integrate(across_kernel, x)$
across_closed : ((3*r^2 + R^2)*(r^2 - R^2)*log((r - R)/(r + R))
                 + 2*R*(r - R)*(3*r^2 + 3*R*r + 2*R^2))/(16*R*r^3)$
must(is(ratsimp(logcontract(subst(x = 1, across_A) - subst(x = R/r, across_A) - across_closed)) = 0),
     "(6) holds: from the horizon, it is ((3r^2 + R^2)(r^2 - R^2) log((r - R)/(r + R)) + 2R(r - R)(3r^2 + 3rR + 2R^2))/(16 R r^3)")$
/* At 30 digits with the R of the Rust test (`a_varying_exitance_pushes_the_flux_across_r`), and by
   quadrature in x. */
across_at(h) := block([Rv : 637813646/100],
  bfloat(subst([R = Rv, r = Rv + h], across_closed)))$
across_quad(h) := block([Rv : 637813646/100],
  quad_qags(float(subst([R = Rv, r = Rv + h], across_kernel)), x, float(Rv/(Rv + h)), 1,
            'epsrel = 1e-13)[1])$
for h in [500000, 20000000] do
  print("  flux along e per unit m,", h, "m:", across_at(h), " quadrature", across_quad(h))$
must(every(lambda([h], is(abs(across_quad(h)/across_at(h) - 1) < 1e-10)), [500000, 20000000]),
     "(6) holds: quadrature agrees with the closed form to 1e-10 at 500 km and 20 000 km")$

/* ---- (7) a linear exitance summed exactly (plans/17 Ф17.H) -------------------------------------
   The grid samples the exitance at one colatitude per crown, at n azimuths (k + 1/2) 2 pi/n. The
   central cap is the crown from x = 1. A crown carries three moments of the kernel: V, its view
   factor (5); W, its first moment in the versine y = 1 - x; and T, its flux across r per unit of
   sin(gamma) cos(phi) (6). In the slant distance squared s = q^2, with A = r^2 - R^2, d = r - R,
   the crown's edges s1 < s2, D = s2 - s1 and L = log(s2/s1), each is a closed form. Each is checked
   by its derivative in s2, the kernel times |dx/ds| = 1/(2 r R), and by its zero at s2 = s1.     */
assume(s1 > 0, s2 > 0)$
A : r^2 - R^2$
d : r - R$
xs : (r^2 + R^2 - s)/(2*r*R)$
kernel_s : 2*R^2*(r*x - R)*(r - R*x)/s^2$
across_s : -R^3*(1 - x^2)*(r*x - R)/s^2$
V_s : D*(A^2 - s1*s2)/(4*r^2*s1*s2)$
W_s : (A^2*L - D*((s1 + s2)/2 + d^2*A^2/(s1*s2) - d^2))/(8*r^3*R)$
T_s : -(A*(3*r^2 + R^2)*L + D*((s1 + s2)/2 - (3*r^2 + R^2) - A^3/(s1*s2)))/(16*r^3*R)$
in_s(e) := subst([D = s2 - s1, L = log(s2) - log(s1)], e)$
moment_ok(e, k) := is(ratsimp(diff(in_s(e), s2) - subst(s = s2, subst(x = xs, k))/(2*r*R)) = 0)
                   and is(ratsimp(subst(s2 = s1, in_s(e))) = 0)$
must(moment_ok(V_s, kernel_s), "(7) holds: V = D (A^2 - s1 s2)/(4 r^2 s1 s2)")$
must(moment_ok(W_s, (1 - x)*kernel_s),
     "(7) holds: W = (A^2 L - D ((s1 + s2)/2 + d^2 A^2/(s1 s2) - d^2))/(8 r^3 R)")$
must(moment_ok(T_s, across_s),
     "(7) holds: T = -(A (3r^2 + R^2) L + D ((s1 + s2)/2 - (3r^2 + R^2) - A^3/(s1 s2)))/(16 r^3 R)")$
/* The code writes A^2 - s1 s2 as A a1 + s1 a2, a = A - s = 2 R (r x - R) the edge's height above
   the horizon, so V has no cancellation, and a crown's width as D = 2 r R (x1 - x2), or a1 when it
   ends at the horizon. */
must(is(ratsimp(A^2 - s1*s2 - (A*(A - s1) + s1*(A - s2))) = 0),
     "(7) holds: A^2 - s1 s2 = A a1 + s1 a2")$
must(is(ratsimp(A - subst(x = c, r^2 + R^2 - 2*r*R*x) - 2*R*(r*c - R)) = 0),
     "(7) holds: a = A - s = 2 R (r x - R)")$
/* The sample. Under the exitance a0 + bz x + sin(gamma)(be cos(phi) + bh sin(phi)), the crown's flux
   along r is a0 V + bz (V - W) and across it T (be, bh). The grid evaluates the exitance at
   x_s = 1 - W/V and at each azimuth phi_k, and weights it by V/n along r and by 2 T/(n sin(gamma_s))
   along the azimuth's unit vector. Along r it sums V (a0 + bz x_s) = a0 V + bz (V - W). Across it
   the constant part cancels and the varying part sums to T (be, bh), because for n >= 3 the
   azimuths give sum cos = sum sin = sum cos sin = 0 and sum cos^2 = sum sin^2 = n/2. n = 2 fails
   the last two, so the grid takes at least three sectors. */
fpprec : 30$
azimuth_sums(n) := block([p : makelist(bfloat((k + 1/2)*2*%pi/n), k, 0, n - 1)],
  map(lambda([f], apply("+", map(f, p))),
      [cos, sin, lambda([t], cos(t)*sin(t)), lambda([t], cos(t)^2 - 1/2), lambda([t], sin(t)^2 - 1/2)]))$
must(every(lambda([n], every(lambda([v], is(abs(v) < 1b-25)), azimuth_sums(n))),
           makelist(n, n, 3, 64)),
     "(7) holds: for n = 3 ... 64 sectors the five azimuth sums vanish")$
must(not every(lambda([v], is(abs(v) < 1b-25)), azimuth_sums(2)),
     "(7) holds: for n = 2 they do not")$
/* The visible cap's first moment, x_tot = V - W from the sub-satellite point (s1 = d^2) to the
   horizon (s2 = A), the radial flux of the exitance x, at 30 digits for the Rust test
   (`a_linear_exitance_is_summed_exactly`), and by quadrature in x. */
x_total : ratsimp(subst([s1 = d^2, s2 = A, D = A - d^2, L = log(A/d^2)], V_s - W_s))$
x_at(h) := block([Rv : 637813646/100], bfloat(subst([R = Rv, r = Rv + h], x_total)))$
x_quad(h) := block([Rv : 637813646/100],
  quad_qags(float(subst([R = Rv, r = Rv + h], x*2*R^2*(r*x - R)*(r - R*x)/qq^2)), x,
            float(Rv/(Rv + h)), 1, 'epsrel = 1e-13)[1])$
t_total : ratsimp(subst([s1 = d^2, s2 = A, D = A - d^2, L = log(A/d^2)], T_s))$
must(is(ratsimp(logcontract(t_total - across_closed)) = 0),
     "(7) holds: T over the visible cap is (6)'s closed form")$
for h in [500000, 20000000] do
  print("  first moment of the cap,", h, "m:", x_at(h), " quadrature", x_quad(h))$
must(every(lambda([h], is(abs(x_quad(h)/x_at(h) - 1) < 1e-10)), [500000, 20000000]),
     "(7) holds: quadrature agrees with the first moment to 1e-10 at 500 km and 20 000 km")$

/* ---- (8) a thin crown, where the closed forms cancel (plans/17 Ф17.H) -------------------------
   For D << s1, A^2 L and the D (...) beside it in W and T agree in their leading digits, so in f64
   the difference loses digits as D/s1 shrinks; V has no such difference. The code
   takes a crown with D < s1 by 12-point Gauss-Legendre in s instead. The reference: the crown from
   40 to 40.01 degrees at 35 786 km, D/s1 = 4e-5, its three moments from the closed forms at 60
   digits, printed at 30 for the Rust test (`a_thin_crown_keeps_its_digits`), and by quadrature in
   x, where V, W and T are the integrals of the kernel, (1 - x) times it and the across kernel. */
fpprec : 60$
thin_edges : block([Rv : 637813646/100, h : 35786000, t1 : 40*%pi/180, t2 : 4001*%pi/18000],
  [Rv, Rv + h, Rv^2 + (Rv + h)^2 - 2*Rv*(Rv + h)*cos(t1), Rv^2 + (Rv + h)^2 - 2*Rv*(Rv + h)*cos(t2),
   cos(t1), cos(t2)])$
thin(e) := block([Rv : thin_edges[1], rv : thin_edges[2]],
  bfloat(subst([R = Rv, r = rv],
    subst([D = thin_edges[4] - thin_edges[3], L = log(thin_edges[4]/thin_edges[3]),
           s1 = thin_edges[3], s2 = thin_edges[4]], e))))$
thin_quad(k) := block([Rv : float(thin_edges[1]), rv : float(thin_edges[2])],
  quad_qags(float(subst([R = Rv, r = rv, s = Rv^2 + rv^2 - 2*Rv*rv*x], k)), x,
            float(thin_edges[6]), float(thin_edges[5]), 'epsrel = 1e-13)[1])$
thin_moments : map(thin, [V_s, W_s, T_s])$
thin_quads : map(thin_quad, [kernel_s, (1 - x)*kernel_s, across_s])$
fpprintprec : 30$
print("  thin crown at 35 786 km, 40 to 40.01 degrees: D/s1 =",
      float(thin((s2 - s1)/s1)))$
print("  V, W, T:", thin_moments)$
print("  quadrature:", thin_quads)$
fpprintprec : 0$
must(every(lambda([m, q], is(abs(q/m - 1) < 1e-9)), thin_moments, thin_quads),
     "(8) holds: the thin crown's closed-form moments agree with quadrature to 1e-9")$

print("DONE")$
