/* The literals of a Rust table, read from the source as written (plans/17 Ф17.D).

   A table transcribed from a derivation's output is only as good as the transcription. These
   helpers let the derivation read the committed table back and hold every entry against the value
   it derives. `rust_table(path, name)` returns the literals of `const NAME: ... = [ ... ];` in
   order, flattened, as the text the source shows: a literal, or a quotient `p / q` of two;
   `rust_scalar(path, name)` the one entry of `const NAME: f64 = ...;`, `rust_scalars` every copy of
   it, `rust_literals_between(path, begin, finish)` the literals written inline between two lines,
   `rust_signature_defaults(path, fn)` the defaults of a `#[pyo3(signature = ...)]`,
   `assigned_literals(path, name)` every literal written as `name = <literal>`, and
   `c_define(path, name)` the value of a C `#define NAME <literal>`.
   `rust_rational` reads one as the exact rational it denotes and `rust_number` as a bigfloat at the
   current fpprec. `same_rationals(entries, exact)` is true when each entry is exactly its rational;
   `same_doubles` when each parses to the double its exact value rounds to; `transcribed` when each
   is its exact value rounded to the digits it shows. rustc's parse plays no part, so a wrong digit
   cannot hide behind it.

   load("rust_literals.mac")$ from derivations/, as verify.sh runs the derivations.               */

rust_digits(t) := ssubst("", "f32", ssubst("", "f64", ssubst("", "_", strim(" ", t))))$

/* A Rust float literal, `_` separators, an exponent and an `f64` suffix allowed, as the exact
   rational its decimal text denotes. */
rust_decimal(t) := block([u : rust_digits(t), ex : 0, at, sign : 1, point],
  at : ssearch("e", ssubst("e", "E", u)),
  if at # false then (ex : parse_string(substring(u, at + 1)), u : substring(u, 1, at)),
  if charat(u, 1) = "-" then (sign : -1, u : substring(u, 2)),
  point : ssearch(".", u),
  sign * parse_string(ssubst("", ".", u))
       * 10^(ex - (if point = false then 0 else slength(u) - point)))$

/* An entry: a literal, or the quotient `p / q` of two, which f64 rounds once, as an exact rational. */
rust_rational(t) := block([at : ssearch("/", t)],
  if at = false then rust_decimal(t)
  else rust_decimal(substring(t, 1, at)) / rust_decimal(substring(t, at + 1)))$

/* An entry as a bigfloat at the current fpprec. */
rust_number(t) := bfloat(rust_rational(t))$

rust_is_number(t) := block([u : strim(" ", t)], slength(u) > 0 and
  (digitcharp(charat(u, 1)) or (slength(u) > 1 and charat(u, 1) = "-" and digitcharp(charat(u, 2)))))$

rust_table(path, name) := block([s : openr(path), line, inside : false, done : false, out : [],
                                 head : concat("const ", name, ":"), at, body],
  while not done and (line : readline(s)) # false do (
    body : false,
    if inside then body : line
    else if ssearch(head, line) # false then (
      inside : true,
      at : ssearch("= [", line),
      body : if at = false then "" else substring(line, at + 3)),
    if body # false then (
      at : ssearch("//", body),
      if at # false then body : substring(body, 1, at),
      at : ssearch("];", body),
      if at # false then (done : true, body : substring(body, 1, at)),
      for c in ["[", "]", ";"] do body : ssubst(",", c, body),
      out : append(out, map(lambda([e], strim(" ", e)), sublist(split(body, ",", false), rust_is_number))))),
  close(s),
  if not done then error("rust_table: no complete table", name, "in", path),
  out)$

/* The value of a scalar `const NAME: f64 = <entry>;` on one line, as the text the source shows. */
rust_scalar(path, name) := block([s : openr(path), line, head : concat("const ", name, ": "), out : false,
                                  at],
  while out = false and (line : readline(s)) # false do
    if ssearch(head, line) # false then (
      at : ssearch("= ", line),
      out : strim(" ", substring(line, at + 2, ssearch(";", line)))),
  close(s),
  if out = false then error("rust_scalar: no const", name, "in", path),
  out)$

/* Every `const NAME: f64 = <entry>;` in the file, in order: a constant a module repeats inside
   several functions. */
rust_scalars(path, name) := block([s : openr(path), line, head : concat("const ", name, ": "), out : [],
                                   at],
  while (line : readline(s)) # false do
    if ssearch(head, line) # false then (
      at : ssearch("= ", line),
      out : endcons(strim(" ", substring(line, at + 2, ssearch(";", line))), out)),
  close(s),
  if out = [] then error("rust_scalars: no const", name, "in", path),
  out)$

/* The significant digits a literal shows: separators, sign, exponent and padding zeros dropped. */
rust_significant(t) := block([u : rust_digits(t), at],
  at : ssearch("e", ssubst("e", "E", u)),
  if at # false then u : substring(u, 1, at),
  slength(strimr("0", striml("0", ssubst("", "-", ssubst("", ".", u))))))$

/* `t` split at its commas outside brackets and string quotes. */
rust_split_top(t) := block([out : [], depth : 0, start : 1, c, quoted : false],
  for i : 1 thru slength(t) do (
    c : charat(t, i),
    if c = "\"" then quoted : not quoted
    else if not quoted then (
      if c = "(" or c = "[" then depth : depth + 1
      else if c = ")" or c = "]" then depth : depth - 1
      else if c = "," and depth = 0 then (out : endcons(substring(t, start, i), out), start : i + 1))),
  endcons(substring(t, start), out))$

/* The defaults of the `#[pyo3(signature = (...))]` right above `fn fname(`, as [name, value] pairs: a
   value is the literal's text, or the list of them for a `vec![...]` default. A default that is no
   literal (`None`, `true`, a name) comes back as its text. */
rust_signature_defaults(path, fname) := block([s : openr(path), line, acc : false, sig : false,
                                               found : false, head : concat("fn ", fname, "("), body,
                                               at, name, value, pairs : []],
  while found = false and (line : readline(s)) # false do (
    if acc # false then (
      acc : concat(acc, " ", line),
      if ssearch(")]", line) # false then (sig : acc, acc : false))
    else if ssearch("#[pyo3(signature", line) # false then (
      if ssearch(")]", line) # false then sig : line else acc : line)
    else if ssearch(head, line) # false then found : true
    else if ssearch("fn ", striml(" ", line)) = 1 or ssearch("pub fn ", striml(" ", line)) = 1 then
      sig : false),
  close(s),
  if found = false or sig = false then
    error("rust_signature_defaults: no signature above fn", fname, "in", path),
  body : substring(sig, ssearch("signature = (", sig) + 13, ssearch("))]", sig)),
  for piece in rust_split_top(body) do (
    at : ssearch("=", piece),
    if at # false then (
      name : strim(" ", substring(piece, 1, at)),
      value : strim(" ", substring(piece, at + 1)),
      if ssearch("[", value) # false then
        value : map(lambda([e], strim(" ", e)),
                    sublist(split(ssubst("", "]", ssubst("", "[", ssubst("", "vec!", value))), ",", false),
                            lambda([e], strim(" ", e) # ""))),
      pairs : endcons([name, value], pairs))),
  pairs)$

/* Every literal written as `name = <literal>` in the file, in order: a default argument of a C++
   wrapper. */
assigned_literals(path, name) := block([s : openr(path), line, head : concat(name, " = "), out : [],
                                        at, rest],
  while (line : readline(s)) # false do (
    rest : line,
    while (at : ssearch(head, rest)) # false do (
      rest : substring(rest, at + slength(head)),
      out : endcons(first(split(ssubst(" ", ")", ssubst(" ", ",", rest)), " ", false)), out))),
  close(s),
  if out = [] then error("assigned_literals: no", name, "in", path),
  out)$

/* The value of `#define NAME <literal>` in a C header, its parentheses dropped. */
c_define(path, name) := block([s : openr(path), line, head : concat("#define ", name, " "), out : false],
  while out = false and (line : readline(s)) # false do
    if ssearch(head, line) = 1 then
      out : strim(" ()", substring(line, slength(head) + 1)),
  close(s),
  if out = false then error("c_define: no", name, "in", path),
  out)$

/* The numeric literals of the lines after the first one containing `begin`, up to and excluding the
   first containing `finish`, in order, with their signs: for coefficients written inline in code. A
   minus followed by a space and a literal is read as that literal's sign, so `c - 0.5 * t` gives
   -0.5; `//` comments are skipped. */
rust_literals_between(path, begin, finish) := block([s : openr(path), line, inside : false, done : false,
                                              out : [], at],
  while not done and (line : readline(s)) # false do (
    if inside and ssearch(finish, line) # false then done : true
    else if inside then (
      at : ssearch("//", line),
      if at # false then line : substring(line, 1, at),
      line : ssubst("-", "- ", line),
      for c in ["(", ")", "[", "]", "*", "+", ",", ";", "="] do line : ssubst(" ", c, line),
      out : append(out, sublist(split(line, " ", false), rust_is_number)))
    else if ssearch(begin, line) # false then inside : true),
  close(s),
  if not done then error("rust_literals_between: no span", begin, "to", finish, "in", path),
  out)$

/* Every entry is exactly the rational its derivation gives: for tables written as quotients of
   integers, or as decimals that terminate. */
same_rationals(entries, exact) := length(entries) = length(exact) and
  every(lambda([t, x], is(ratsimp(rust_rational(t) - x) = 0)), entries, exact)$

/* The place of a literal's last shown digit, from its text: 10^(e - k + 1) for a leading digit at
   10^e and k digits shown from it. `none` for a literal that shows no nonzero digit. */
rust_last_place(t) := block([u : rust_digits(t), m, ex : 0, at, point, digits, first],
  at : ssearch("e", ssubst("e", "E", u)),
  if at = false then m : u else (m : substring(u, 1, at), ex : parse_string(substring(u, at + 1))),
  m : ssubst("", "-", m),
  point : ssearch(".", m),
  if point = false then point : slength(m) + 1,
  digits : ssubst("", ".", m),
  first : false,
  for i : 1 thru slength(digits) while first = false do
    if charat(digits, i) # "0" then first : i,
  if first = false then 'none
  else 10^((point - 1 - first + ex) - (slength(digits) - first + 1) + 1))$

/* The nearest double to x, at the current fpprec, as an exact rational: its 53-bit significand
   rounded, a tie being impossible for the irrationals and long decimals held here. */
nearest_double(x) := block([a : bfloat(abs(x)), sign : if bfloat(x) < 0 then -1 else 1, e],
  if is(equal(a, 0)) then 0
  else (e : floor(log(a) / log(2b0)),
        while 2^e > a do e : e - 1,
        while 2^(e + 1) <= a do e : e + 1,
        sign * round(a * 2^(52 - e)) * 2^(e - 52)))$

/* Every literal parses to the double its exact value rounds to. What a compiled `f64` table needs;
   weaker than `transcribed` where a table carries more digits than a double holds. */
same_doubles(literals, exact) := length(literals) = length(exact) and
  every(lambda([t, x], is(nearest_double(rust_number(t)) = nearest_double(x))), literals, exact)$

/* Every literal is its exact value rounded to the digits it shows; a literal of zeros is exact. */
transcribed(literals, exact) := length(literals) = length(exact) and
  every(lambda([t, x], block([place : rust_last_place(t), v : rust_number(t)],
          if place = 'none then is(bfloat(abs(x)) < 10^(-fpprec + 5))
          else is(bfloat(abs(v - x)) <= bfloat(place / 2)))),
        literals, exact)$

/* `transcribed` against a bigfloat, which bounds nothing, and the same claim handed to Arb
   (plans/17 Ф28.A): `exact` holds the values unevaluated -- rationals, %pi, %e, sums, products,
   powers and the elementary functions Arb has -- and for each literal one line
   `ARB name index literal <the value in reverse Polish notation>` goes to the output, where
   `arb_balls.c` decides in ball arithmetic that the literal is the value correctly rounded. A float
   inside a value, or a function Arb has not, is an error rather than a silent bigfloat. */
arb_unary : ["sin", "cos", "tan", "asin", "acos", "atan", "exp", "log", "abs", "sinh", "cosh", "tanh"]$
arb_emit(e) := block([inflag : true, o, a],
  if ratnump(e) then arb_out : cons(string(e), arb_out)
  else if e = %pi then arb_out : cons("pi", arb_out)
  else if e = %e then arb_out : cons("e", arb_out)
  else if floatnump(e) or bfloatp(e) then error("certified: a float, which bounds nothing:", e)
  else if atom(e) then error("certified: a free symbol:", e)
  else (o : op(e), a : args(e),
    if o = "+" or o = "*" then (
      for x in a do arb_emit(x),
      arb_out : cons(concat(if o = "+" then "add" else "mul", length(a)), arb_out))
    else if o = "^" and a[1] = %e then (arb_emit(a[2]), arb_out : cons("exp", arb_out))
    else if o = "^" and integerp(a[2]) then (
      arb_emit(a[1]), arb_out : cons(concat("pow", a[2]), arb_out))
    else if o = "^" and ratnump(a[2]) then (
      arb_emit(a[1]),
      /* ratnumer, not num: a derivation may define its own num() */
      arb_out : cons(concat("root", ratdisrep(ratdenom(a[2]))), arb_out),
      if ratdisrep(ratnumer(a[2])) # 1 then
        arb_out : cons(concat("pow", ratdisrep(ratnumer(a[2]))), arb_out))
    else if o = "^" then (arb_emit(a[1]), arb_emit(a[2]), arb_out : cons("powx", arb_out))
    else if o = 'atan2 then (arb_emit(a[1]), arb_emit(a[2]), arb_out : cons("atan2", arb_out))
    else if length(a) = 1 and member(string(o), arb_unary) then (
      arb_emit(a[1]), arb_out : cons(string(o), arb_out))
    else error("certified: no Arb counterpart for", o)))$
arb_rpn(e) := block([arb_out : []], arb_emit(e), reverse(arb_out))$
certified(name, literals, exact) := transcribed(literals, map(bfloat, exact)) and
  (for i thru length(literals) do
     printf(true, "ARB ~a ~a ~a ~{~a~^ ~}~%", name, i - 1, rust_digits(literals[i]), arb_rpn(exact[i])),
   true)$
