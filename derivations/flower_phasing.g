# Orbit counts for the single-track Flower Constellation. Scaled by Ns, satellite k is the point
# [-k*Nd, k*Np] mod Ns of the (node, mean anomaly) torus: the orbit of the cyclic group generated by
# the time shift T_rep/Ns. For every 1 <= Np, Nd, Ns <= 10 this checks the counts flower.rs pins:
#   distinct satellites = Ns / gcd(Np, Nd, Ns)   (coincident ones are emitted when that gcd > 1),
#   distinct nodes      = Ns / gcd(Nd, Ns).
# Each line prints the number of counterexamples.
# Run: timeout 120 gap -q -A --quitonbreak derivations/flower_phasing.g
run := function()
  local bad, Np, Nd, Ns, pts;
  bad := rec(sats := 0, nodes := 0);
  for Np in [1..10] do for Nd in [1..10] do for Ns in [1..10] do
    pts := List([0..Ns-1], k -> [(-k*Nd) mod Ns, (k*Np) mod Ns]);
    if Size(Set(pts)) <> Ns / Gcd(Gcd(Np, Nd), Ns) then bad.sats := bad.sats + 1; fi;
    if Size(Set(pts, p -> p[1])) <> Ns / Gcd(Nd, Ns) then bad.nodes := bad.nodes + 1; fi;
  od; od; od;
  Print("flower_distinct_satellites_is_ns_over_gcd: ", bad.sats, "\n");
  Print("flower_distinct_nodes_is_ns_over_gcd_nd_ns: ", bad.nodes, "\n");
end;
run();
QUIT;
