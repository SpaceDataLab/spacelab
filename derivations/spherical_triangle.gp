{off = 0; worst = 0.;
for (i = 1, #maxima,
  my(f = maxima[i][1], v = vector(9, k, dbl(f[2*k - 1], f[2*k])), a, b, c, e);
  a = unitv(v[1..3]); b = unitv(v[4..6]); c = unitv(v[7..9]);
  e = lhuilier(a, b, c);
  worst = max(worst, abs(e - maxima[i][2]) / abs(e));
  off += abs(e - maxima[i][2]) > 10^-50 * abs(e));}
printf("%d of %d excesses off by more than 1e-50 relative; worst relative gap %.3e\n", off, #maxima, worst);
