/* Which branch of SGP4/SDP4 each published element set takes, by the document's own criteria
   (plans/17 Ф17.I).

   SGP4 is a document-defined model (D-18 a): Spacetrack Report #3 (Hoots & Roehrich 1980) as revised
   by Vallado et al. (2006), AIAA 2006-6753. The branch is decided there, not by any implementation:

     n0'' = n0 / (1 + d0), the Brouwer mean motion, from the Kozai n0 a TLE prints (`initl`):
       a1 = (xke / n0)^(2/3),  d1 = (3/4) J2 (3 cos^2 i - 1) / (1 - e^2)^(3/2),  d = d1 / a1^2,
       a0 = a1 (1 - d^2 - d (1/3 + 134 d^2 / 81)),  d0 = d1 / a0^2;
     deep space when the period 2 pi / n0'' is at least 225 min (`sgp4init`);
     24-hour resonance when 0.0034906585 < n0'' < 0.0052359877 rad/min, 12-hour resonance when
     8.26e-3 <= n0'' <= 9.24e-3 and e >= 0.5 (`dsinit`; SDP4's DEEP in Spacetrack 3),
   with the WGS-72 constants of the reference convention: mu = 398600.8 km^3/s^2, R = 6378.135 km,
   xke = 60 / sqrt(R^3 / mu), J2 = 0.001082616.

   Every element set of the published verification file is classified here at 40 digits, with its
   distance to the nearest edge, and `tests/regime.rs` writes the result as `DOCUMENT_REGIME`,
   which is read back below; the Rust test holds `Satellite::regime` to that table. Codes:
   0 near-Earth, 1 deep space without resonance, 2 24-hour, 3 12-hour; -1 marks a set `Satellite`
   refuses, which the Rust test checks and this file passes over.

   timeout 120 maxima --very-quiet -Q -b sgp4_regime.mac                                              */

display2d : false$
load("rust_literals.mac")$
must(ok, what) := if ok then print(what) else error("FAILED:", what)$
fpprec : 40$

fixture : "../crates/spacelab-sgp4/tests/fixtures/sgp4_ver_tle.txt"$
regime_test : "../crates/spacelab-sgp4/tests/regime.rs"$

mu : 3986008 / 10$
re : 6378135 / 1000$
xke : 60 / sqrt(re^3 / mu)$
j2 : 1082616 / 10^9$
deep_n : 2 * %pi / 225$
sync_lo : 34906585 / 10^10$
sync_hi : 52359877 / 10^10$
half_lo : 826 / 10^5$
half_hi : 924 / 10^5$
half_e : 1 / 2$

/* Line 2's fixed columns: catalogue 3-7, inclination 9-16 (deg), eccentricity 27-33 (implied
   leading decimal point), mean motion 53-63 (rev/day). */
field(line, a, b) := strim(" ", substring(line, a, b + 1))$
read_sets(path) := block([s : openr(path), line, out : [], parts],
  while (line : readline(s)) # false do
    if slength(strim(" ", line)) > 0 and charat(line, 1) # "#" then (
      parts : split(line, "|"),
      out : cons(parts[2], out)),
  close(s),
  reverse(out))$

brouwer(n0, e, incl) := block([c, a1, d1, d, a0],
  c : cos(incl),
  a1 : (xke / n0)^(2/3),
  d1 : 3/4 * j2 * (3 * c^2 - 1) / (1 - e^2)^(3/2),
  d : d1 / a1^2,
  a0 : a1 * (1 - d^2 - d * (1/3 + 134 * d^2 / 81)),
  bfloat(n0 / (1 + d1 / a0^2)))$

classify(n, e) :=
  if bfloat(n - deep_n) > 0 then 0
  else if bfloat(n - half_lo) >= 0 and bfloat(n - half_hi) <= 0 and e >= half_e then 3
  else if bfloat(n - sync_lo) > 0 and bfloat(n - sync_hi) < 0 then 2
  else 1$

/* The relative distance from n0'' (and e) to the nearest edge the classification can cross. */
margin(n, e) := lmin(append(
  map(lambda([edge], abs(bfloat(n / edge - 1))), [deep_n, sync_lo, sync_hi, half_lo, half_hi]),
  [abs(bfloat(e / half_e - 1))]))$

sets : read_sets(fixture)$
rows : makelist(block([l : sets[k], n0, e, incl, n],
    n0 : rust_decimal(field(l, 53, 63)) * 2 * %pi / 1440,
    e : parse_string(field(l, 27, 33)) / 10^7,
    incl : rust_decimal(field(l, 9, 16)) * %pi / 180,
    n : brouwer(n0, e, incl),
    [k, field(l, 3, 7), classify(n, e), n, margin(n, e)]), k, 1, length(sets))$
for r in rows do print(r[1], r[2], "regime", r[3], " n0'' =", r[4], " margin", r[5])$

table : map(rust_rational, rust_table(regime_test, "DOCUMENT_REGIME"))$
print(length(rows), "sets;", length(sublist(table, lambda([c], c # -1))), "built by Satellite")$
must(length(table) = length(rows)
     and every(lambda([r], table[r[1]] = -1 or table[r[1]] = r[3]), rows),
     "(1) holds: DOCUMENT_REGIME is the document's classification of every set Satellite builds")$
built : sublist(rows, lambda([r], table[r[1]] # -1))$
worst : lmin(map(lambda([r], r[5]), built))$
print("    nearest edge, relative:", worst)$
must(worst > 1b-6,
     "(2) holds: no built set lies within 1e-6 of an edge, so a double evaluation of n0'' cannot change its branch")$
print("DONE")$
