/* Exact geometric predicates -- spacelab-geometry/src/predicates.rs -- as identities, as a proof
 * that the floating-point filter cannot certify a wrong sign, and as exact signs on adversarial
 * near-degenerate inputs.
 *
 * Shown here, each line printing `<name>: 0`:
 *   1. the exact-path expansions (sums of `cross`, `minor3`, `minor3d` in the original coordinates)
 *      are the defining determinants -- the 3x3 determinant with a column of ones for orient2d, the
 *      4x4 lifted determinant for in_circle and the 4x4 determinant with a column of ones for
 *      orient3d -- and so is the translated form the filter evaluates (G1);
 *   2. the signs mean what the doc says: orient2d is the counter-clockwise turn; for a
 *      counter-clockwise triangle in_circle = orient2d(a,b,c) (R^2 - |d - o|^2) with o the
 *      circumcentre, so +1 is strictly inside; orient3d = -(d - a).((b - a) x (c - a)), so +1 is
 *      behind the face normal (G1);
 *   3. the filter's bound. With u = 2^-53 and no underflow, every monomial m_i of the determinant
 *      (in exact coordinate differences) reaches the computed value through at most k roundings,
 *      each a factor (1 + delta), |delta| <= u: k = 4 (orient2d), 11 (in_circle), 8 (orient3d).
 *      So |D_computed - D| <= ((1+u)^k - 1) P with P = sum |m_i|, the permanent; the computed
 *      permanent is formed from non-negative terms through the same k roundings, so
 *      P_computed >= (1-u)^k P; and FILTER = 64 f64::EPSILON = 2^-46 is a power of two, so
 *      FILTER * P_computed is exact. |D_computed| > FILTER P_computed therefore certifies the
 *      sign whenever (1+u)^k - 1 <= 2^-46 (1-u)^k, checked here in exact rationals. Shewchuk's
 *      sharper first-stage constants (3 + 16u)u, (10 + 96u)u, (7 + 56u)u sit below the filter too;
 *   4. exact signs of 36 adversarial near-degenerate configurations whose coordinates are doubles
 *      (each printed as an integer mantissa and a binary exponent): points rounded onto a line, a
 *      circle or a plane, so the determinant is a rounding error of terms up to 2^60 times larger.
 *      The rows are the table `the_signs_on_adversarial_inputs_are_the_exact_rational_signs`
 *      asserts; derivations/exact_predicates.gp rebuilds the inputs and the signs independently.
 *
 * Run: timeout 300 maxima --very-quiet -Q -b derivations/exact_predicates.mac </dev/null
 */

zero(name, expr) := block([d : expr],
  printf(true, "~a: ~a~%", name, d),
  if d # 0 then error("identity does not reduce to zero:", name))$

/* A check that holds prints 0, one that does not stops the run. */
holds(name, claim) := zero(name, if is(claim) then 0 else 1)$

/* ---- 1. the exact paths are the determinants -------------------------------------------- */

cross2(a, b, c, d) := a*d - b*c$
orient2d_def : determinant(matrix([ax, ay, 1], [bx, by, 1], [cx, cy, 1]))$
orient2d_filter : (ax - cx)*(by - cy) - (ay - cy)*(bx - cx)$
orient2d_exact : cross2(ax, ay, bx, by) + cross2(bx, by, cx, cy) + cross2(cx, cy, ax, ay)$
zero("orient2d_filter_is_the_determinant", expand(orient2d_filter - orient2d_def))$
zero("orient2d_exact_path_is_the_determinant", expand(orient2d_exact - orient2d_def))$

lift(x, y) := x^2 + y^2$
minor3(p, q, r) := block([ql : lift(q[1], q[2]), rl : lift(r[1], r[2])],
  p[1]*(rl*q[2] - ql*r[2]) - p[2]*(rl*q[1] - ql*r[1]) + lift(p[1], p[2])*cross2(q[1], q[2], r[1], r[2]))$
A : [ax, ay]$ B : [bx, by]$ C : [cx, cy]$ Dp : [dx, dy]$
in_circle_def : determinant(matrix([ax, ay, lift(ax, ay), 1], [bx, by, lift(bx, by), 1],
                                   [cx, cy, lift(cx, cy), 1], [dx, dy, lift(dx, dy), 1]))$
in_circle_exact : -minor3(B, C, Dp) + minor3(A, C, Dp) - minor3(A, B, Dp) + minor3(A, B, C)$
block([adx : ax - dx, ady : ay - dy, bdx : bx - dx, bdy : by - dy, cdx : cx - dx, cdy : cy - dy],
  in_circle_filter : lift(adx, ady)*(bdx*cdy - cdx*bdy) + lift(bdx, bdy)*(cdx*ady - adx*cdy)
                     + lift(cdx, cdy)*(adx*bdy - bdx*ady))$
zero("in_circle_minor3_is_the_3x3_lifted_determinant",
  expand(minor3([px, py], [qx, qy], [rx, ry])
         - determinant(matrix([px, py, lift(px, py)], [qx, qy, lift(qx, qy)], [rx, ry, lift(rx, ry)]))))$
zero("in_circle_exact_path_is_the_determinant", expand(in_circle_exact - in_circle_def))$
zero("in_circle_filter_is_the_determinant", expand(in_circle_filter - in_circle_def))$

minor3d(p, q, r) := p[1]*cross2(q[2], q[3], r[2], r[3]) - p[2]*cross2(q[1], q[3], r[1], r[3])
                    + p[3]*cross2(q[1], q[2], r[1], r[2])$
A3 : [ax, ay, az]$ B3 : [bx, by, bz]$ C3 : [cx, cy, cz]$ D3 : [dx, dy, dz]$
orient3d_def : determinant(matrix([ax, ay, az, 1], [bx, by, bz, 1], [cx, cy, cz, 1], [dx, dy, dz, 1]))$
orient3d_exact : -minor3d(B3, C3, D3) + minor3d(A3, C3, D3) - minor3d(A3, B3, D3) + minor3d(A3, B3, C3)$
block([adx : ax - dx, ady : ay - dy, adz : az - dz, bdx : bx - dx, bdy : by - dy, bdz : bz - dz,
       cdx : cx - dx, cdy : cy - dy, cdz : cz - dz],
  orient3d_filter : adx*(bdy*cdz - bdz*cdy) + ady*(bdz*cdx - bdx*cdz) + adz*(bdx*cdy - bdy*cdx))$
zero("orient3d_minor3d_is_the_3x3_determinant",
  expand(minor3d([px, py, pz], [qx, qy, qz], [rx, ry, rz])
         - determinant(matrix([px, py, pz], [qx, qy, qz], [rx, ry, rz]))))$
zero("orient3d_exact_path_is_the_determinant", expand(orient3d_exact - orient3d_def))$
zero("orient3d_filter_is_the_determinant", expand(orient3d_filter - orient3d_def))$

/* ---- 2. what the signs mean ------------------------------------------------------------- */

o2(a, b, c) := (a[1] - c[1])*(b[2] - c[2]) - (a[2] - c[2])*(b[1] - c[1])$
zero("orient2d_counter_clockwise_is_plus_one", o2([0, 0], [1, 0], [0, 1]) - 1)$
/* The circumcentre o of a, b, c: |o - a|^2 = |o - b|^2 = |o - c|^2. */
osol : solve([(ox - ax)^2 + (oy - ay)^2 = (ox - bx)^2 + (oy - by)^2,
              (ox - ax)^2 + (oy - ay)^2 = (ox - cx)^2 + (oy - cy)^2], [ox, oy])[1]$
radius2 : subst(osol, (ax - ox)^2 + (ay - oy)^2)$
dist2 : subst(osol, (dx - ox)^2 + (dy - oy)^2)$
zero("in_circle_is_orientation_times_power_of_the_point",
  ratsimp(in_circle_filter - orient2d_def*(radius2 - dist2)))$
holds("in_circle_centre_of_ccw_triangle_is_inside",
  subst([ax = 0, ay = 0, bx = 1, by = 0, cx = 0, cy = 1, dx = 1/4, dy = 1/4], in_circle_def) > 0)$
cross3(u, v) := [u[2]*v[3] - u[3]*v[2], u[3]*v[1] - u[1]*v[3], u[1]*v[2] - u[2]*v[1]]$
zero("orient3d_is_minus_the_offset_along_the_face_normal",
  expand(orient3d_filter + (D3 - A3) . cross3(B3 - A3, C3 - A3)))$

/* ---- 3. the filter's bound ---------------------------------------------------------------- */

u : 2^-53$
filter : 64 * 2^-52$
holds("filter_is_two_to_the_minus_46", is(equal(filter, 2^-46)))$
for k in [[orient2d, 4], [in_circle, 11], [orient3d, 8]] do
  holds(sconcat(k[1], "_filter_bound_covers_", k[2], "_roundings"),
        (1 + u)^k[2] - 1 <= filter * (1 - u)^k[2])$
/* How far inside the bound each predicate is: filter / needed, as a decimal. */
for k in [[orient2d, 4], [in_circle, 11], [orient3d, 8]] do
  printf(true, "~a filter margin: ~a~%", k[1],
         float(filter * (1 - u)^k[2] / ((1 + u)^k[2] - 1)))$
holds("shewchuk_bounds_are_below_the_filter",
  (3 + 16*u)*u < filter and (10 + 96*u)*u < filter and (7 + 56*u)*u < filter)$

/* ---- 4. adversarial near-degenerate inputs ------------------------------------------------ */

/* x rounded to the nearest double (round half to even), for x within the normal range. */
ilog2(x) := block([e : 0, y : abs(x)],
  while y >= 2 do (y : y/2, e : e + 1),
  while y < 1 do (y : y*2, e : e - 1),
  e)$
rnd53(x) := if x = 0 then 0 else block([e : ilog2(x), m, f],
  m : x * 2^(52 - e),
  f : floor(m),
  if m - f > 1/2 or (m - f = 1/2 and oddp(f)) then f : f + 1,
  f * 2^(e - 52))$
/* A double as [mantissa, exponent] with an odd mantissa, value = mantissa * 2^exponent. */
dsplit(x) := if x = 0 then [0, 0] else block([m : x, e : 0],
  while not integerp(m) do (m : m*2, e : e - 1),
  while evenp(m) do (m : m/2, e : e + 1),
  if abs(m) >= 2^53 then error("not a double:", x),
  [m, e])$
isdouble(x) := is(rnd53(x) = x)$

sgn(x) := if x > 0 then 1 else if x < 0 then -1 else 0$
o2s(a, b, c) := sgn(o2(a, b, c))$
ics(a, b, c, d) := block([adx : a[1] - d[1], ady : a[2] - d[2], bdx : b[1] - d[1], bdy : b[2] - d[2],
                          cdx : c[1] - d[1], cdy : c[2] - d[2]],
  sgn(lift(adx, ady)*(bdx*cdy - cdx*bdy) + lift(bdx, bdy)*(cdx*ady - adx*cdy)
      + lift(cdx, cdy)*(adx*bdy - bdx*ady)))$
o3s(a, b, c, d) := sgn((a - d) . cross3(b - d, c - d))$

/* A deterministic, exactly reproducible stream of rationals in [-1, 1): a 61-bit LCG. */
lcg : 1234567$
rnext() := (lcg : mod(lcg * 6364136223846793005 + 1442695040888963407, 2^61), 2*lcg/2^61 - 1)$

/* |det| / permanent in exact arithmetic: below 2^-46 the f64 filter cannot certify the sign. */
o2r(a, b, c) := block([l : (a[1] - c[1])*(b[2] - c[2]), r : (a[2] - c[2])*(b[1] - c[1])],
  abs(l - r)/(abs(l) + abs(r)))$
icr(a, b, c, d) := block([adx : a[1] - d[1], ady : a[2] - d[2], bdx : b[1] - d[1], bdy : b[2] - d[2],
                          cdx : c[1] - d[1], cdy : c[2] - d[2]],
  abs(lift(adx, ady)*(bdx*cdy - cdx*bdy) + lift(bdx, bdy)*(cdx*ady - adx*cdy)
      + lift(cdx, cdy)*(adx*bdy - bdx*ady))
  / ((abs(bdx*cdy) + abs(cdx*bdy))*lift(adx, ady) + (abs(cdx*ady) + abs(adx*cdy))*lift(bdx, bdy)
     + (abs(adx*bdy) + abs(bdx*ady))*lift(cdx, cdy)))$
o3r(a, b, c, d) := block([ad : a - d, bd : b - d, cd : c - d],
  abs(ad . cross3(bd, cd))
  / ((abs(bd[2]*cd[3]) + abs(bd[3]*cd[2]))*abs(ad[1]) + (abs(bd[3]*cd[1]) + abs(bd[1]*cd[3]))*abs(ad[2])
     + (abs(bd[1]*cd[2]) + abs(bd[2]*cd[1]))*abs(ad[3])))$
ratio(kind, pts) := apply([o2r, icr, o3r][kind], pts)$

rows : []$
emit(kind, pts, s) := block([flat : []],
  for p in pts do for x in p do (
    if not isdouble(x) then error("coordinate is not a double:", x),
    flat : append(flat, dsplit(x))),
  rows : endcons([kind, flat, s, ratio(kind, pts)], rows))$

/* orient2d: a and b doubles, c the double nearest a point on the line through them, at three
   scales; and the Kettner et al. grid point against (12, 12), (24, 24). */
for s in [2^-40, 1, 2^40] do for k : 1 thru 4 do block([a, b, t, c],
  a : [rnd53(s*rnext()), rnd53(s*rnext())],
  b : [rnd53(s*rnext()), rnd53(s*rnext())],
  t : 7*rnext(),
  c : [rnd53(a[1] + t*(b[1] - a[1])), rnd53(a[2] + t*(b[2] - a[2]))],
  emit(1, [a, b, c], o2s(a, b, c)))$
for ij in [[3, 5], [5, 3], [7, 7]] do block([p : [1/2 + ij[1]*2^-53, 1/2 + ij[2]*2^-53]],
  emit(1, [p, [12, 12], [24, 24]], o2s(p, [12, 12], [24, 24])))$

fpprec : 40$
/* in_circle: three doubles on a circle of radius r about a double centre, a fourth rounded onto
   it, the first three put counter-clockwise. */
for s in [2^-30, 1, 2^30] do for k : 1 thru 4 do block([cx0, cy0, r, ang, pts, a, b, c, d],
  cx0 : rnd53(s*rnext()), cy0 : rnd53(s*rnext()), r : s*(1 + rnext())/2,
  ang : sort(makelist(bfloat(%pi*(rnext() + 1)), i, 1, 4)),
  pts : makelist([rnd53(cx0 + r*rationalize(cos(ang[i]))), rnd53(cy0 + r*rationalize(sin(ang[i])))],
                 i, 1, 4),
  [a, b, c, d] : pts,
  if o2s(a, b, c) < 0 then [b, c] : [c, b],
  emit(2, [a, b, c, d], ics(a, b, c, d)))$

/* orient3d: three doubles and a fourth rounded into their plane, at three scales. */
for s in [2^-20, 1, 2^20] do for k : 1 thru 3 do block([a, b, c, t1, t2, d],
  a : makelist(rnd53(s*rnext()), i, 1, 3),
  b : makelist(rnd53(s*rnext()), i, 1, 3),
  c : makelist(rnd53(s*rnext()), i, 1, 3),
  t1 : 3*rnext(), t2 : 3*rnext(),
  d : makelist(rnd53(a[i] + t1*(b[i] - a[i]) + t2*(c[i] - a[i])), i, 1, 3),
  emit(3, [a, b, c, d], o3s(a, b, c, d)))$

printf(true, "~a adversarial rows~%", length(rows))$
/* Every row sits where the f64 filter cannot decide, so the exact path is what the test reaches. */
holds("every_adversarial_row_is_below_the_filter", every(lambda([r], r[4] <= filter), rows))$
printf(true, "largest |det|/permanent over the rows: ~a~%", float(lmax(map(lambda([r], r[4]), rows))))$
for r in rows do printf(true, "row ~a ~a ~a~%", r[1], r[3], r[2])$
