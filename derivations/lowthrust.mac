/* Continuous low thrust -- spacelab-astro/src/lowthrust.rs -- as identities.
 *
 * The coded equations of motion r' = v, v' = -mu r/|r|^3 + aT u, with u the unit steering
 * direction: v/|v| (tangential), -v/|v| (retrograde) or d/|d| (inertial).
 *
 * Shown here, each line printing `<name>: 0`:
 *   1. the specific energy E = |v|^2/2 - mu/|r| changes at exactly aT v.u along the coded
 *      field, so tangential steering gives +aT|v| and retrograde -aT|v| (G1);
 *   2. tangential steering is the energy-optimal one: among unit u, v.u is stationary only along
 *      +-v (Lagrange), and |v|^2 - (v.u)^2 = |v x u|^2 >= 0 (Lagrange's identity) (G2);
 *   3. angular momentum h = r x v changes at aT r x u, so coasting (aT = 0) conserves both h and
 *      E (G4);
 *   4. with E = -mu/(2a), tangential thrust gives Gauss's da/dt = 2 a^2 |v| aT/mu, and on a
 *      circular orbit, |v| = sqrt(mu/a), the circular speed falls at exactly aT: Edelbaum's
 *      quasi-circular coplanar limit, Delta-v = v0 - v1 (G3, limit).
 * The test's acceleration references are evaluated at 100 digits in derivations/lowthrust.gp.
 *
 * Run: timeout 300 maxima --very-quiet --suppress-input-echo -Q -b derivations/lowthrust.mac </dev/null
 */

zero(name, expr) := block([d : expr],
  printf(true, "~a: ~a~%", name, d),
  if d # 0 then error("identity does not reduce to zero:", name))$
vsum(l) := apply("+", map(abs, l))$
cross(a, b) := [a[2]*b[3] - a[3]*b[2], a[3]*b[1] - a[1]*b[3], a[1]*b[2] - a[2]*b[1]]$

assume(mu > 0, aT >= 0, a > 0)$
R : [x, y, z]$  Vv : [vx, vy, vz]$  U : [ux, uy, uz]$
rn : sqrt(R . R)$  vn : sqrt(Vv . Vv)$
acc(u) := -mu*R/rn^3 + aT*u$
E : (Vv . Vv)/2 - mu/rn$
rate(f, u) := sum(diff(f, R[i])*Vv[i] + diff(f, Vv[i])*acc(u)[i], i, 1, 3)$

/* 1. */
zero("energy_rate_is_thrust_power", ratsimp(rate(E, U) - aT*(Vv . U)))$
zero("tangential_energy_rate", ratsimp(rate(E, Vv/vn) - aT*vn))$
zero("retrograde_energy_rate", ratsimp(rate(E, -Vv/vn) + aT*vn))$
zero("inertial_energy_rate", ratsimp(rate(E, [dx, dy, dz]/sqrt(dx^2 + dy^2 + dz^2))
                                     - aT*(Vv . [dx, dy, dz])/sqrt(dx^2 + dy^2 + dz^2)))$

/* 2. Stationary points of v.u on |u| = 1: grad(v.u - l (u.u - 1)) = 0. */
st : solve(append(makelist(diff(Vv . U - l*(U . U - 1), U[i]), i, 1, 3), [U . U = 1]),
           [ux, uy, uz, l])$
/* exactly two, u = +-v/|v|; an empty list would make the next line vacuous */
zero("stationary_points_are_two", length(st) - 2)$
zero("stationary_steering_is_along_v",
     vsum(flatten(map(lambda([s], ratsimp(cross(subst(s, U), Vv))), st))))$
zero("lagrange_identity", ratsimp((Vv . Vv)*(U . U) - (Vv . U)^2 - cross(Vv, U) . cross(Vv, U)))$

/* 3. */
H : cross(R, Vv)$
zero("angular_momentum_rate_is_thrust_torque",
     vsum(map(lambda([q], ratsimp(q)),
              makelist(rate(H[i], U), i, 1, 3) - aT*cross(R, U))))$
zero("coasting_conserves_angular_momentum",
     vsum(map(ratsimp, subst(aT = 0, makelist(rate(H[i], U), i, 1, 3)))))$
zero("coasting_conserves_energy", ratsimp(subst(aT = 0, rate(E, U))))$

/* 4. a(E) = -mu/(2E); da/dt = (da/dE) dE/dt with dE/dt = aT|v|. */
dadt : ratsimp(diff(-mu/(2*Es), Es)*aT*vs)$
zero("gauss_tangential_semi_major_axis_rate", ratsimp(subst(Es = -mu/(2*a), dadt) - 2*a^2*vs*aT/mu))$
vc : sqrt(mu/a)$
zero("circular_speed_falls_at_the_thrust_acceleration",
     ratsimp(diff(vc, a)*subst(vs = vc, 2*a^2*vs*aT/mu) + aT))$
