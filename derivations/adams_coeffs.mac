/* Adams-Bashforth (explicit) and Adams-Moulton (implicit) order-8 ordinate coefficients, derived
   from first principles as the integral of the Lagrange basis over one step -- NOT transcribed. AB
   interpolates f at s=0,-1,...,-7 (f_n..f_{n-7}); AM includes s=1 (f_{n+1}). Both must sum to 1
   (consistency), and each coefficient is a specific rational matching `spacelab-propagation::abm`. */
k: 8$
Lab(i) := block([p:1], for m:0 thru k-1 do (if m#i then p: p*(s+m)/(m-i)), p)$
ab: makelist(integrate(Lab(i), s, 0, 1), i, 0, k-1)$
Lam(i) := block([p:1], for m:0 thru k-1 do (if m#i then p: p*(s-(1-m))/((1-i)-(1-m))), p)$
am: makelist(integrate(Lam(i), s, 0, 1), i, 0, k-1)$
print("AB8 sum (=1?): ", apply("+", ab))$
print("AM8 sum (=1?): ", apply("+", am))$
print("AB8 leading (=16083/4480?): ", ab[1] - 16083/4480)$
print("AM8 leading (=5257/17280?): ", am[1] - 5257/17280)$

/* The Rust tables (plans/17 Ф17.D). abm.rs holds each rational to 33 digits; each literal must be
   that rational rounded to the digits it shows, and so parse to the double the rational rounds to. */
load("rust_literals.mac")$
fpprec : 60$
src : "../crates/spacelab-propagation/src/abm.rs"$
print("rust AB8 is ab rounded to its digits:", certified("AB8", rust_table(src, "AB8"), ab))$
print("rust AM8 is am rounded to its digits:", certified("AM8", rust_table(src, "AM8"), am))$
print("rust AB8 is the nearest doubles to ab:", same_doubles(rust_table(src, "AB8"), ab))$
print("rust AM8 is the nearest doubles to am:", same_doubles(rust_table(src, "AM8"), am))$
