/* Second engine for derivations/exact_predicates.mac: the adversarial inputs of
   crates/spacelab-geometry/src/predicates.rs rebuilt from the same 61-bit LCG with PARI's own
   exact rationals and rounding to the nearest double, their determinants signed in exact
   arithmetic, and both compared with the table Maxima printed (pasted below as `maxima`).
   It also re-checks the filter inequality (1+u)^k - 1 <= 2^-46 (1-u)^k, k = 4, 11, 8.

       timeout 300 gp -q -f derivations/exact_predicates.gp </dev/null                           */

default(realprecision, 60);

ilog2(x) = {
  my(y = abs(x), e = logint(numerator(y), 2) - logint(denominator(y), 2));
  while (y < 2^e, e--);
  while (y >= 2^(e + 1), e++);
  e;
}
/* The nearest double to x, half to even. A real x is first made an exact rational: at 60 digits
   it carries 199 bits, so the rounding below is decided by bits the real does hold. */
rnd53(x) = {
  if (x == 0, return(0));
  if (type(x) == "t_REAL", x = bestappr(x, 2^180));
  my(e = ilog2(x), m = x * 2^(52 - e), f = floor(m));
  if (m - f > 1/2 || (m - f == 1/2 && f % 2 == 1), f++);
  f * 2^(e - 52);
}
dsplit(x) = {
  my(m = x, e = 0);
  if (x == 0, return([0, 0]));
  while (denominator(m) != 1, m *= 2; e--);
  while (m % 2 == 0, m /= 2; e++);
  [m, e];
}

lcg = 1234567;
rnext() = { lcg = (lcg * 6364136223846793005 + 1442695040888963407) % 2^61; 2 * lcg / 2^61 - 1; }

lift2(x, y) = x^2 + y^2;
o2(a, b, c) = (a[1] - c[1]) * (b[2] - c[2]) - (a[2] - c[2]) * (b[1] - c[1]);
{ic(a, b, c, d) = matdet([a[1] - d[1], a[2] - d[2], lift2(a[1] - d[1], a[2] - d[2]);
                         b[1] - d[1], b[2] - d[2], lift2(b[1] - d[1], b[2] - d[2]);
                         c[1] - d[1], c[2] - d[2], lift2(c[1] - d[1], c[2] - d[2])]);}
o3(a, b, c, d) = my(p = a - d, q = b - d, r = c - d); matdet([p[1], p[2], p[3]; q[1], q[2], q[3]; r[1], r[2], r[3]]);

rows = List();
emit(kind, pts, s) = {
  my(flat = []);
  for (i = 1, #pts, for (j = 1, #pts[i], flat = concat(flat, dsplit(pts[i][j]))));
  listput(rows, [kind, s, flat]);
}

{for (k = 1, 3, my(s = [2^-40, 1, 2^40][k]);
  for (n = 1, 4,
    my(a, b, t, c);
    a = [rnd53(s * rnext()), rnd53(s * rnext())];
    b = [rnd53(s * rnext()), rnd53(s * rnext())];
    t = 7 * rnext();
    c = [rnd53(a[1] + t * (b[1] - a[1])), rnd53(a[2] + t * (b[2] - a[2]))];
    emit(1, [a, b, c], sign(o2(a, b, c)))));}
{foreach ([[3, 5], [5, 3], [7, 7]], ij,
  my(p = [1/2 + ij[1] * 2^-53, 1/2 + ij[2] * 2^-53]);
  emit(1, [p, [12, 12], [24, 24]], sign(o2(p, [12, 12], [24, 24]))));}

{for (k = 1, 3, my(s = [2^-30, 1, 2^30][k]);
  for (n = 1, 4,
    my(cx0, cy0, r, ang, pts, a, b, c, d);
    cx0 = rnd53(s * rnext()); cy0 = rnd53(s * rnext()); r = s * (1 + rnext()) / 2;
    ang = vecsort(vector(4, i, Pi * (rnext() + 1)));
    pts = vector(4, i, [rnd53(cx0 + r * cos(ang[i])), rnd53(cy0 + r * sin(ang[i]))]);
    [a, b, c, d] = pts;
    if (o2(a, b, c) < 0, [b, c] = [c, b]);
    emit(2, [a, b, c, d], sign(ic(a, b, c, d)))));}

{for (k = 1, 3, my(s = [2^-20, 1, 2^20][k]);
  for (n = 1, 3,
    my(a, b, c, t1, t2, d);
    a = vector(3, i, rnd53(s * rnext()));
    b = vector(3, i, rnd53(s * rnext()));
    c = vector(3, i, rnd53(s * rnext()));
    t1 = 3 * rnext(); t2 = 3 * rnext();
    d = vector(3, i, rnd53(a[i] + t1 * (b[i] - a[i]) + t2 * (c[i] - a[i])));
    emit(3, [a, b, c, d], sign(o3(a, b, c, d)))));}

