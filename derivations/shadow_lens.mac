/* The conical shadow's lens formula, against the textbook one, for every radius and separation.

   `spacelab-propagation::shadow::masking_ratio` carries Orekit's arrangement of the overlap of two
   apparent disks, the Sun's (radius s) and the occulter's (radius e), centres d apart:

       a1 = (d^2 - (e^2 - s^2))/(2 d),   a2 = (d^2 + (e^2 - s^2))/(2 d),
       p1 = s^2 acos(a1/s) - a1 sqrt(s^2 - a1^2),   p2 = e^2 acos(a2/e) - a2 sqrt(e^2 - a2^2),
       visible = 1 - (p1 + p2)/(pi s^2).

   The test compares it with the circle-intersection area at five separations. Here the two are the
   same expression: a1 and a2 are the distances from each centre to the common chord, so both
   square roots are its half-length h, and d h is twice Heron's area of the triangle (d, s, e).
   Then the formula meets the plateaus continuously: exactly 0 where the Sun's disk is internally
   tangent, exactly 1 where the disks touch from outside. Last, the identity `angle` relies on near
   0 and pi.                                                                                      */

must(ok, what) := if ok then print(what) else error("FAILED:", what)$
assume(d > 0, s > 0, e > s)$

a1 : (d^2 - (e^2 - s^2))/(2*d)$
a2 : (d^2 + (e^2 - s^2))/(2*d)$

/* ---- (1) a1 + a2 = d, and the two half-chords are one ------------------------------------------ */
must(is(ratsimp(a1 + a2 - d) = 0), "(1) holds: a1 + a2 = d")$
must(is(ratsimp((s^2 - a1^2) - (e^2 - a2^2)) = 0),
     "(1) holds: s^2 - a1^2 = e^2 - a2^2, the same half-chord on both circles")$

/* ---- (2) the two acos arguments are the textbook's, and d h is twice Heron's area ------------- */
must(is(ratsimp(a1/s - (d^2 + s^2 - e^2)/(2*d*s)) = 0)
     and is(ratsimp(a2/e - (d^2 + e^2 - s^2)/(2*d*e)) = 0),
     "(2) holds: a1/s and a2/e are the law-of-cosines arguments of the circle-intersection area")$
heron : (-d + s + e)*(d + s - e)*(d - s + e)*(d + s + e)$
must(is(ratsimp(4*d^2*(s^2 - a1^2) - heron) = 0),
     "(2) holds: (2 d h)^2 is Heron's product, so a1 h + a2 h = (1/2) sqrt(product)")$

/* ---- (3) the penumbra meets the plateaus continuously ------------------------------------------ */
visible(dd) := block([b1, b2],
  b1 : ratsimp(subst(d = dd, a1)), b2 : ratsimp(subst(d = dd, a2)),
  ratsimp(1 - (s^2*acos(ratsimp(b1/s)) - b1*sqrt(ratsimp(s^2 - b1^2))
               + e^2*acos(ratsimp(b2/e)) - b2*sqrt(ratsimp(e^2 - b2^2)))/(%pi*s^2)))$
must(is(visible(e - s) = 0),
     "(3) holds: at d = e - s, the Sun internally tangent, the visible fraction is exactly 0")$
must(is(visible(e + s) = 1),
     "(3) holds: at d = e + s, the disks touching from outside, it is exactly 1")$

/* ---- (4) Lagrange's identity: |u x v|^2 + (u.v)^2 = |u|^2 |v|^2 ----------------------------------
   `angle` switches from acos(u.v/(|u||v|)) to asin(|u x v|/(|u||v|)) near 0 and pi; the two name
   the same angle because of this.                                                                */
u : [u1, u2, u3]$
v : [v1, v2, v3]$
cr : [u2*v3 - u3*v2, u3*v1 - u1*v3, u1*v2 - u2*v1]$
must(is(ratsimp(cr.cr + (u.v)^2 - (u.u)*(v.v)) = 0),
     "(4) holds: |u x v|^2 + (u.v)^2 = |u|^2 |v|^2")$

/* ---- (5) a numeric spot check, the test's own case, in 40-digit bigfloat ----------------------
   In f64 the two forms part by 7e-14 here: e^2/s^2 = 100 amplifies the rounding of both. */
fpprec : 40$
ref(dd, big, small) := bfloat(1 - (small^2*acos((dd^2 + small^2 - big^2)/(2*dd*small))
                                 + big^2*acos((dd^2 + big^2 - small^2)/(2*dd*big))
                                 - sqrt(subst([d = dd, s = small, e = big], heron))/2)/(%pi*small^2))$
ship(dd, big, small) := bfloat(subst([d = dd, s = small, e = big],
                             1 - (s^2*acos(a1/s) - a1*sqrt(s^2 - a1^2)
                                  + e^2*acos(a2/e) - a2*sqrt(e^2 - a2^2))/(%pi*s^2)))$
worst : lmax(makelist(abs(ship(dd, 1/10, 1/100) - ref(dd, 1/10, 1/100)), dd,
                      [91/1000, 95/1000, 1/10, 105/1000, 109/1000]))$
print("shipped minus textbook at the test's five separations:", worst)$
must(is(worst < 10^-35), "(5) holds: the two forms agree to 1e-35 at the test's separations")$

print("DONE")$
