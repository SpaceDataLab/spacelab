/* Second engine for derivations/spherical_triangle.mac: the 16 reference excesses of the double-
   valued spherical triangles, re-evaluated in PARI at 100 digits by l'Huilier's theorem,
       tan(E/4)^2 = tan(s/2) tan((s-a)/2) tan((s-b)/2) tan((s-c)/2),
   on the exactly normalized doubles, signed by the triple product, and compared with Maxima's
   Van Oosterom-Strackee values (pasted below). Two formulas, two engines.

       timeout 300 gp -q -f derivations/spherical_triangle.gp </dev/null                         */

default(realprecision, 100);

dbl(m, e) = m * 2^e;
unitv(v) = v / sqrt(v * v~);
cross3(u, v) = [u[2]*v[3] - u[3]*v[2], u[3]*v[1] - u[1]*v[3], u[1]*v[2] - u[2]*v[1]];
{lhuilier(a, b, c) = my(sa = acos(b * c~), sb = acos(c * a~), sc = acos(a * b~), s = (sa + sb + sc) / 2);
  sign(a * cross3(b, c)~) * 4 * atan(sqrt(tan(s/2) * tan((s - sa)/2) * tan((s - sb)/2) * tan((s - sc)/2)));}

