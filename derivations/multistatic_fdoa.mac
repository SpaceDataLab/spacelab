/* The FDOA observable -- spacelab-estimation/src/multistatic.rs -- from the special-relativistic
 * Doppler law it is the first-order term of. An emitter at S with velocity V radiates at f; a
 * receiver at R_i with velocity U_i, n_i = (R_i - S)/|R_i - S| the propagation direction, receives
 *     f_i = f * [gamma_i (1 - n_i.U_i/c)] / [gamma_e (1 - n_i.V/c)],
 *     gamma_e = 1/sqrt(1 - |V|^2/c^2),  gamma_i = 1/sqrt(1 - |U_i|^2/c^2).
 * The code returns fdoa = (f/c)(rhodot_1 - rhodot_2), rhodot_i = (S - R_i).(V - U_i)/|S - R_i|, and
 * documents three claims about it, all checked here with e = 1/c as the expansion parameter:
 *
 *   1. the coefficient of e in f_2 - f_1 is f (rhodot_1 - rhodot_2) -- the coded FDOA is the first
 *      order term, and the range rate is n_i.(U_i - V);
 *   2. the emitter's transverse Doppler gamma_e is common to both legs: the e^2 coefficient of
 *      f_2 - f_1 is the same with gamma_e set to 1, so it cancels through second order;
 *   3. what is left out is of order f (v/c)^2: f (7.5 km/s / c)^2 = 1.377 Hz at 2.2 GHz (the doc's
 *      "1.4 Hz"), and on the module's fixture the exact law and the coded first order differ by an
 *      amount printed below, inside that bound.
 * Each line printing `<name>: 0`.
 *
 * Run: timeout 300 maxima --very-quiet --suppress-input-echo -Q -b derivations/multistatic_fdoa.mac </dev/null
 */

zero(name, expr) := block([d : expr],
  printf(true, "~a: ~a~%", name, d),
  if d # 0 then error("identity does not reduce to zero:", name))$

S : [sx, sy, sz]$ V : [vx, vy, vz]$
R1 : [ax, ay, az]$ U1 : [ux, uy, uz]$
R2 : [bx, by, bz]$ U2 : [wx, wy, wz]$
nrm(a) := sqrt(a . a)$
n1 : (R1 - S)/nrm(R1 - S)$ n2 : (R2 - S)/nrm(R2 - S)$
received(n, U, ge) := f*(1/sqrt(1 - e^2*(U . U)))*(1 - e*(n . U))/(ge*(1 - e*(n . V)))$
gam_e : 1/sqrt(1 - e^2*(V . V))$
fdoa_exact(ge) := received(n2, U2, ge) - received(n1, U1, ge)$
rhodot(R, U) := ((S - R) . (V - U))/nrm(S - R)$

/* 1. */
first : ratsimp(coeff(taylor(fdoa_exact(gam_e), e, 0, 1), e, 1))$
zero("fdoa_first_order_term_is_the_coded_range_rate_difference",
  ratsimp(radcan(first - f*(rhodot(R1, U1) - rhodot(R2, U2)))))$
zero("range_rate_is_n_dot_receiver_minus_emitter_velocity",
  ratsimp(radcan(rhodot(R1, U1) - n1 . (U1 - V))))$

/* 2. */
second_order(ge) := ratsimp(coeff(taylor(fdoa_exact(ge), e, 0, 2), e, 2))$
zero("emitter_transverse_doppler_cancels_through_second_order",
  ratsimp(radcan(second_order(gam_e) - second_order(1))))$
zero("fdoa_vanishes_at_zero_order", ratsimp(coeff(taylor(fdoa_exact(gam_e), e, 0, 1), e, 0)))$

/* 3. Size of the omitted terms. */
fpprec : 40$ fpprintprec : 30$
c : 299792458$ fc : 2200000000$
printf(true, "f (v/c)^2 at 2.2 GHz and 7.5 km/s = ~a Hz~%", bfloat(fc*(7500/c)^2))$
fix : [sx = 3961000, sy = 2614000, sz = 5215000, vx = -3140, vy = 6190, vz = -700,
       ax = 4075530, ay = 931781, az = 4801618, ux = -679/10, uy = 2972/10, uz = 0,
       bx = 3183899, by = 1421478, bz = 5322820, wx = -1036/10, wy = 2322/10, wz = 0,
       f = fc, e = 1/c]$
exact_fix : bfloat(subst(fix, fdoa_exact(gam_e)))$
coded_fix : bfloat(subst(fix, f*e*(rhodot(R1, U1) - rhodot(R2, U2))))$
printf(true, "fixture: coded first-order FDOA = ~a Hz, exact law - coded = ~a Hz~%",
  coded_fix, exact_fix - coded_fix)$
zero("fixture_omitted_terms_inside_the_documented_bound",
  if abs(exact_fix - coded_fix) < bfloat(fc*(7500/c)^2) then 0 else exact_fix - coded_fix)$
