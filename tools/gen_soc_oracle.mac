/* Reference values for the street-of-coverage geometry, at 60 decimal digits.
 *
 * The relations are transcribed from the street-of-coverage construction (Lüders 1961; Rider 1986;
 * SMAD ch. 7) independently of the Rust source, so a disagreement is a transcription error in one
 * of the two copies. Its own tests check the footprint half-angle against the elevation relation
 * and everything downstream of it only by inequality — that the co-rotating spacing exceeds the
 * counter-rotating one, that the filled spacing does not exceed the maximum — which leaves the node
 * spacings, the node span and the inter-plane stagger unpinned.
 *
 * Run: timeout 120 maxima --very-quiet -b tools/gen_soc_oracle.mac
 */

fpprec: 60$

re : 6378137b0$
mu : 3.986004418b14$

soc(alt, inc_deg, eps_deg, s_override) := block(
  [ratio, eps, inc, theta, s_min, s, half_du, lambda, arg_co, arg_ct,
   dw_co, dw_ct, span, planes, dw, phase_arg, du_inter],
  eps  : eps_deg * %pi/180,
  inc  : inc_deg * %pi/180,
  ratio: re/(re + alt),
  theta: acos(ratio*cos(eps)) - eps,
  s_min: ceiling(bfloat(%pi/theta)),
  s    : if s_override = false then s_min else s_override,
  half_du: %pi/s,
  lambda : acos(cos(theta)/cos(half_du)),
  arg_co : sin((theta + lambda)/2)/sin(inc),
  arg_ct : sin(lambda)/sin(inc),
  dw_co  : 2*asin(arg_co),
  dw_ct  : 2*asin(arg_ct),
  span   : %pi - dw_ct,
  planes : ceiling(bfloat(span/dw_co)) + 1,
  dw     : span/(planes - 1),
  phase_arg: cos(dw_co/2)/cos((theta + lambda)/2),
  du_inter : half_du - 2*acos(min(phase_arg, 1)),
  printf(true, "alt=~a inc=~a eps=~a S=~a~%", float(alt), float(inc_deg), float(eps_deg), s),
  printf(true, "  per_plane            ~a~%", s),
  printf(true, "  planes               ~a~%", planes),
  printf(true, "  footprint_half_angle ~,20e~%", float(theta)),
  printf(true, "  street_half_width    ~,20e~%", float(lambda)),
  printf(true, "  raan_step_co         ~,20e~%", float(dw_co)),
  printf(true, "  raan_step_counter    ~,20e~%", float(dw_ct)),
  printf(true, "  raan_step            ~,20e~%", float(dw)),
  printf(true, "  raan_span            ~,20e~%", float(span)),
  printf(true, "  inter_plane_phase    ~,20e~%", float(du_inter)))$

/* The Iridium-like case the crate's own fixture uses, at the S the floor picks... */
soc(780000b0, 86.4b0, 8.2b0, false)$
/* ...and the same orbit with S forced above the floor, which takes the override branch and moves
   every quantity downstream of half_du = pi/S. */
soc(780000b0, 86.4b0, 8.2b0, 12)$
