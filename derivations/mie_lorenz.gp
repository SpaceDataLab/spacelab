e6 = [1.992517002971068547785535160238893378334e-5, 2.402237524551816671003100228779473204165e-17, 1.97975090290429701015269619170028040118e-9];
maxima_coefficients = [c1, c2, c3, c4, c5, c6];
maxima_efficiencies = [e1, e2, e3, e4, e5, e6];
{
  my(bad = 0, checked = 0, bad_eff = 0);
  for (k = 1, #cases,
    my(x = cases[k][1], m = cases[k][2], N = cases[k][3], c = maxima_coefficients[k],
       e = maxima_efficiencies[k], q);
    for (n = 1, N,
      my(a = an(n, m, x), b = bn(n, m, x), want_a = c[n, 1] + I*c[n, 2],
         want_b = c[n, 3] + I*c[n, 4]);
      checked += 2;
      if (abs(a - want_a) > 1e-36*abs(want_a), bad++);
      if (abs(b - want_b) > 1e-36*abs(want_b), bad++));
    q = efficiencies(m, x, N);
    for (i = 1, 3, if (abs(q[i] - e[i]) > 1e-36*abs(e[i]), bad_eff++)));
  printf("mie coefficients: %d of %d off Maxima by more than 1e-36 relative\n", bad, checked);
  printf("mie efficiencies: %d of %d off Maxima by more than 1e-36 relative\n", bad_eff, 3*#cases);
}
