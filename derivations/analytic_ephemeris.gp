/* Second engine for derivations/analytic_ephemeris.mac: the analytic Sun and Moon of
   crates/spacelab-propagation/src/ephemeris.rs evaluated at 60 digits at the thirteen golden epochs
   of its tests, against the goldens' `series` column. The printed series as in the .mac; the
   precession is applied here as the inverse product R3(zeta) R2(-theta) R3(z) rather than as the
   transpose of P, so the two engines do not share the arrangement. Prints `PASS` lines; a failed
   check prints `FAIL`.

       timeout 300 gp -q -f derivations/analytic_ephemeris.gp </dev/null                       */

default(realprecision, 60);
{
sun_goldens = [
  [-3.15576e9, [28167214741.63290835148, -132450499569.6860145069, -57459459572.14703589479]],
  [-1.5e9, [964832862.7099257047885, 139475457346.0690153248, 60487896645.34318882052]],
  [-7.84308258e8, [134120844712.8546511573, -57488695256.12007082724, -24927520071.87101081167]],
  [0.0, [26507662136.61559315173, -132752709207.3643176294, -57555343056.05256580437]],
  [8.64e7, [-149539728435.5121784151, -10023243602.41699522406, -4345443030.76398841894]],
  [7.57339269184e8, [24822312238.47691160337, -133031282404.948326894, -57667652027.77624930643]],
  [1.5e9, [-55619282989.15422226305, 129860653831.5653686855, 56285458376.84220154416]],
  [2.698761487e9, [-43225880879.06620477007, 133799567147.1962361929, 57979259628.74010544351]],
  [3.019895577e9, [-147448907803.9539196681, 28214613873.855541376, 12228531979.32650501963]],
  [3.069300822e9, [144231034442.832146172, 36628399290.19972918678, 15867514260.85501836]],
  [3.15576e9, [24843208688.79265441104, -133038320794.846832528, -57643937671.95756632546]],
  [-9.46728e9, [31470786476.8273681387, -131796627677.1325973102, -57245988825.89662595244]],
  [9.46728e9, [21500442602.51787138119, -133559421747.0977010895, -57799104154.66687922954]]];
}
{
moon_goldens = [
  [-3.15576e9, [-21368234.87458305534443, -340402532.9456722445757, -144319777.1507238897981]],
  [-1.5e9, [153129535.581166244392, 319161587.0032233632897, 175536815.071663627464]],
  [-7.84308258e8, [-199850876.2886467097804, 284890752.0610037635742, 94530875.69176748632204]],
  [0.0, [-291492224.1600419237295, -266630266.9123104876023, -76098486.23612924421203]],
  [8.64e7, [144249721.2888966671794, 341598778.3845721997048, 146715213.7042406616861]],
  [7.57339269184e8, [-368023857.5828822338311, 142542502.5717727254829, 89256829.97011934228666]],
  [1.5e9, [383386385.8694832701789, 93266400.03211139968867, 80793931.5841832280627]],
  [2.698761487e9, [235103362.928682364346, -258197564.7110772860935, -88683629.15761513318337]],
  [3.019895577e9, [278027634.72473453821, -205701759.3326994193897, -121291981.1366689654601]],
  [3.069300822e9, [168326746.7535158537375, -317119623.0768393133642, -175680198.6037669867506]],
  [3.15576e9, [-355109676.1545417439696, 98066972.62595107937489, 45866094.09125699259836]],
  [-9.46728e9, [383529615.9667456047297, 75747562.70271492963971, 19353103.47426703702529]],
  [9.46728e9, [197646453.1899011536489, 284825344.2749009289985, 109603266.0788945640927]]];
}

AU = 149597870700; JC = 86400*36525; dg = Pi/180; as = dg/3600;
R1(a) = [1, 0, 0; 0, cos(a), sin(a); 0, -sin(a), cos(a)];
R2(a) = [cos(a), 0, -sin(a); 0, 1, 0; sin(a), 0, cos(a)];
R3(a) = [cos(a), sin(a), 0; -sin(a), cos(a), 0; 0, 0, 1];
zetaA(T) = 2650545/10^6 + 2306083227/10^6*T + 2988499/10^7*T^2 + 1801828/10^8*T^3 - 5971/10^9*T^4 - 3173/10^10*T^5;
zA(T) = -2650545/10^6 + 2306077181/10^6*T + 10927348/10^7*T^2 + 1826837/10^8*T^3 - 28596/10^9*T^4 - 2904/10^10*T^5;
thetaA(T) = 2004191903/10^6*T - 4294934/10^7*T^2 - 4182264/10^8*T^3 - 7089/10^9*T^4 - 1274/10^10*T^5;
toj2000(T, v) = R3(zetaA(T)*as)*R2(-thetaA(T)*as)*R3(zA(T)*as)*v~;
fr(x) = x - floor(x);
cd(x) = cos(x*dg);
sd(x) = sin(x*dg);
{
sun(sec) =
  my(T = sec/JC, L = 280460/1000 + 36000771/1000*T, g = 357528/1000 + 35999050/1000*T, Rau, lam, eps);
  Rau = 100014/100000 - 1671/100000*cd(g) - 14/100000*cd(2*g);
  lam = L + 1915/1000*sd(g) + 20/1000*sd(2*g) + 2049552/100000/3600/Rau;
  eps = 23439291/10^6 - 130042/10^7*T;
  toj2000(T, AU*Rau*[cd(lam), cd(eps)*sd(lam), sd(eps)*sd(lam)]);
}
{
moon(sec) =
  my(T = sec/JC, L0, l, lp, D, F, dL, S, h, N, lon, lat, r);
  L0 = fr(606433/10^6 + 1336851344/10^6*T);
  l = 360*fr(374897/10^6 + 1325552410/10^6*T);
  lp = 360*fr(993133/10^6 + 99997361/10^6*T);
  D = 360*fr(827361/10^6 + 1236853086/10^6*T);
  F = 360*fr(259086/10^6 + 1342227825/10^6*T);
  dL = 22640*sd(l) - 4586*sd(l - 2*D) + 2370*sd(2*D) + 769*sd(2*l) - 668*sd(lp) - 412*sd(2*F)
       - 212*sd(2*l - 2*D) - 206*sd(l + lp - 2*D) + 192*sd(l + 2*D) - 165*sd(lp - 2*D) - 125*sd(D)
       - 110*sd(l + lp) + 148*sd(l - lp) - 55*sd(2*F - 2*D);
  lon = 360*fr(L0 + dL/1296000);
  S = F + (dL + 412*sd(2*F) + 541*sd(lp))/3600;
  h = F - 2*D;
  N = -526*sd(h) + 44*sd(l + h) - 31*sd(-l + h) - 23*sd(lp + h) + 11*sd(-lp + h) - 25*sd(-2*l + F) + 21*sd(-l + F);
  lat = (18520*sd(S) + N)/3600;
  r = 1000*(385000 - 20905*cd(l) - 3699*cd(2*D - l) - 2956*cd(2*D) - 570*cd(2*l) + 246*cd(2*l - 2*D)
       - 205*cd(lp - 2*D) - 171*cd(l + 2*D) - 152*cd(l + lp - 2*D));
  R1(-2343929111/10^8*dg)*(r*[cd(lon)*cd(lat), sd(lon)*cd(lat), sd(lat)])~;
}
{
check(tag, goldens, f) =
  my(worst = 0);
  for (k = 1, #goldens,
    my(g = goldens[k], v = f(g[1]), w = g[2]~);
    worst = max(worst, sqrt(norml2(v - w)/norml2(w))));
  print(if (worst < 10^-20, "PASS ", "FAIL "), tag, " series reproduces the goldens, worst relative ", Strprintf("%.3g", worst));
}
check("sun", sun_goldens, sun);
check("moon", moon_goldens, moon);
