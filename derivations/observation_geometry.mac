/* Sun/sensor viewing geometry -- spacelab-earthvision/src/geometry.rs -- as identities.
 *
 * In a local frame with up U, north N and east E = N x U, a direction at zenith angle z and azimuth a
 * (from north toward east) is
 *     d(z, a) = sin z cos a N + sin z sin a E + cos z U.
 * The code reads z = acos(d.U), a = atan2(d.E, d.N), the relative azimuth a_v - a_s, the scattering
 * angle Theta = acos(-to_sun . to_sensor) between the incident (-to_sun) and the scattered
 * (to_sensor) propagation directions, and the Kasten & Young (1989, Appl. Opt. 28, 4735) air mass
 *     m(z) = 1 / (cos z + a (b - z_deg)^(-c)),  a = 0.50572, b = 96.07995 (= 90 + 6.07995 deg),
 *     c = 1.6364,
 * the constants as printed there. Shown here, each line printing `<name>: 0`:
 *   1. E = N x U makes (E, N, U) right-handed: E x N = U, N x U = E, U x E = N;
 *   2. d(z, a).U = cos z, d.E = sin z sin a, d.N = sin z cos a -- so acos and atan2 return z and a
 *      (for sin z > 0), and |d| = 1;
 *   3. -d(z_s, a_s).d(z_v, a_v) = -(cos z_s cos z_v + sin z_s sin z_v cos(a_v - a_s)), the
 *      spherical law of cosines the scattering angle rests on, and it depends on the azimuths only
 *      through their difference;
 *   4. Kasten-Young at the zenith is 1/(1 + a b^-c), and with the correction amplitude a set to 0 it
 *      is the plane-parallel sec z -- the formula's two defining limits (G3);
 *   5. the Kasten-Young values the Rust gate reads, at 40 digits, for dyadic zenith angles.
 *
 * Run: timeout 300 maxima --very-quiet --suppress-input-echo -Q -b derivations/observation_geometry.mac </dev/null
 */

zero(name, expr) := block([d : expr],
  printf(true, "~a: ~a~%", name, d),
  if d # 0 then error("identity does not reduce to zero:", name))$

cross(u, v) := [u[2]*v[3] - u[3]*v[2], u[3]*v[1] - u[1]*v[3], u[1]*v[2] - u[2]*v[1]]$

/* N and U as the x and z axes: every identity below is a dot or cross product, invariant under the
   rotation that takes any orthonormal pair to these. */
Uv : [0, 0, 1]$ Nv : [1, 0, 0]$
Ev : cross(Nv, Uv)$
zero("east_cross_north_is_up", ratsimp(cross(Ev, Nv) - Uv) . [1, 1, 1])$
zero("north_cross_up_is_east", ratsimp(cross(Nv, Uv) - Ev) . [1, 1, 1])$
zero("up_cross_east_is_north", ratsimp(cross(Uv, Ev) - Nv) . [1, 1, 1])$

dir(z, a) := sin(z)*cos(a)*Nv + sin(z)*sin(a)*Ev + cos(z)*Uv$
ds : dir(zs, as)$ dv : dir(zv, av)$
zero("direction_up_component_is_cos_zenith", trigsimp(ds . Uv - cos(zs)))$
zero("direction_east_component", trigsimp(ds . Ev - sin(zs)*sin(as)))$
zero("direction_north_component", trigsimp(ds . Nv - sin(zs)*cos(as)))$
zero("direction_is_unit", trigsimp(ds . ds - 1))$
scat : -(ds . dv)$
zero("scattering_cosine_is_the_spherical_law_of_cosines",
  trigsimp(trigexpand(scat + (cos(zs)*cos(zv) + sin(zs)*sin(zv)*cos(av - as)))))$
zero("scattering_cosine_depends_only_on_the_azimuth_difference",
  trigsimp(trigexpand(subst([as = as + t, av = av + t], scat) - scat)))$

ka : 50572/100000$ kb : 9607995/100000$ kc : 16364/10000$
ky(zr, a) := 1/(cos(zr) + a*(kb - zr*180/%pi)^(-kc))$
zero("kasten_young_at_the_zenith", ratsimp(ky(0, ka) - 1/(1 + ka*kb^(-kc))))$
zero("kasten_young_plane_parallel_limit", trigsimp(ky(zr, 0) - 1/cos(zr)))$

fpprec : 40$
/* The last is the double nearest pi/2, FRAC_PI_2 = 884279719003555/2^49. */
for zr in [0, 1/2, 1, 11/8, 49/32, 25/16, 884279719003555/2^49] do
  printf(true, "kasten_young(~a) = ~a~%", zr, bfloat(ky(bfloat(zr), ka)))$
