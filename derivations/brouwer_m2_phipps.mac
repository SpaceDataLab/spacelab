/* The along-track drag term of crates/spacelab-elements/src/brouwer_lyddane.rs, derived by its
   document's own steps (plans/17 Ф17.O).

   Phipps 1992, "Parallelization of the Naval Space Surveillance Center (NAVSPASUR) satellite motion
   model", NPS thesis, hdl 10945/24001 (a work of the U.S. Government), pp. 22-23:
   (2.38) l'' = l''_0 + m t + M2 t^2 + M3 t^3, with m = n_0 (1 + delta_s l);
   (2.39) a''^3 = m^-2 in his units, Kepler's third law with m for n_0;
   (2.40) its derivative to first order, (2.41) with m-dot = 2 M2 from (2.38): a-dot = -4 a'' M2/(3m);
   (2.44) Delta e/Delta a = e eta^2 sigma/a, his lowest-order average of Danby's exponential-
   atmosphere rates (2.43); (2.45) the same with sigma = 1, which he assumes and does not derive.
   The code carries M3 = 0 (Orekit's choice) and evaluates each rate at the mean epoch, so a and e
   drift linearly in t: first order, as (2.40) is.

   (1) m-dot = 2 M2 from (2.38); (2)-(3) (2.40)-(2.41) from Kepler's law with mu kept; (4) (2.45);
   (5)-(7) the code's drift of a, e and l'' is those lines.

   Every check prints as `<name>: 0`, 7 of them.

   timeout 120 maxima --very-quiet -Q -b brouwer_m2_phipps.mac                                    */

display2d : false$
assume(mu > 0, m > 0, n0 > 0)$

/* (1) */
l : l0 + m*t + M2*t^2 + M3*t^3$
print("mean_motion_rate_at_epoch:", ratsimp(subst(t = 0, diff(l, t, 2)) - 2*M2))$

/* (2)-(3) a = (mu/m^2)^(1/3) */
a_of(mm) := (mu/mm^2)^(1/3)$
print("kepler_derivative:", radcan(diff(a_of(m), m) + (2/3)*a_of(m)/m))$
adot : diff(a_of(m), m)*(2*M2)$
print("semi_major_rate:", radcan(adot - (-4*a_of(m)*M2/(3*m))))$

/* (4) (2.44) with sigma = 1 and (2.41) */
eta2 : 1 - e^2$
edot : e*eta2/a*(-4*a*M2/(3*m))$
print("eccentricity_rate:", ratsimp(edot - (-4*e*eta2*M2/(3*m))))$

/* (5)-(7) the code: coef = -4/(3 n0 (1 + dsl)), a_rate = coef a, e_rate = coef e n2 with n2 = 1 - e^2,
   a(t) = a + (t M2) a_rate, e(t) = e + (t M2) e_rate, l(t) = l0 + (1 + dsl) n0 t + t (t M2). */
mm : n0*(1 + dsl)$
coef : -4/(3*n0*(1 + dsl))$
print("code_semi_major_drift:", ratsimp(a + t*M2*coef*a - (a + t*(-4*a*M2/(3*mm)))))$
print("code_eccentricity_drift:", ratsimp(e + t*M2*coef*e*(1 - e^2) - (e + t*(-4*e*eta2*M2/(3*mm)))))$
print("code_mean_anomaly:", ratsimp(l0 + (1 + dsl)*n0*t + t*(t*M2) - subst([m = mm, M3 = 0], l)))$
