/* DSST's scalar coefficients and Danielson's two truncation bounds from their definitions, at the
   doubles the test passes (plans/17 Ф19.G): spacelab-propagation's
   tests/fixtures/dsst_coefficients.csv, which dsst/coefficients.rs is held against.

   coefficients.rs computes eight quantities by six recurrences. Each has a closed form. This file
   first proves, in exact arithmetic, that every recurrence the module runs is its closed form at
   every index the fixture holds, then evaluates the closed form at the inputs' doubles:

     (1) V_ns = (-1)^((n-s)/2) (n-s-1)!!/(n+s)!!, 0 for n - s odd (Danielson 2.8.2), against
         (n-s)!/(n+s)! P_n^(s)(0) and against the module's recurrence.
     (2) Q_ns(g) = P_n^(s)(g), the s-th derivative of the Legendre polynomial (Danielson 2.8.3):
         Rodrigues' formula against orthopoly and against the module's recurrence.
     (3) G_s + i H_s = ((k a + h b) + i (h a - k b))^s = (k + i h)^s (a - i b)^s (Danielson 3.1-(5)),
         against the module's recurrence.
     (4) P_l^(v,w)(x), the Jacobi polynomial: its explicit sum against orthopoly and against the
         Hipparchus three-term recurrence the module runs. Its derivative is diff's.
     (5) D_n^l(chi) = chi^(n+l) (n-1)!/(n+l-1)! P_(n-1)^(l)(chi) for n >= l + 1, against the
         module's recurrence; below n = l + 1 the bound is held at its n = l + 1 value,
         chi (chi^2/2)^l. At l = 0 it is the mean of (a/r)^(n+1) over the mean anomaly, integrated
         here: the zonal Hansen coefficient K_0^(-n-1,0).
     (6) R_n^(m,l)(g) = max(0.03, sin i)^(l - m eps) (1 + g)^(m eps)
                         * sqrt(J^2 + J'^2 sin^2 i / ((n - l)(n + l + 1))),
         J = P_(n-l)^(l-m, l+m)(eps g), J' = dJ/dg, sin^2 i = 1 - g^2; at n = l the prefactor
         alone. J against the module's recurrence. At g = -1 with m eps < 0 the factor
         (1 + g)^(m eps) has a pole; the row holds IEEE's reading of the product: Infinity, or NaN
         where J = 0 makes it infinity times zero.

   V, Q, G, H, the Jacobi values and D are exact rationals; R is evaluated at 60 digits. Each value is
   printed to 25 significant digits, which the test's parse rounds to the nearest double. The index
   sets and the row order are those of the Orekit comparison fixture, so the two files pair line by
   line.

   timeout 300 maxima --very-quiet -Q -b dsst_coefficients.mac                                     */

fpprec : 60$
linel : 2000$
load("orthopoly")$
load("rust_literals.mac")$

df(k) := if k <= 0 then 1 else k * df(k - 2)$

chis : map(nearest_double, [1, 1005/1000, 105/100, 12/10, 16/10, 23/10])$
gammas : map(nearest_double, [-1, -9995/10000, -8/10, -4/10, 0, 4/10, 8/10, 9995/10000, 1])$
kh : map(lambda([p], map(nearest_double, p)), [[0, 0], [5/100, -2/100], [-3/10, 4/10], [6/10, 6/10]])$
ab : map(lambda([p], map(nearest_double, p)),
         [[1, 0], [6/10, -8/10], [-28/100, 96/100], [0, 1]])$
degrees : [2, 3, 4, 6, 9, 12]$
sin_floor : nearest_double(3/100)$

/* (1) V_ns */
vns_closed(n, s) := if oddp(n - s) then 0 else (-1)^((n - s)/2) * df(n - s - 1) / df(n + s)$
vns_legendre(n, s) := (n - s)! / (n + s)! * subst(x = 0, diff(legendre_p(n, x), x, s))$
block([order : 14, v, ok : true],
  v : make_array(any, order, order),
  for n : 0 thru order - 1 do for s : 0 thru order - 1 do v[n, s] : 0,
  v[0, 0] : 1,
  for n : 0 thru order - 1 do for s : 0 thru n do
    if evenp(n - s) then (
      if n = s and s + 1 < order then v[s + 1, s + 1] : v[s, s] / (2 * s + 2),
      if n + 2 < order then v[n + 2, s] : v[n, s] * (s - n - 1) / (n + s + 2)),
  for n : 0 thru order - 1 do for s : 0 thru n do
    if not (is(vns_closed(n, s) = vns_legendre(n, s)) and is(vns_closed(n, s) = v[n, s]))
    then ok : false,
  if ok then print("(1) holds: V_ns closed form = (n-s)!/(n+s)! P_n^(s)(0) = the recurrence, n < 14")
  else error("FAILED: V_ns"))$

/* (2) Q_ns */
leg_rodrigues(n) := ratexpand(diff((x^2 - 1)^n, x, n) / (2^n * n!))$
qns_poly[n, s] := ratexpand(diff(legendre_p(n, x), x, s))$
block([q, ok : true, nmax : 12],
  q : make_array(any, nmax + 1, nmax + 1),
  q[0, 0] : 1,
  for n : 1 thru nmax do for s : 0 thru n do
    q[n, s] : if n = s then (2 * s - 1) * q[s - 1, s - 1]
              else if n - s = 1 then (2 * s + 1) * x * q[s, s]
              else ratexpand(((2 * n - 1) * x * q[n - 1, s] - (n + s - 1) * q[n - 2, s]) / (n - s)),
  for n : 0 thru nmax do for s : 0 thru n do
    if not (is(ratexpand(diff(leg_rodrigues(n), x, s) - qns_poly[n, s]) = 0)
            and is(ratexpand(q[n, s] - qns_poly[n, s]) = 0))
    then ok : false,
  if ok then print("(2) holds: Q_ns = d^s P_n/dg^s by Rodrigues = orthopoly = the recurrence, n <= 12")
  else error("FAILED: Q_ns"))$

/* (3) G_s, H_s */
block([gs : 1, hs : 0, ok : true, c : k * a + h * b, d : h * a - k * b, t],
  for s : 0 thru 12 do (
    if s > 0 then (t : ratexpand(c * gs - d * hs), hs : ratexpand(d * gs + c * hs), gs : t),
    t : expand((k + %i * h)^s * (a - %i * b)^s),
    if not (is(ratexpand(realpart(t) - gs) = 0) and is(ratexpand(imagpart(t) - hs) = 0)
            and is(ratexpand(realpart(expand((c + %i * d)^s)) - gs) = 0))
    then ok : false),
  if ok then print("(3) holds: G_s + i H_s = (k + i h)^s (a - i b)^s = the recurrence, s <= 12")
  else error("FAILED: G_s, H_s"))$

/* (4) Jacobi */
jacobi_sum[l, v, w] := ratexpand(sum(binomial(l + v, l - j) * binomial(l + w, j)
                                     * ((x - 1) / 2)^j * ((x + 1) / 2)^(l - j), j, 0, l))$
jacobi_hipparchus(l, v, w) := block([pm : 1, pk : (v - w) / 2 + (2 + v + w) / 2 * x, nx],
  if l = 0 then return(1),
  for kk : 2 thru l do block([kvw : kk + v + w, t, den],
    t : kvw + kk,
    den : 2 * kk * kvw * (t - 2),
    nx : ratexpand(((t - 1) * (v^2 - w^2) / den + (t - 1) * t * (t - 2) / den * x) * pk
                   - 2 * (kk + v - 1) * (kk + w - 1) * t / den * pm),
    pm : pk, pk : nx),
  pk)$
block([ok : true],
  for l : 0 thru 6 do for v : 0 thru 4 do for w : 0 thru 4 do
    if not (is(ratexpand(jacobi_p(l, v, w, x) - jacobi_sum[l, v, w]) = 0)
            and is(ratexpand(jacobi_hipparchus(l, v, w) - jacobi_sum[l, v, w]) = 0))
    then ok : false,
  if ok then print("(4) holds: P_l^(v,w) explicit sum = orthopoly = the Hipparchus recurrence, l <= 6, v, w <= 4")
  else error("FAILED: Jacobi"))$

/* (5) D_n^l */
dnl_closed(n, l) := if n >= l + 1
  then x^(n + l) * (n - 1)! / (n + l - 1)! * diff(legendre_p(n - 1, x), x, l)
  else x * (x^2 / 2)^l$
dnl_recurrence(n, l) := block([xx : x^2, xpl : x * (x^2 / 2)^l, dl, dm, db],
  if n > l + 2 then (
    dm : xpl, db : (l + 1) * xx * xpl,
    for j : l + 3 thru n do (
      dl : dm, dm : db,
      db : ratexpand((j - 1) * xx * ((2 * j - 3) * dm - (j - 2) * dl) / ((j - 1)^2 - l^2))),
    db)
  else if n = l + 2 then (l + 1) * xx * xpl
  else xpl)$
block([ok : true],
  for n in degrees do for l : 0 thru n do
    if not is(ratexpand(dnl_closed(n, l) - dnl_recurrence(n, l)) = 0) then ok : false,
  if ok then print("(5) holds: D_n^l closed form = the recurrence at every fixture (n, l)")
  else error("FAILED: D_n^l"))$
block([ok : true, mean],
  for n : 1 thru 12 do (
    mean : integrate(expand((1 + e * cos(f))^(n - 1)), f, 0, 2 * %pi) / (2 * %pi),
    mean : ratsubst(1 - 1 / x^2, e^2, ratexpand(mean)),
    if not is(ratsimp(x^(2 * n - 1) * mean - dnl_closed(n, 0)) = 0) then ok : false),
  if ok then print("(5') holds: D_n^0(chi) = <(a/r)^(n+1)>_M, integrated over the true anomaly, n <= 12")
  else error("FAILED: D_n^0 is not the mean of (a/r)^(n+1)"))$

/* (6) R_n^(m,l) */
rnml_jacobi(n, l, m, eps) := ratexpand(subst(x = eps * g, jacobi_sum[n - l, l - m, l + m]))$
rnml_recurrence(n, l, m, eps) := block([dp : (l + 1) * eps, p, p1 : 1, dp1 : 0, p2, dp2],
  p : dp * g - m,
  for nn : l + 2 thru n do block([nm1 : nn - 1, tnm1, nnlnl, nnmnm, c2nne, coef],
    tnm1 : nn + nm1,
    nnlnl : nm1 * (nn^2 - l^2),
    nnmnm : nn * (nm1^2 - m^2),
    c2nne : tnm1 * nn * nm1 * eps,
    coef : c2nne * g - tnm1 * m * l,
    p2 : p1, dp2 : dp1, p1 : p, dp1 : dp,
    p : ratexpand((coef * p1 - nnmnm * p2) / nnlnl),
    dp : ratexpand((coef * dp1 - nnmnm * dp2 + c2nne * p1) / nnlnl)),
  [p, dp])$
block([ok : true, j, r],
  for n in degrees do for l : 0 thru n - 1 do for m : 0 thru min(n, 3) do for eps in [-1, 1] do (
    j : rnml_jacobi(n, l, m, eps),
    r : rnml_recurrence(n, l, m, eps),
    if not (is(ratexpand(r[1] - j) = 0) and is(ratexpand(r[2] - diff(j, g)) = 0)) then ok : false),
  if ok then print("(6) holds: the R_n^(m,l) recurrence is P_(n-l)^(l-m,l+m)(eps g) and its g-derivative")
  else error("FAILED: R_n^(m,l)"))$

rnml_value(gv, n, l, m, eps) := block([mei : m * eps, sinsq : 1 - gv^2, sininc, j, dj, tail],
  sininc : if bfloat(sqrt(sinsq)) > sin_floor then sqrt(sinsq) else sin_floor,
  j : subst(g = gv, rnml_jacobi(n, l, m, eps)),
  dj : subst(g = gv, diff(rnml_jacobi(n, l, m, eps), g)),
  tail : if n = l then 1 else sqrt(j^2 + dj^2 * sinsq / ((n - l) * (n + l + 1))),
  if 1 + gv = 0 and mei < 0 then (if n > l and j = 0 then 'nan else 'inf)
  else if 1 + gv = 0 and mei > 0 then 0
  else bfloat(sininc^(l - mei) * (if mei = 0 then 1 else (1 + gv)^mei) * tail))$

/* The rows. */
pad2(e) := if e < 10 then concat("0", e) else string(e)$
sci(v, d) := block([a : abs(v), e, m, t],
  if is(equal(v, 0)) then return(concat("0.", smake(d - 1, "0"), "e+00")),
  e : floor(float(log(bfloat(a)) / log(10b0))),
  m : round(a * 10^(d - 1 - e)),
  if m >= 10^d then (e : e + 1, m : round(a * 10^(d - 1 - e))),
  if m < 10^(d - 1) then (e : e - 1, m : round(a * 10^(d - 1 - e))),
  t : string(m),
  concat(if is(v < 0) then "-" else "", charat(t, 1), ".", substring(t, 2), "e",
         if e < 0 then "-" else "+", pad2(abs(e))))$
value(v) := if v = 'inf then "Infinity" else if v = 'nan then "NaN" else sci(v, 25)$
rows : 0$
row(kind, a, b, c, d, ee, v) := (
  printf(true, "~a,~a,~d,~d,~d,~d,~a~%", kind, sci(a, 18), b, c, d, ee, value(v)),
  rows : rows + 1)$

for chi in chis do for n in degrees do for l : 0 thru n do
  row("dnl", chi, n, l, 0, 0, subst(x = chi, dnl_closed(n, l)))$
for gv in gammas do for n in degrees do for l : 0 thru n do for m : 0 thru min(n, 3) do
  for eps in [-1, 1] do row("rnml", gv, n, l, m, eps, rnml_value(gv, n, l, m, eps))$
for n : 0 thru 13 do for s : 0 thru n do row("vns", 0, n, s, 0, 0, vns_closed(n, s))$
for gv in gammas do for n : 0 thru 12 do for s : 0 thru n do
  row("qns", gv, n, s, 0, 0, subst(x = gv, qns_poly[n, s]))$
for pi : 1 thru 4 do for qi : 1 thru 4 do block([kk : kh[pi][1], hh : kh[pi][2], aa : ab[qi][1],
                                                bb : ab[qi][2], t],
  for s : 0 thru 12 do (
    t : if s = 0 then 1 else expand((kk * aa + hh * bb + %i * (hh * aa - kk * bb))^s),
    row("gs", kk, s, pi - 1, qi - 1, 0, realpart(t)),
    row("hs", hh, s, pi - 1, qi - 1, 0, imagpart(t))))$
for gv in gammas do for l : 0 thru 6 do for v : 0 thru 4 do for w : 0 thru 4 do (
  row("jacobi_value", gv, l, v, w, 0, subst(x = gv, jacobi_sum[l, v, w])),
  row("jacobi_deriv", gv, l, v, w, 0, subst(x = gv, diff(jacobi_sum[l, v, w], x))))$

if rows = 7712 then print("(7) holds: 7712 rows, the Orekit fixture's index sets")
else error("FAILED: row count", rows)$
print("DONE")$
