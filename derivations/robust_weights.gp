{
my(off = 0, worst = 0.);
for (i = 1, #ST, my([p, r, nu, n, want] = ST[i], d = abs(student(p, r, nu, n) / want - 1));
  worst = max(worst, d); if (d > 1e-38, off++));
printf("student-t decade sweep off Maxima's by more than 1e-38 relative: %d of %d off (largest %.3g)\n",
  off, #ST, worst);
if (off, print("FAIL: the decade sweep disagrees with Maxima's"));
}
