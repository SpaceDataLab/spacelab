/* The closed forms crates/spacelab-autodiff/tests/derivatives.rs holds the dual numbers to:
   the Jacobian and the Hessian of the two-body acceleration a = -mu r / |r|^3.

     da_i/dr_j        = -mu/|r|^3 (delta_ij - 3 r_i r_j / |r|^2)
     d2a_i/dr_j dr_k  = 3 mu/|r|^5 (delta_ij r_k + delta_ik r_j + delta_jk r_i)
                        - 15 mu/|r|^7 r_i r_j r_k

   Each entry is differentiated from the acceleration itself and the closed form subtracted; every
   one of the 9 + 27 residuals must simplify to 0. */

r : [x1, x2, x3]$
R : sqrt(x1^2 + x2^2 + x3^2)$
a : makelist(-mu * r[i] / R^3, i, 1, 3)$
kd(i, j) := if i = j then 1 else 0$

jac : flatten(makelist(makelist(
  ratsimp(diff(a[i], r[j]) - (-mu / R^3 * (kd(i, j) - 3 * r[i] * r[j] / R^2))),
  j, 1, 3), i, 1, 3))$
hes : flatten(makelist(makelist(makelist(
  ratsimp(diff(a[i], r[j], 1, r[k], 1)
          - (3 * mu / R^5 * (kd(i, j) * r[k] + kd(i, k) * r[j] + kd(j, k) * r[i])
             - 15 * mu / R^7 * r[i] * r[j] * r[k])),
  k, 1, 3), j, 1, 3), i, 1, 3))$

print("jacobian:", length(sublist(jac, lambda([e], is(e = 0)))), "of", length(jac), "residuals are 0")$
print("hessian:", length(sublist(hes, lambda([e], is(e = 0)))), "of", length(hes), "residuals are 0")$
