/* The Stumpff polynomials in spacelab-astro `kepler::stumpff`, generated and certified (plans/17
   Ф28.B).

   Inside |w| <= 1/32 the code evaluates C(w) and S(w) as degree-4 polynomials in w with double
   coefficients, STUMPFF_C_POLY and STUMPFF_S_POLY. They are fpminimax's best relative fit on
   [-1/32; 1/32] to the Taylor polynomial to w^20, whose own truncation is below 1e-80 relative there.
   They were generated at prec = 300. fpminimax's last two coefficients move with the working
   precision (150, 200, 250, 300, 400, 600 and 1000 bits give seven different pairs), so this file
   regenerates them at prec = 300 and prints whether it reproduces the committed doubles, but the
   gate is the certified bound of the committed polynomial, whatever a regeneration gives.
   approximation_supnorm.mac checks that the Rust literals parse to these doubles.

   Each sign of w is its own function of s = sqrt|w| in [0, sqrt(1/32)]: C = (1 - cos s)/s^2 and
   S = (s - sin s)/s^3 for w = s^2, (cosh s - 1)/s^2 and (sinh s - s)/s^3 for w = -s^2.
   supnorm_lib.sollya's `split` encloses sup |p/f - 1| on each. S's bound is the 2^-54 its constant
   term costs: that term is the double nearest 1/6, which fpminimax cannot improve on.

   cd derivations && timeout 300 sollya kepler_stumpff_supnorm.sollya                            */

execute("supnorm_lib.sollya");

cc = [| 0.5, -0x1.55555555554fcp-5, 0x1.6c16c16c16cbcp-10, -0x1.a01a046ca0206p-16,
        0x1.27e4f90f06504p-22 |];
sc = [| 0x1.5555555555555p-3, -0x1.11111111110f5p-7, 0x1.a01a01a16f5a3p-13, -0x1.71de3c1124996p-19,
        0x1.addbccc35eef3p-26 |];

h = 1/32;
tc = 0; ts = 0;
for k from 0 to 20 do { tc = tc + (-x)^k / fact(2*k + 2); ts = ts + (-x)^k / fact(2*k + 3); };

generated = proc(name, p, committed) {
  var k, same;
  same = true;
  for k from 0 to 4 do if coeff(p, k) != committed[k] then same = false;
  if same then print("GENERATED", name, ": fpminimax at prec = 300 gives the committed coefficients")
  else print("GENERATED", name, ": fpminimax at prec = 300 now gives other coefficients", p);
};

poly = proc(a, y) { return a[0] + y * (a[1] + y * (a[2] + y * (a[3] + y * a[4]))); };

prec = 300!;
generated("kepler_stumpff_C", fpminimax(tc, 4, [|D, D, D, D, D|], [-h; h], relative), cc);
generated("kepler_stumpff_S", fpminimax(ts, 4, [|D, D, D, D, D|], [-h; h], relative), sc);
prec = 200!;

b = round(sqrt(1/32), prec, RU);
split("kepler_stumpff_C_pos", x^2 * poly(cc, x^2), 1 - cos(x), b, 48);
split("kepler_stumpff_C_neg", x^2 * poly(cc, -x^2), cosh(x) - 1, b, 48);
split("kepler_stumpff_S_pos", x^3 * poly(sc, x^2), x - sin(x), b, 48);
split("kepler_stumpff_S_neg", x^3 * poly(sc, -x^2), sinh(x) - x, b, 48);
quit;
