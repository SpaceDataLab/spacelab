{inputs_off = 0; signs_off = 0;
for (i = 1, #maxima,
  if (rows[i][3] != maxima[i][3], inputs_off++);
  if (rows[i][2] != maxima[i][2], signs_off++));}
printf("%d rows rebuilt, %d in the Maxima table\n", #rows, #maxima);
printf("%d rows whose inputs differ from Maxima's, %d whose exact sign differs\n", inputs_off, signs_off);

u = 2^-53; filt = 2^-46;
{printf("roundings k = 4, 11, 8 not covered by the filter: %d\n",
  sum(i = 1, 3, my(k = [4, 11, 8][i]); (1 + u)^k - 1 > filt * (1 - u)^k));}
