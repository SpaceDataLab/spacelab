dot(bb,v) := sum(bb[i]*v[i], i,1,s)$
Ac(k) := makelist(sum(a[i,j]*c[j]^k, j,1,s), i,1,s)$
bfabs(x) := if x<0 then -x else x$
print("Q1 Sb - 1        :", float(bfabs(sum(b[i], i,1,s) - 1b0)))$
print("Q2 Sb c^1 - 1/2 :", float(bfabs(sum(b[i]*c[i]^1, i,1,s) - 1/2b0)))$
print("Q3 Sb c^2 - 1/3 :", float(bfabs(sum(b[i]*c[i]^2, i,1,s) - 1/3b0)))$
print("Q4 Sb c^3 - 1/4 :", float(bfabs(sum(b[i]*c[i]^3, i,1,s) - 1/4b0)))$
print("Q5 Sb c^4 - 1/5 :", float(bfabs(sum(b[i]*c[i]^4, i,1,s) - 1/5b0)))$
print("Q6 Sb c^5 - 1/6 :", float(bfabs(sum(b[i]*c[i]^5, i,1,s) - 1/6b0)))$
print("Q7 Sb c^6 - 1/7 :", float(bfabs(sum(b[i]*c[i]^6, i,1,s) - 1/7b0)))$
print("Q8 Sb c^7 - 1/8 :", float(bfabs(sum(b[i]*c[i]^7, i,1,s) - 1/8b0)))$
print("T1 Sb Ac - 1/6   :", float(bfabs(dot(b, Ac(1)) - 1/6b0)))$
print("T2 Sb c Ac - 1/8 :", float(bfabs(sum(b[i]*c[i]*Ac(1)[i], i,1,s) - 1/8b0)))$
print("T3 Sb Ac^2 - 1/12:", float(bfabs(dot(b, Ac(2)) - 1/12b0)))$
print("consistency max|row(a)-c|:", float(lmax(makelist(bfabs(sum(a[i,j],j,1,s)-c[i]), i,1,s))))$
