# Second engine for walker_phasing.mac: the Walker Delta pattern T/P/F as a finite set in the
# node/phase torus, scaled by T so every coordinate is an integer mod T:
#   plane p, slot s  ->  [p*S, s*P + p*F] mod T.
# For every 1 <= P, S <= 9 and 0 <= F < 2P it checks: the T satellites are distinct; the set is a
# subgroup of (Z/T)^2 (closed under addition) generated by g = [S, F] and h = [0, P]; F and F mod P
# give the same set; and the P phasings F = 0..P-1 give P distinct patterns. Each line prints
# `<name>: 0` (the number of counterexamples).
# Run: timeout 120 gap -q -A --quitonbreak derivations/walker_phasing.g
pattern := function(P, S, F)
  local T;
  T := P*S;
  return Set(Cartesian([0..P-1], [0..S-1]), ps -> [ps[1]*S mod T, (ps[2]*P + ps[1]*F) mod T]);
end;
closure := function(gens, T)
  local set, frontier, x, g, y;
  set := [[0, 0]]; frontier := [[0, 0]];
  while frontier <> [] do
    x := Remove(frontier);
    for g in gens do
      y := [(x[1] + g[1]) mod T, (x[2] + g[2]) mod T];
      if not y in set then AddSet(set, y); Add(frontier, y); fi;
    od;
  od;
  return set;
end;
run := function()
  local bad, P, S, F, pat;
bad := rec(count := 0, subgroup := 0, generated := 0, modp := 0, distinct := 0);
for P in [1..9] do for S in [1..9] do
  for F in [0..2*P-1] do
    pat := pattern(P, S, F);
    if Size(pat) <> P*S then bad.count := bad.count + 1; fi;
    if ForAny(pat, a -> ForAny(pat, b -> not [(a[1]+b[1]) mod (P*S), (a[2]+b[2]) mod (P*S)] in pat)) then
      bad.subgroup := bad.subgroup + 1;
    fi;
    if closure([[S, F mod (P*S)], [0, P mod (P*S)]], P*S) <> pat then bad.generated := bad.generated + 1; fi;
    if pat <> pattern(P, S, F mod P) then bad.modp := bad.modp + 1; fi;
  od;
  if Size(Set([0..P-1], F -> pattern(P, S, F))) <> P then bad.distinct := bad.distinct + 1; fi;
od; od;
Print("walker_pattern_has_T_distinct_satellites: ", bad.count, "\n");
Print("walker_pattern_is_a_subgroup_of_the_torus: ", bad.subgroup, "\n");
Print("walker_pattern_is_generated_by_the_walker_rotation: ", bad.generated, "\n");
Print("walker_phasing_is_taken_mod_P: ", bad.modp, "\n");
Print("walker_has_P_distinct_phasings: ", bad.distinct, "\n");
end;
run();
QUIT;
