\\ Second engine for derivations/cio_rotation.mac: the GCRS -> CIRS matrices of
\\ spacelab-frames/src/cio.rs rebuilt from the rotation product R3(-(E + s)) R2(d) R3(E),
\\ E = atan2(Y, X), d = atan(sqrt(r2/(1 - r2))), at 60 digits, and compared with the closed-form
\\ matrices Maxima printed at 40 digits.
\\
\\ Run: timeout 300 gp -q -f derivations/cio_rotation.gp </dev/null

default(realprecision, 60);
R2(t) = [cos(t), 0, -sin(t); 0, 1, 0; sin(t), 0, cos(t)];
R3(t) = [cos(t), sin(t), 0; -sin(t), cos(t), 0; 0, 0, 1];
product(x, y, s) = {
  my(r2 = x^2 + y^2, e = arg(x + I * y), d = atan(sqrt(r2 / (1 - r2))));
  R3(-(e + s)) * R2(d) * R3(e);
}
{cases = [[3267445786254547 * 2^-62, 83886073 * 2^-41, -3 * 2^-28],
         [-5170398013726189 * 2^-63, 5926573826723 * 2^-57, 7 * 2^-30],
         [4194303 * 2^-34, -8191 * 2^-38, 2^-26],
         [3 * 2^-4, -2^-3, 2^-10]];}
{maxima = [[9.999997490036662075662940902308294757828e-1, -2.337968720730797555589071507533160256693e-9, -7.085143644134829655102491968485704371208e-4; -2.468970769826814621173186740365476844864e-8, 9.999999992724043570145490821597065699424e-1, -3.81469615547534819656589023648159948284e-5; 7.085143639871574038763268887919366534334e-4, 3.814696947301854379475116729736328125e-5, 9.999997482760706894809177225498985003667e-1],
           [9.999998428774432826359728349371787270468e-1, 5.007262662632350061497212617046828718233e-9, 5.605756761777641967510716118577180160685e-4; 1.804577767741396627773361421878739570767e-8, 9.999999991544137687001629531308148198092e-1, -4.112386334276688596877642026386882934078e-5; -5.605756759096671088329899568236669438193e-4, 4.112386699730435912769621609186287969351e-5, 9.999998420318570938368575926194542511132e-1],
           [9.999999701976912679923998188120656811557e-1, -1.489752365994281962426863629701125739883e-8, -2.44140566792783094427286361972940378166e-4; 1.490479828366348044770445477108443349681e-8, 9.999999999999994450510981504628280659289e-1, 2.97950464309484875039011620351273689558e-8; 2.441405667923390865325927734375e-4, -2.979868440888822078704833984375e-8, 9.999999701976909350880995855852266371393e-1],
           [9.821808010302709914592395778520933726139e-1, 1.090258574362622238584617323041067803428e-2, -1.876219808861373896285575893241191737738e-1; 1.283059186223401473229082212068335630442e-2, 9.920968368179100681974465949815133559238e-1, 1.248168349557137906297511047122136737082e-1; 1.875e-1, -1.25e-1, 9.742785792574934776091885670970532064053e-1]];}
{
  my(off = 0, worst = 0., cip = 0);
  for (k = 1, #cases,
    my(c = cases[k], m = product(c[1], c[2], c[3]));
    for (i = 1, 3, for (j = 1, 3,
      my(gap = abs(m[i, j] - maxima[k][i, j]));
      if (gap > worst, worst = gap);
      if (gap > 1e-35, off++)));
    my(z = [c[1], c[2], sqrt(1 - c[1]^2 - c[2]^2)]);
    for (j = 1, 3, if (abs(m[3, j] - z[j]) > 1e-55, cip++)));
  printf("%d of 36 entries off by more than 1e-35 from Maxima; largest gap %.4g\n", off, worst);
  printf("CIP rows unlike (X, Y, sqrt(1 - X^2 - Y^2)) beyond 1e-55: %d\n", cip);
}
