/* The CIO-based rotations of spacelab-frames/src/cio.rs, from their defining products.
 *
 * Mat3::rot1/rot2/rot3 are the IERS frame rotations R1, R2, R3 (passive). The code builds
 *     GCRS -> CIRS:  R3(-(E + s)) R2(d) R3(E),   E = atan2(Y, X),  d = atan(sqrt(r2/(1 - r2))),
 *                    r2 = X^2 + Y^2,
 *     TIRS -> ITRS:  R1(-yp) R2(-xp) R3(s'),
 * and the angular velocity omega_rate Q^T z^ in the GCRS.
 *
 * Shown here, each line printing `<name>: 0`:
 *   1. with X = sin d cos E, Y = sin d sin E and a = 1/(1 + cos d), the product is the transpose of
 *      IERS Conventions 2010 Eq. 5.10's closed form,
 *          Q(t) = [[1 - a X^2, -a X Y, X], [-a X Y, 1 - a Y^2, Y], [-X, -Y, 1 - a (X^2 + Y^2)]] R3(s),
 *      i.e. R3(-(E+s)) R2(d) R3(E) = R3(-s) [..]^T, and equals Q(t)^T = R3(-E) R2(-d) R3(E) R3(s)
 *      transposed (G1);
 *   2. the code's d and E give back exactly that X and Y: sin d = r, cos d = sqrt(1 - r^2) for
 *      0 <= r < 1 (G1);
 *   3. the CIP is the CIRS z-axis: the last row of the GCRS -> CIRS matrix is (X, Y, sqrt(1 - X^2 - Y^2)),
 *      so the spin vector (0, 0, w) in the CIRS is w (X, Y, Z) in the GCRS (G1);
 *   4. R1(-yp) R2(-xp) R3(s') is the transpose of the IERS polar-motion matrix
 *      W = R3(-s') R2(xp) R1(yp) (G1);
 *   5. reference matrices: the closed form at 40 digits at three (X, Y, s) of present-day size and one
 *      with a large pole offset, every input a double. `the_cio_rotation_is_the_iers_closed_form`
 *      asserts them; derivations/cio_rotation.gp builds the same matrices from the rotation product.
 *
 * Run: timeout 300 maxima --very-quiet -Q -b derivations/cio_rotation.mac </dev/null
 */

zero(name, expr) := block([d : expr],
  printf(true, "~a: ~a~%", name, d),
  if d # 0 then error("identity does not reduce to zero:", name))$
sumsq(m) := block([t : 0], for i : 1 thru 3 do for j : 1 thru 3 do t : t + m[i, j]^2, t)$

R1(t) := matrix([1, 0, 0], [0, cos(t), sin(t)], [0, -sin(t), cos(t)])$
R2(t) := matrix([cos(t), 0, -sin(t)], [0, 1, 0], [sin(t), 0, cos(t)])$
R3(t) := matrix([cos(t), sin(t), 0], [-sin(t), cos(t), 0], [0, 0, 1])$

/* ---- 1. the product is the closed form ------------------------------------------------------ */

X : sin(d)*cos(E)$ Y : sin(d)*sin(E)$ a : 1/(1 + cos(d))$
closed : matrix([1 - a*X^2, -a*X*Y, X], [-a*X*Y, 1 - a*Y^2, Y], [-X, -Y, 1 - a*(X^2 + Y^2)])$
code : R3(-(E + s)) . R2(d) . R3(E)$
simp(e) := trigsimp(trigreduce(trigsimp(e)))$
zero("cio_product_is_the_closed_form_transposed", simp(sumsq(code - R3(-s) . transpose(closed))))$
zero("cio_product_is_q_transposed",
  simp(sumsq(code - transpose(R3(-E) . R2(-d) . R3(E) . R3(s)))))$
zero("closed_form_q_is_the_iers_product", simp(sumsq(closed . R3(s) - R3(-E) . R2(-d) . R3(E) . R3(s))))$

/* ---- 2. d and E from X and Y ------------------------------------------------------------------ */

assume(r > 0, r < 1)$
dcode : atan(sqrt(r^2/(1 - r^2)))$
zero("sin_d_is_r", radcan(sin(dcode) - r))$
zero("cos_d_is_sqrt_one_minus_r2", radcan(cos(dcode) - sqrt(1 - r^2)))$
forget(r > 0, r < 1)$

/* ---- 3. the CIP is the CIRS z-axis ------------------------------------------------------------ */

zero("cip_row_is_x_y_z", simp((row(code, 3) - matrix([X, Y, cos(d)])) . transpose(row(code, 3) - matrix([X, Y, cos(d)]))))$
zero("gcrs_spin_is_the_cip",
  block([v : transpose(code) . matrix([0], [0], [w]) - w*matrix([X], [Y], [cos(d)])], simp(transpose(v) . v)))$

/* ---- 4. polar motion ------------------------------------------------------------------------- */

W : R3(-sp) . R2(xp) . R1(yp)$
zero("tirs_to_itrs_is_w_transposed", simp(sumsq(R1(-yp) . R2(-xp) . R3(sp) - transpose(W))))$

/* ---- 5. reference matrices ------------------------------------------------------------------- */

fpprec : 40$
closed_xys(x, y, sv) := block([c : sqrt(1 - x^2 - y^2), aa],
  aa : 1/(1 + c),
  R3(-sv) . transpose(matrix([1 - aa*x^2, -aa*x*y, x], [-aa*x*y, 1 - aa*y^2, y], [-x, -y, 1 - aa*(x^2 + y^2)])))$
/* (X, Y, s) as doubles: m 2^e. */
cases : [[3267445786254547*2^-62, 83886073*2^-41, -3*2^-28],
         [-5170398013726189*2^-63, 5926573826723*2^-57, 7*2^-30],
         [ 4194303*2^-34, -8191*2^-38, 2^-26],
         [ 3*2^-4, -2^-3, 2^-10]]$
for c in cases do block([m : bfloat(closed_xys(c[1], c[2], c[3]))],
  printf(true, "xys ~a ~a ~a~%", bfloat(c[1]), bfloat(c[2]), bfloat(c[3])),
  for i : 1 thru 3 do printf(true, "  ~a ~a ~a~%", m[i, 1], m[i, 2], m[i, 3]))$
