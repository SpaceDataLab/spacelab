/* IAS15 (Everhart 1985; Rein & Spiegel 2015) — the eight Gauss-Radau substep spacings, derived as
 * polynomial roots, and Everhart's c- and d-conversion matrices, derived from those nodes.
 *
 * IAS15 is a 15th-order implicit Runge-Kutta of Gauss-Radau type: eight substep nodes h[0..7] on
 * [0,1] with h[0]=0 (the LEFT Radau family — the left endpoint is a node, the right is not, h[7]<1).
 * The seven nonzero nodes are the roots of the Radau-left polynomial
 *
 *     d^7/dx^7 [ x^8 (x-1)^7 ]        (degree 8; one root is x=0, the other seven are h[1..7]).
 *
 * The acceleration on a step is fitted by a 7th-degree polynomial in the substep parameter, written
 * in the Newton divided-difference basis with coefficients g[0..6], then converted to the power
 * basis b[0..6] by the constant lower-triangular matrix c (Everhart Eq. 7). This script derives the
 * nodes and the c-matrix from first principles and reads the Rust constants back against them.
 *
 *   maxima --very-quiet -b ias15_nodes.mac
 */

fpprec : 40$

/* --- Nodes ---------------------------------------------------------------------------------- */
P : expand(diff(x^8 * (x-1)^7, x, 7))$
rts : bfallroots(P = 0)$
h : sort(map(lambda([e], realpart(rhs(e))), rts))$
print("node count (=8?):", length(h))$
for i:1 thru 8 do print("h[", i-1, "] =", h[i]);
/* sanity: node 0 is exactly 0, node 7 is < 1 (Radau-left) */
print("h[0] (=0?):", h[1], "   h[7] (<1?):", h[8]);

/* --- Everhart c-matrix: b = c . g -----------------------------------------------------------
 * The Newton form of the acceleration polynomial in the running node parameter,
 *   A(t) = g0 + g1 (t-h0) + g2 (t-h0)(t-h1) + ... + g6 (t-h0)...(t-h5),
 * expanded into the power basis A(t) = b0 + b1 t + ... + b6 t^6 (h0 = 0). The coefficient of t^k in
 * the j-th Newton product is c[j][k]; so b_k = sum_j c[j][k] g_j. Everhart tabulates these; here we
 * expand the products symbolically and read them off, exactly. */
newton(j) := prod(t - h[m+1], m, 0, j-1)$   /* j-th Newton product, j = 0..6 (empty prod = 1) */
C : genmatrix(lambda([jj, kk], coeff(expand(newton(jj-1)), t, kk-1)), 8, 8)$
print("--- c matrix (b_k = sum_j c[j][k] g_j), lower-triangular, unit diagonal ---");
for j:1 thru 8 do for k:1 thru j do print("c[", j-1, "][", k-1, "] =", bfloat(C[j][k]));

/* --- d-matrix: the inverse conversion g = d . b, used to rescale the b-coefficients when the step
 * size changes between steps (Everhart's warm start). d = c^{-1}, also lower-triangular. --------- */
D : invert(C)$
print("c.d - I largest entry (=0?):", bfloat(lmax(map(abs, flatten(args(C . D - ident(8)))))));
print("--- d matrix (g_k = sum_j d[j][k] b_j) ---");
for j:1 thru 8 do for k:1 thru j do print("d[", j-1, "][", k-1, "] =", bfloat(D[j][k]));

/* --- The Rust tables (plans/17 Ф17.D) -------------------------------------------------------
 * ias15.rs holds the nodes H and the strict lower triangles of c and d, row by row in REBOUND's
 * packing: CC[k(k-1)/2 + j] for k = 1..6, j < k. The Newton products here carry the factor
 * t - h0 = t, so that entry is C[k+2][j+2] of this matrix, and likewise for d. Its literals are
 * these values at 60 digits rounded to 30 (REBOUND's arrays agree to ~1e-33): each must be its
 * derived value rounded at its last digit, and parse to the double that value rounds to. */
load("rust_literals.mac")$
src : "../crates/spacelab-propagation/src/ias15.rs"$
packed(M) := flatten(makelist(makelist(M[k+2][j+2], j, 0, k-1), k, 1, 6))$
/* For the Arb pass (plans/17 Ф28.A): each nonzero node is the root of P/x in a 2^-120 dyadic bracket
 * around its bigfloat, which arb_balls.c certifies unique; c and d are polynomials in the nodes, so
 * they go over as polynomials in those roots. */
Q : ratsimp(P / x)$
print("P/x leaves no remainder, Q(0) /= 0 (=true?):", is(ratsimp(Q*x - P) = 0) and is(subst(x = 0, Q) # 0));
hsym : cons(0, makelist(concat('ias15_h, i), i, 1, 7))$
for i:1 thru 7 do block([br : arb_bracket(h[i + 1], 120)],
  arb_root(hsym[i + 1], Q, x, br[1], br[2], h[i + 1]))$
Csym : genmatrix(lambda([jj, kk], coeff(expand(prod(t - hsym[m+1], m, 0, jj-2)), t, kk-1)), 8, 8)$
Dsym : map(expand, invert(Csym))$
print("c and d in the roots - c and d, worst (~0?):",
      lmax(map(lambda([a, b], bfloat(abs(subst(arb_roots, a) - b))),
               flatten(append(args(Csym), args(Dsym))), flatten(append(args(C), args(D))))));
print("rust H is the nearest doubles to the nodes, rounded at its last digit:", certified_doubles("H", rust_table(src, "H"), hsym)
  and certified("H", rust_table(src, "H"), hsym));
print("rust CC is the nearest doubles to c, rounded at its last digit:", certified_doubles("CC", rust_table(src, "CC"), packed(Csym))
  and certified("CC", rust_table(src, "CC"), packed(Csym)));
print("rust DD is the nearest doubles to d, rounded at its last digit:", certified_doubles("DD", rust_table(src, "DD"), packed(Dsym))
  and certified("DD", rust_table(src, "DD"), packed(Dsym)));
