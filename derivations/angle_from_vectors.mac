/* The angle sites of plans/18 Ф28.N (C3 row 15): an angle the code read from a dot product by acos
   or asin, and now reads from the dot and cross products by atan2.

   Printed `<name>: 0`:
     1. Lagrange's identity |a x b|^2 + (a.b)^2 = |a|^2 |b|^2: the pair (|a x b|, a.b) is
        |a||b| (sin t, cos t), t in [0, pi] the angle between a and b (G1);
     2. atan2 inverts that pair at every scale r > 0, inside (0, pi) and at both ends (G1);
     3. the scattering pair: |(-s) x v| = |s x v| and (-s).v = -(s.v), so the angle between the
        incident ray -s and the scattered ray v is atan2(|s x v|, -(s.v)) (G1);
     4. acos turns an absolute error d of a cosine next to 1 into sqrt(2 d) of angle, while the
        gradient of atan2(y, x) has length 1/r: an absolute error d of either argument moves the
        angle by at most d/r, wherever the angle is (G3);
     5. a row of derivations/angle_from_vectors.gp's angle table, recomputed here at 100 digits on
        the same doubles: within 1e-24 of the 25-digit literal the tests carry;
     6. the elevation of d above the plane normal to a unit z: atan2(d.z, |d x z|) and the
        asin(d.z/|d|) it replaces are both e on d = rho (cos e cos l, cos e sin l, sin e), and asin,
        like acos, turns an absolute error d of a sine next to 1 into sqrt(2 d) of angle (G1, G3);
     7. a row of the elevation table, recomputed as in 5;
     8. the declination of a unit direction (cos e cos l, cos e sin l, sin e): atan2(z, hypot(x, y))
        and asin(z) are both e (G1), and a row of the declination table recomputed as in 5.

   Run: timeout 300 maxima --very-quiet --suppress-input-echo -Q -b derivations/angle_from_vectors.mac </dev/null */

display2d : false$
zero(name, expr) := block([d : expr],
  printf(true, "~a: ~a~%", name, d),
  if d # 0 then error("identity does not reduce to zero:", name))$
cross(u, v) := [u[2]*v[3] - u[3]*v[2], u[3]*v[1] - u[1]*v[3], u[1]*v[2] - u[2]*v[1]]$

block([a : [a1, a2, a3], b : [b1, b2, b3], c],
  c : cross(a, b),
  zero("lagrange_identity", expand(c . c + (a . b)^2 - (a . a)*(b . b))))$
block([],
  assume(r > 0, t > 0, t < %pi),
  zero("atan2_inverts_the_pair_inside", atan2(r*sin(t), r*cos(t)) - t),
  zero("atan2_at_zero", atan2(0, r)),
  zero("atan2_at_pi", atan2(0, -r) - %pi),
  forget(r > 0, t > 0, t < %pi))$
block([s : [s1, s2, s3], v : [v1, v2, v3]],
  zero("scattering_cross", expand(cross(-s, v) . cross(-s, v) - cross(s, v) . cross(s, v))),
  zero("scattering_dot", expand((-s) . v + s . v)))$
zero("acos_loses_sqrt_2d_next_to_one", limit(acos(1 - d)/sqrt(2*d), d, 0, plus) - 1)$
zero("atan2_gradient_is_one_over_r",
  ratsimp(diff(atan2(y, x), y)^2 + diff(atan2(y, x), x)^2 - 1/(x^2 + y^2)))$

fpprec : 100$
f64(x) := if x = 0 then 0 else block([e : floor(log(abs(x)) / log(2)), m],
  if 2^e > abs(x) then e : e - 1, if 2^(e + 1) <= abs(x) then e : e + 1,
  m : round(x * 2^(52 - e)), m * 2^(e - 52))$
near(name, x, want) := zero(name, if abs(bfloat(x) / want - 1) < 1b-24 then 0 else 1)$
u : [2, -3, 6]/7$
w : [3, 6, 2]/7$
a : map(lambda([x], f64(bfloat(x))), u)$
block([t : bfloat(10^-12), b, c],
  b : map(f64, bfloat(-cos(t)*u + sin(t)*w)),
  c : cross(a, b),
  near("angle_row_at_pi_minus_1e-12", atan2(sqrt(c . c), a . b), 3.141592653588793260584364b0))$
block([d, z : [0, 0, 1], c],
  assume(rho > 0, e > -%pi/2, e < %pi/2),
  d : rho*[cos(e)*cos(l), cos(e)*sin(l), sin(e)],
  c : cross(d, z),
  zero("elevation_by_atan2", atan2(d . z, trigsimp(sqrt(c . c))) - e),
  zero("elevation_by_asin", asin((d . z)/trigsimp(sqrt(d . d))) - e),
  forget(rho > 0, e > -%pi/2, e < %pi/2))$
zero("asin_loses_sqrt_2d_next_to_one", limit((%pi/2 - asin(1 - d))/sqrt(2*d), d, 0, plus) - 1)$
block([t : bfloat(10^-12), b, c],
  b : map(f64, bfloat(cos(t)*u + sin(t)*w)),
  c : cross(a, b),
  near("elevation_row_at_pi_over_2_minus_1e-12", atan2(a . b, sqrt(c . c)),
    1.570796326793896633422752b0))$
block([v : [cos(e)*cos(l), cos(e)*sin(l), sin(e)]],
  assume(e > -%pi/2, e < %pi/2),
  zero("declination_by_atan2", atan2(v[3], trigsimp(sqrt(v[1]^2 + v[2]^2))) - e),
  zero("declination_by_asin", asin(v[3]) - e),
  forget(e > -%pi/2, e < %pi/2))$
block([t : bfloat(10^-12), d],
  d : map(f64, bfloat([3/5*sin(t), 4/5*sin(t), -cos(t)])),
  near("declination_row_at_minus_pi_over_2_plus_1e-12", atan2(d[3], sqrt(d[1]^2 + d[2]^2)),
    -1.570796326793896619231322b0))$
