/* The single named constants of the library, each derived or held against its source and read back
   from the Rust text (plans/17 Ф17.D).

   The tables have their derivations; these are the constants written once or twice across the
   crates: the WGS 84 ellipsoid in seven of them, two powers of two, the conjunction width, the
   GPU kernels' SGP4 constants, SGP4's resonance window and the Mars GM of the entry model. Each
   must be its source's value rounded to the digits it shows (`transcribed`), or the double nearest
   it (`same_doubles`) where the text carries a double's 17 digits.

   timeout 300 maxima --very-quiet -Q -b constants_readback.mac                                     */

load("rust_literals.mac")$
must(ok, what) := if ok then print(what) else error("FAILED:", what)$
fpprec : 60$
long_literal(t) := rust_is_number(t) and rust_significant(t) > 6$
src(crate, file) := concat("../crates/", crate, "/src/", file)$

/* ---- (1) the WGS 84 ellipsoid -------------------------------------------------------------------
   The defining a = 6378137 m and 1/f = 298.257223563 and GM = 3.986004418e14 m³/s² (NIMA TR8350.2,
   Table 3.1), the polar radius b = a(1 − f) and the ratio a²/b² = 1/(1 − e²) they fix. Every copy:
   spacelab-earth's, the coverage detectors', the image-quality scale, the lifetime drivers', the
   link budget's, the sensor cone's, the cull body's, the geolocation ellipsoid's in km and the
   entry model's Earth. */

a : 6378137$
inverse_f : 298257223563 / 10^9$
f : 1 / inverse_f$
b : a * (1 - f)$
gm : 3986004418 * 10^5$
print("b =", bfloat(b), "  a^2/b^2 =", bfloat(a^2 / b^2))$

wgs84_ok : [
  transcribed([rust_scalar(src("spacelab-earth", "wgs84.rs"), "EQUATORIAL_RADIUS")], [a]),
  same_rationals([rust_scalar(src("spacelab-earth", "wgs84.rs"), "FLATTENING")], [f]),
  transcribed([rust_scalar(src("spacelab-coverage", "detectors.rs"), "EARTH_EQUATORIAL_RADIUS")], [a]),
  transcribed([rust_scalar(src("spacelab-earthvision", "image_quality.rs"), "A")], [a]),
  same_rationals([rust_scalar(src("spacelab-earthvision", "image_quality.rs"), "F")], [f]),
  transcribed([rust_scalar(src("spacelab-propagation", "lifetime_drivers.rs"), "WGS84_A")], [a]),
  transcribed([rust_scalar(src("spacelab-propagation", "lifetime_drivers.rs"), "WGS84_INVERSE_F")],
              [inverse_f]),
  transcribed([rust_scalar(src("spacelab-sensors", "comms.rs"), "EARTH_RADIUS")], [a]),
  transcribed(sublist(rust_literals_between(src("spacelab-sensors", "cone.rs"),
                                            "const INVERSE_ONE_MINUS_E2", "};"), long_literal),
              [inverse_f]),
  transcribed(sublist(rust_literals_between(src("spacelab-sensors", "cull.rs"),
                                            "pub const WGS84: Self = Self {", "};"), long_literal),
              [b]),
  same_doubles([rust_scalar(src("spacelab-sensors", "ellipsoid_grid.rs"), "WGS84_GAMMA")],
               [a^2 / b^2]),
  transcribed(sublist(rust_literals_between(src("spacelab-sensors", "geoloc.rs"),
                                            "pub const WGS84: Ellipsoid = Ellipsoid {", "};"),
                      long_literal),
              [a / 1000, b / 1000]),
  transcribed(sublist(rust_literals_between(src("spacelab-astro", "edl.rs"),
                                            "pub const EARTH: Self = Self {", "};"), long_literal),
              [gm, a])]$
print("WGS 84 copies:", wgs84_ok)$
must(every(identity, wgs84_ok), "(1) holds: every WGS 84 copy is the defining value or its consequence")$

/* ---- (2) two powers of two ------------------------------------------------------------------------
   Hipparchus's `Precision.EPSILON`, 2⁻⁵³, and the 2⁵³ that maps 53 random bits onto [0, 1). */

must(same_doubles([rust_scalar(src("spacelab-propagation", "spacecraft.rs"), "HIPPARCHUS_EPSILON")],
                  [2^-53])
     and same_rationals(sublist(rust_literals_between(src("spacelab-earthvision", "radiative_transfer.rs"),
                                                      "pub(crate) fn unit(&mut self)", "}"),
                                long_literal),
                        [2^53]),
     "(2) holds: the guard is 2^-53 and the unit draw divides by 2^53 exactly")$

/* ---- (3) the conjunction duration in widths -------------------------------------------------------
   2√2 erfc⁻¹(γ) at γ = 10⁻⁶. The root is taken of erfc itself: 1 − erf(x) at x ≈ 3.46 cancels six
   digits, and at 40 digits of working precision that cancellation reaches the 40-digit literal. */

x_tail : bf_find_root(bfloat(erfc(y)) - 1b-6, y, 3.4b0, 3.5b0)$
print("erfc^-1(1e-6) =", x_tail, "  residual", bfloat(erfc(x_tail)) - 1b-6)$
must(transcribed([rust_scalar(src("spacelab-estimation", "conjunction_domain.rs"), "DURATION_WIDTHS")],
                 [2 * sqrt(2) * x_tail]),
     "(3) holds: DURATION_WIDTHS is 2 sqrt(2) erfc^-1(1e-6) to its 40 digits")$

/* ---- (4) the GPU kernels' SGP4 constants ---------------------------------------------------------
   WGS-72, the geopotential of Vallado et al. (2006), AIAA 2006-6753, and of the element sets:
   μ = 398600.8 km³/s², Rₑ = 6378.135 km, J2 = 0.001082616, and xke = 60/√(Rₑ³/μ) in Earth
   radii^(3/2) per minute; and 2π, which each of the two kernels declares. */

gpu : src("spacelab-gpu", "lib.rs")$
re72 : 6378135 / 1000$
must(transcribed([rust_scalar(gpu, "KE")], [60 / sqrt(re72^3 / (3986008 / 10))])
     and same_rationals([rust_scalar(gpu, "AE")], [re72])
     and same_rationals([rust_scalar(gpu, "J2")], [1082616 / 10^9])
     and transcribed(rust_scalars(gpu, "TAU"), [2 * %pi, 2 * %pi]),
     "(4) holds: the kernels' xke follows from WGS-72's mu and radius, AE and J2 are WGS-72's, TAU is 2 pi")$

/* ---- (5) SGP4's 24-hour resonance window ----------------------------------------------------------
   0.2° and 0.3° per minute, in rad/min, cut (not rounded) at the tenth decimal: the edges as the
   reference code writes them (Hoots & Roehrich 1980; Vallado et al. 2006, `dsinit`). The upper one
   rounds to …878; a model that rounded would move the edge by 9e-11 rad/min. */

cut10(x) := floor(bfloat(x) * 10^10) / 10^10$
sgp4 : src("spacelab-sgp4", "satellite.rs")$
must(same_rationals([rust_scalar(sgp4, "SYNCHRONOUS_LO"), rust_scalar(sgp4, "SYNCHRONOUS_HI")],
                    [cut10(%pi / 900), cut10(%pi / 600)]),
     "(5) holds: the resonance window is 0.2 and 0.3 deg/min cut at ten decimals")$

/* ---- (6) the Mars GM of the entry model -----------------------------------------------------------
   GM of the Mars system from the DE440 header (Park et al. 2021), 42828.375816 km³/s². */

must(transcribed(sublist(rust_literals_between(src("spacelab-astro", "edl.rs"),
                                               "pub const MARS: Self = Self {", "};"), long_literal),
                 [42828375816 / 10^6 * 10^9]),
     "(6) holds: the entry model's Mars GM is DE440's")$

print("DONE")$
