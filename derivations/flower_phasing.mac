/* Single-track Flower Constellation (`crates/spacelab-constellation/src/flower.rs`; Mortari,
   Wilkins & Bruccoleri 2004). The repeat condition, the semi-major axis, and the claim that
   satellite k is the reference satellite time-shifted by k T_rep/Ns along the one repeating track.
   Every identity prints `<name>: 0`.
   Run: timeout 120 maxima --very-quiet -Q -b derivations/flower_phasing.mac </dev/null */

chk(name, e) := printf(true, "~a: ~a~%", name, e)$
assume(w > 0, mu > 0, Np > 0, Nd > 0, Ns > 0)$
n: Np*w/Nd$
Trep: Nd*2*%pi/w$
a: (mu/n^2)^(1/3)$

/* Np orbital periods take exactly Nd turns of the rotating frame. */
chk("np_orbits_span_nd_frame_turns", ratsimp(Np*2*%pi/n - Trep))$
/* Kepler's third law at the shipped a = (mu/n^2)^(1/3). */
chk("kepler_third_law", radcan(n^2*a^3 - mu))$

/* The shipped phasing and the time shift tau_k = k T_rep/Ns. */
Wk: W0 - 2*%pi*k*Nd/Ns$
Mk: M0 + 2*%pi*k*Np/Ns$
tau: k*Trep/Ns$
/* A time shift tau moves the node relative to the rotating frame by -w tau, the mean anomaly by n tau. */
chk("node_is_the_frame_shift", ratsimp(Wk - (W0 - w*tau)))$
chk("mean_anomaly_is_the_orbital_shift", ratsimp(Mk - (M0 + n*tau)))$
/* Hence at every t satellite k's frame-relative node and mean anomaly are the reference's at
   t + tau: the same rotating-frame position, i.e. one space track. */
chk("satellite_k_is_the_reference_at_t_plus_tau",
    ratsimp([Wk - w*t, Mk + n*t] - [W0 - w*(t + tau), M0 + n*(t + tau)]) . [1, 1])$
/* Mortari's compatibility relation holds exactly, not only mod 2 pi. */
chk("compatibility_relation", ratsimp(Np*(Wk - W0) + Nd*(Mk - M0)))$
