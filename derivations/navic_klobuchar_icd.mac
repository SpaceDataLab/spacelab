/* NavIC's broadcast Klobuchar set, read off the interface document: what it is referred to, the
   constants of its user algorithm, and the scale its coefficients are sent on -- against
   spacelab-gnss's `klobuchar_iono_delay` and the fixture test that holds a real NavIC record.

   The document is ISRO-IRNSS-ICD-SPS-1.1, "IRNSS Signal-in-Space ICD for SPS", version 1.1, August
   2017, which `tools/fetch-specs.sh` pins as `isro-navic-sps-icd.321573a6.pdf`. Its front matter
   forbids copying it, so nothing of it is in the repository: `derivations/verify.sh` checks the
   PDF's SHA-256, writes its text (`pdftotext -layout`) beside it in the git-ignored `data/specs`,
   and skips this file when either is absent. What this file holds are search keys and the numbers
   they must find. Checks:
     (1) Table 17 (message type 11) sends the eight coefficients as 8-bit two's complement numbers
         scaled by 2^-30, 2^-27, 2^-24, 2^-24 s/sc^n and 2^11, 2^14, 2^16, 2^16 s/sc^n, n = 0..3:
         IS-GPS-200's scale and units for its own alpha/beta (Table 20-X), so the GPS algorithm reads
         them unchanged; and these are the exponents `tests/rinex4_nav.rs` holds a real NavIC record
         to (`NAVIC_TABLE_17_EXPONENTS`);
     (2) the carriers of §3.1 are L5 at 1176.45 MHz and S at 2492.028 MHz, 115 and 243.6 times
         10.23 MHz, which `combinations.rs` builds as L5_HZ and NAVIC_S_HZ;
     (3) §6.2.5.2 gives the coefficients to single-frequency L5 users;
     (4) Appendix H refers the delay it computes to L5, on the one line of the appendix that says
         what it is referred to;
     (5) every constant Appendix H prints is a literal of `klobuchar_at_reference` (86 400 s is
         `wrap_day`'s), and every literal of that function is a constant Appendix H prints or a
         polynomial index -- so the shipped chain has the document's numbers, both ways round.
   `klobuchar_reference.mac` holds the chain itself against Appendix H and IS-GPS-200.

   timeout 300 maxima --very-quiet -Q -b navic_klobuchar_icd.mac                                     */

load("rust_literals.mac")$
must(ok, what) := if ok then print(what) else error("FAILED:", what)$
if not stringp(icd_text) then icd_text : "../data/specs/isro-navic-sps-icd.321573a6.txt"$
models : "../crates/spacelab-gnss/src/models.rs"$
nav_test : "../crates/spacelab-gnss/tests/rinex4_nav.rs"$

icd_lines : block([s : openr(icd_text), line, out : []],
  while (line : readline(s)) # false do out : cons(line, out),
  close(s), reverse(out))$
words(line) := split(line, " ", true)$
has(line, key) := is(ssearch(key, line) # false)$
/* A heading in the body: a line it opens, not its entry in the table of contents (whose dots run to
   a page number on that line or the next) nor a sentence that names it. */
toc(i) := has(icd_lines[i], "....") or (i < length(icd_lines) and has(icd_lines[i + 1], "...."))$
heading(key) := block([hits : sublist(makelist(i, i, length(icd_lines)),
                                      lambda([i], is(ssearch(key, icd_lines[i]) = 1) and not toc(i)))],
  if length(hits) # 1 then error("heading: not exactly one", key, hits), hits[1])$
nonblank(l) := is(length(words(l)) > 0)$

/* ---- (1) Table 17's scale --------------------------------------------------------------------- */
t17 : block([at : sublist_indices(icd_lines, lambda([l], has(l, "IONOSPHERE COEFFICIENTS")))],
  if length(at) # 1 then error("Table 17: the ionosphere block is not found once", at), at[1])$
/* Row `Alpha n` / `Beta n`: [name, alpha, size, unit] are its last tokens; a scale printed as a bare
   2 has its exponent raised onto the line above it, which holds that token alone. */
t17_row(name) := block([i : t17, w, scale, above, ex],
  while not (has(icd_lines[i], name) and length(words(icd_lines[i])) >= 5) do (
    i : i + 1, if i > t17 + 40 then error("Table 17: no row", name)),
  w : words(icd_lines[i]),
  scale : w[length(w) - 2],
  if scale = "2" then (
    above : i - 1, while not nonblank(icd_lines[above]) do above : above - 1,
    if length(words(icd_lines[above])) # 1 then error("Table 17: the exponent of", name, "is not alone above it"),
    ex : parse_string(words(icd_lines[above])[1]))
  else if charat(scale, 1) = "2" then ex : parse_string(substring(scale, 2))
  else error("Table 17: the scale of", name, "is not a power of two:", scale),
  [ex, w[length(w) - 1], w[length(w)]])$
rows : map(t17_row, ["Alpha 0", "Alpha 1", "Alpha 2", "Alpha 3", "Beta 0", "Beta 1", "Beta 2", "Beta 3"])$
printf(true, "Table 17, ionosphere rows (exponent, size, unit): ~a~%", rows)$
/* IS-GPS-200, Table 20-X: the scale factors of its alpha_n and beta_n, 8 bits each, two's complement. */
gps_exponents : [-30, -27, -24, -24, 11, 14, 16, 16]$
units : ["sec", "sec/semi-circle", "sec/(semi-circle)2", "sec/(semi-circle)3"]$
held : map(rust_rational, rust_table(nav_test, "NAVIC_TABLE_17_EXPONENTS"))$
must(is(map(first, rows) = gps_exponents)
     and every(lambda([r], is(r[2] = "8*")), rows)
     and is(map(third, rows) = append(units, units))
     and is(held = gps_exponents),
     "(1) holds: Table 17 scales the eight coefficients by 2^-30, 2^-27, 2^-24, 2^-24, 2^11, 2^14, 2^16, 2^16 in s/sc^n, 8 bits two's complement, as IS-GPS-200 does, and NAVIC_TABLE_17_EXPONENTS is that list")$

/* ---- (2) the carriers -------------------------------------------------------------------------- */
carrier(band, mhz) := some(lambda([l], block([w : words(l)],
  member("SPS", w) and member(band, w) and member(mhz, w) and member("MHz", w))), icd_lines)$
must(carrier("L5", "1176.45") and carrier("S", "2492.028")
     and is(rust_rational("1176.45") = 115*rust_rational("10.23"))
     and is(rust_rational("2492.028") = rust_rational("243.6")*rust_rational("10.23")),
     "(2) holds: §3.1 puts the SPS on L5 at 1176.45 MHz = 115 x 10.23 MHz and on S at 2492.028 MHz = 243.6 x 10.23 MHz")$

/* ---- (3) §6.2.5.2 ------------------------------------------------------------------------------ */
s6252 : heading("6.2.5.2 Ionosphere Correction Coefficients")$
next_text : block([i : s6252 + 1], while not nonblank(icd_lines[i]) do i : i + 1, icd_lines[i])$
must(has(next_text, "single frequency (L5)"),
     "(3) holds: §6.2.5.2 addresses the eight coefficients to single-frequency L5 users")$

/* ---- (4) Appendix H's reference ---------------------------------------------------------------- */
app_h : heading("Appendix H.")$
app_i : heading("Appendix I.")$
span : makelist(icd_lines[i], i, app_h, app_i - 1)$
referred : sublist(span, lambda([l], has(l, "referred")))$
must(is(length(referred) = 1) and member("L5", words(referred[1])) and not member("L1", words(referred[1]))
     and has(referred[1], "S frequency"),
     "(4) holds: Appendix H refers its delay to L5 on the one line that says what it is referred to, and names the S user's scaling there")$

/* ---- (5) Appendix H's constants against the shipped literals ----------------------------------- */
/* [the value, the text Appendix H prints it as]. */
witnesses : [[137/10000, "0.0137"], [11/100, "0.11"], [22/1000, "0.022"], [416/1000, "0.416"],
             [64/1000, "0.064"], [1617/1000, "1.617"], [43200, "4.32 × 104"],
             [50400, "50400"], [72000, "72,000"], [157/100, "1.57"], [5/10^9, "5.0 ∗ 10−9"],
             [1, "1.0"], [16, "16.0"], [53/100, "0.53"], [3, "]3"], [2, "2!"], [24, "4!"],
             [0, "AMP = 0"], [86400, "86400"]]$
missing : sublist(witnesses, lambda([w], not some(lambda([l], has(l, w[2])), span)))$
printf(true, "Appendix H spans lines ~a to ~a; witnesses not found: ~a~%", app_h, app_i - 1, missing)$
icd_values : setify(map(first, witnesses))$
/* The body of `klobuchar_at_reference`, from the line after its signature to its closing brace. */
body : block([s : openr(models), line, state : 0, done : false, out : [], at],
  while not done and (line : readline(s)) # false do (
    if state = 2 and is(line = "}") then done : true
    else if state = 2 then (
      at : ssearch("//", line),
      if at # false then line : substring(line, 1, at),
      line : ssubst("e-", "e#", ssubst(" ", "-", ssubst("e#", "e-", line))),
      for c in ["(", ")", "[", "]", "*", "/", "+", ",", ";", "=", "<"] do line : ssubst(" ", c, line),
      out : append(out, map(rust_rational, sublist(words(line), rust_is_number))))
    else if state = 1 and has(line, ") -> f64 {") then state : 2
    else if state = 0 and has(line, "fn klobuchar_at_reference(") then state : 1),
  close(s),
  if not done then error("klobuchar_at_reference: no closing brace"),
  out)$
code_values : setify(body)$
printf(true, "literals of klobuchar_at_reference: ~a~%", body)$
must(is(missing = [])
     and subsetp(code_values, union(icd_values, {0, 1, 2, 3}))
     and is(setdifference(icd_values, code_values) = {86400}),
     "(5) holds: every constant Appendix H prints is a literal of klobuchar_at_reference (86 400 s is wrap_day's) and every literal there is one of them or a polynomial index")$
print("DONE")$
