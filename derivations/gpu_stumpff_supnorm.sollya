/* The truncation of the f32 Stumpff series in spacelab-gpu's Lambert kernel (`stumpff_c`,
   `stumpff_s` in its WGSL), certified (plans/17 Ф28.B; the window widened by plan 18 Ф28.M).

   Within |z| <= 1 the kernel takes C and S as their Taylor series to z^4, in Horner form,
     C(z) ~ 1/2 + z (-c24 + z (c720 + z (-c40320 + z c3628800))),
     S(z) ~ s6 + z (-s120 + z (s5040 + z (-s362880 + z s39916800))),
   each coefficient the f32 its WGSL constant expression `1.0 / n` (n = k!) folds to; 1/2 is exact.
   Single precision has u = 2^-24 = 6.0e-8, so the series must stay well under that. As in
   kepler_stumpff_supnorm.sollya each sign of z is a function of s in [0, 1], z = s^2 or -s^2, and
   `split` encloses sup |p/f - 1| on each. derivations/gpu_porkchop.mac checks that the exact
   coefficients are the Taylor series; approximation_supnorm.mac evaluates each error at fpprec 120.

   cd derivations && timeout 300 sollya gpu_stumpff_supnorm.sollya                               */

execute("supnorm_lib.sollya");

f = proc(n) { return round(1/fact(n), SG, RN); };
pc = proc(y) { return 1/2 + y * (-f(4) + y * (f(6) + y * (-f(8) + y * f(10)))); };
ps = proc(y) { return f(3) + y * (-f(5) + y * (f(7) + y * (-f(9) + y * f(11)))); };

split("gpu_stumpff_C_pos", x^2 * pc(x^2), 1 - cos(x), 1, 48);
split("gpu_stumpff_C_neg", x^2 * pc(-x^2), cosh(x) - 1, 1, 48);
split("gpu_stumpff_S_pos", x^3 * ps(x^2), x - sin(x), 1, 48);
split("gpu_stumpff_S_neg", x^3 * ps(-x^2), sinh(x) - x, 1, 48);
quit;
