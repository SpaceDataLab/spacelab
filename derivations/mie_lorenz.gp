\\ Second engine for derivations/mie_lorenz.mac: the Lorenz-Mie coefficients a_n, b_n and the
\\ efficiencies (Q_ext, Q_sca, g) of six spheres, from PARI's Bessel functions of half-integer
\\ order and Bohren & Huffman (4.53) -- psi_n(z) = rbj(n, z) = sqrt(pi z/2) J_{n+1/2}(z),
\\ chi_n(x) = rby(n, x) = (-1)^n sqrt(pi x/2) J_{-n-1/2}(x), xi_n = rbh = psi_n - i chi_n (GP's own
\\ `psi` is the digamma function), and derivatives from
\\ J_nu' = (J_{nu-1} - J_{nu+1})/2 -- against Maxima's 40 digits from the closed-form spherical
\\ Bessel functions. Neither engine uses a recurrence or a logarithmic derivative.
default(realprecision, 80);
rbj(n, z) = sqrt(Pi*z/2)*besselj(n + 1/2, z);
drbj(n, z) = sqrt(Pi/(2*z))/2*besselj(n + 1/2, z) \
  + sqrt(Pi*z/2)*(besselj(n - 1/2, z) - besselj(n + 3/2, z))/2;
rby(n, x) = (-1)^n*sqrt(Pi*x/2)*besselj(-n - 1/2, x);
drby(n, x) = (-1)^n*(sqrt(Pi/(2*x))/2*besselj(-n - 1/2, x) \
  + sqrt(Pi*x/2)*(besselj(-n - 3/2, x) - besselj(-n + 1/2, x))/2);
rbh(n, x) = rbj(n, x) - I*rby(n, x);
drbh(n, x) = drbj(n, x) - I*drby(n, x);
an(n, m, x) = (m*rbj(n, m*x)*drbj(n, x) - rbj(n, x)*drbj(n, m*x)) \
  / (m*rbj(n, m*x)*drbh(n, x) - rbh(n, x)*drbj(n, m*x));
bn(n, m, x) = (rbj(n, m*x)*drbj(n, x) - m*rbj(n, x)*drbj(n, m*x)) \
  / (rbj(n, m*x)*drbh(n, x) - m*rbh(n, x)*drbj(n, m*x));
efficiencies(m, x, N) = {
  my(a = vector(N, n, an(n, m, x)), b = vector(N, n, bn(n, m, x)), qe = 0, qs = 0, gq = 0);
  for (n = 1, N,
    qe += (2*n + 1)*real(a[n] + b[n]);
    qs += (2*n + 1)*(norm(a[n]) + norm(b[n]));
    gq += (2*n + 1)/(n*(n + 1))*real(a[n]*conj(b[n]));
    if (n < N, gq += n*(n + 2)/(n + 1)*real(a[n]*conj(a[n + 1]) + b[n]*conj(b[n + 1]))));
  [2/x^2*qe, 2/x^2*qs, (4/x^2*gq)/(2/x^2*qs)];
}
cases = [[1/2, 133/100 + I/100, 6], [1, 3/2 + I/10, 8], [2, 133/100, 10], [1/10, 133/100, 4], \
  [1/100, 3/2 + I/10, 3], [1/10000, 3/2 + I/10, 3]];
\\ Maxima, per case: rows (Re a_n, Im a_n, Re b_n, Im b_n), then (Q_ext, Q_sca, g).
