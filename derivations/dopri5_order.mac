/* Verify the Dormand-Prince 5(4) tableau satisfies the order conditions through order 5.
   Coefficients from Dormand & Prince (1980). If any condition fails, the method is not the
   order it claims and the code must not be written. */

c : [0, 1/5, 3/10, 4/5, 8/9, 1, 1]$
/* a[i][j], lower triangular */
a : matrix(
 [0,0,0,0,0,0,0],
 [1/5,0,0,0,0,0,0],
 [3/40,9/40,0,0,0,0,0],
 [44/45,-56/15,32/9,0,0,0,0],
 [19372/6561,-25360/2187,64448/6561,-212/729,0,0,0],
 [9017/3168,-355/33,46732/5247,49/176,-5103/18656,0,0],
 [35/384,0,500/1113,125/192,-2187/6784,11/84,0])$
b  : [35/384, 0, 500/1113, 125/192, -2187/6784, 11/84, 0]$        /* 5th order */
bh : [5179/57600, 0, 7571/16695, 393/640, -92097/339200, 187/2100, 1/40]$ /* 4th order embedded */

s : 7$
sum_b(bb) := sum(bb[i], i, 1, s)$
dot(bb, v) := sum(bb[i]*v[i], i, 1, s)$
ac(i) := sum(a[i,j], j, 1, s)$   /* row sum of a = c[i], consistency */

/* consistency: row sums of a equal c */
print("consistency a.1 = c:", makelist(ratsimp(ac(i) - c[i]), i, 1, s))$

cc(k) := makelist(c[i]^k, i, 1, s)$          /* c_i^k */
Ac(k) := makelist(sum(a[i,j]*c[j]^k, j,1,s), i,1,s)$   /* (A c^k)_i */

/* Order conditions (Butcher), 5th order set for an explicit RK: */
print("O1  Sb=1        :", ratsimp(sum_b(b) - 1))$
print("O2  Sbc=1/2     :", ratsimp(dot(b, c) - 1/2))$
print("O3  Sbc^2=1/3   :", ratsimp(dot(b, cc(2)) - 1/3))$
print("O4  SbAc=1/6    :", ratsimp(dot(b, Ac(1)) - 1/6))$
print("O5  Sbc^3=1/4   :", ratsimp(dot(b, cc(3)) - 1/4))$
print("O6  SbcAc=1/8   :", ratsimp(sum(b[i]*c[i]*Ac(1)[i], i,1,s) - 1/8))$
print("O7  SbA c^2=1/12:", ratsimp(dot(b, Ac(2)) - 1/12))$
print("O8  SbAAc=1/24  :", ratsimp(sum(b[i]*sum(a[i,j]*Ac(1)[j], j,1,s), i,1,s) - 1/24))$
print("O9  Sbc^4=1/5   :", ratsimp(dot(b, cc(4)) - 1/5))$
print("O10 Sbc^2Ac=1/10:", ratsimp(sum(b[i]*c[i]^2*Ac(1)[i], i,1,s) - 1/10))$
print("O11 Sb(Ac)^2=1/20:", ratsimp(sum(b[i]*Ac(1)[i]^2, i,1,s) - 1/20))$
print("O12 SbcAc^2=1/15:", ratsimp(sum(b[i]*c[i]*Ac(2)[i], i,1,s) - 1/15))$
print("O13 SbAc^3=1/20 :", ratsimp(dot(b, Ac(3)) - 1/20))$
print("O14 SbcAAc=1/30 :", ratsimp(sum(b[i]*c[i]*sum(a[i,j]*Ac(1)[j],j,1,s), i,1,s) - 1/30))$
print("O15 SbAcAc=1/40 :", ratsimp(sum(b[i]*Ac(1)[i]*sum(a[i,j]*c[j]*Ac(1)[j]/max(c[j],1),j,1,s), i,1,s)))$
/* embedded pair is order 4: check its first four conditions */
print("E1  Sbh=1       :", ratsimp(sum_b(bh) - 1))$
print("E2  Sbhc=1/2    :", ratsimp(dot(bh, c) - 1/2))$
print("E3  Sbhc^2=1/3  :", ratsimp(dot(bh, cc(2)) - 1/3))$
print("E4  SbhAc=1/6   :", ratsimp(dot(bh, Ac(1)) - 1/6))$
print("E5-order5-fail  :", ratsimp(dot(bh, cc(3)) - 1/4))$  /* should be NONZERO: bh is only order 4 */

/* The dense output (Hairer's contd5, Shampine's continuous extension; plans/17 Ф17.D). dopri5.rs
   builds y(t0 + theta h) = r1 + theta (r2 + (1 - theta)(r3 + theta (r4 + (1 - theta) r5))) from
   r1 = y0, r2 = y1 - y0 = h b.k, r3 = h k1 - r2, r4 = r2 - h k7 - r3 and r5 = h d.k, so the
   interpolant's weights on the stages are B(theta) below. It is order 4 at every theta when the
   eight order-4 conditions hold with theta^k/k in place of 1/k: each is checked as an identity in
   theta, exactly in the rationals. */
d : [-12715105075/11282082432, 0, 87487479700/32700410799, -10690763975/1880347072,
     701980252875/199316789632, -1453857185/822651844, 69997945/29380423]$
unit(k) := makelist(if i = k then 1 else 0, i, 1, s)$
Bth : theta*b + theta*(1 - theta)*((unit(1) - b)
        + theta*(b - unit(7) - (unit(1) - b) + (1 - theta)*d))$
dense_ok(lhs, rhs) := is(ratsimp(lhs - rhs) = 0)$
AAc : makelist(sum(a[i,j]*Ac(1)[j], j, 1, s), i, 1, s)$
dense : [dense_ok(sum_b(Bth), theta), dense_ok(dot(Bth, c), theta^2/2),
         dense_ok(dot(Bth, cc(2)), theta^3/3), dense_ok(dot(Bth, Ac(1)), theta^3/6),
         dense_ok(dot(Bth, cc(3)), theta^4/4), dense_ok(sum(Bth[i]*c[i]*Ac(1)[i], i, 1, s), theta^4/8),
         dense_ok(dot(Bth, Ac(2)), theta^4/12), dense_ok(dot(Bth, AAc), theta^4/24)]$
print("dense output order-4 conditions in theta (8 true?):", dense)$
print("dense output is order 4 at every theta:", every(identity, dense))$
print("dense output at theta = 1 is the step:", is(ratsimp(subst(theta = 1, Bth) - b) = makelist(0, i, 1, s)))$
load("rust_literals.mac")$
src : "../crates/spacelab-propagation/src/dopri5.rs"$
print("rust D1, D3..D7 are exactly d:",
      same_rationals(map(lambda([n], rust_scalar(src, n)), ["D1", "D3", "D4", "D5", "D6", "D7"]),
                     [d[1], d[3], d[4], d[5], d[6], d[7]]))$
