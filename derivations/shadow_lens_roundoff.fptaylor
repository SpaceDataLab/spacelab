// The round-off of the shadow lens, bounded by FPTaylor where it can be (plans/17 Ф28.D).
//
//   timeout 600 fptaylor --log-base-dir <tmp> --tmp-base-dir <tmp> --opt-x-abs-tol 0
//     --opt-x-rel-tol 0 --opt-f-rel-tol 1e-2 --opt-f-abs-tol 0 --rel-error true --abs-error false
//     --rel-error-threshold 0 --fp-power2-model false shadow_lens_roundoff.fptaylor
//
// Code: crates/spacelab-propagation/src/shadow.rs, `x_minus_sin` and `lens_area`, in their f64
// operation order; every `rnd64` is one IEEE double rounding to nearest-even, no FMA. libm's sin and
// atan2 (musl's) are assumed within one ulp, stated as rnd[64, ne, 2]: a relative error of at most
// 2^-52. atan2(h, t) with h > 0 is pi/2 - atan(t/h) exactly; pi is the interval below. All bounds
// are relative; in units of u = 2^-53 they are bounds in ulp of the result, as ulp(y)/y > u.
//
// --fp-power2-model false makes every rounding a relative error of at most u (2u for libm), the
// model shadow_lens_budget.mac counts, so the two are the same first-order sum. FPTaylor's default
// bounds a rounding by half an ulp of its binade instead: tighter by up to 2, and on these boxes
// slower by more than ten minutes.
//
// Task branch: x - sin x for x in [2, 2 pi]. `x_minus_sin`'s series branch is not here. Its
// double-double steps are exact by Dekker's and Knuth's theorems, which FPTaylor cannot see: with
// them written as exact reals, it bounds the series on [1, 2] at 4.9u, 77 % above its own lower
// estimate, in 280 s. x_minus_sin_roundoff.mac bounds every rounding by hand instead: 1.245u. The
// lens tasks take that as one rounding, rnd[64, ne, 1.245](x - sin(x)). The term-by-term series
// these tasks used to model was within 13.7u, and 4.44 ulp off at x = 1.858598579272284.
//
// Tasks lens_p2 .. lens_p5: `lens_area` for the 400 km pair of tests/shadow_lens.rs (r_E and r_S,
// the doubles below, written exactly) over boxes of d whose ends are the test's grid points or the
// point where the sun's segment angle is 1.9. The angle crosses 2, the branch point, in
// the penumbra: lens_p2 .. lens_p4 take the direct branch, lens_p5 the series, and the two overlap
// where the computed angle can fall either side. Toward either tangency FPTaylor gives no useful
// bound: the sqrt of a vanishing product has an unbounded derivative. In trial runs the box from
// 1.2208848 to 1.2220462 gave 5.2e6u and the box from 1.2289832 to 1.2301834 overflowed inside
// FPTaylor, so neither is here.
//
// Result, against the gate 18 + 2 kappa ulp of tests/shadow_lens.rs (kappa = 4K/A, the area's
// condition number in d) and the first-order budget of shadow_lens_budget.mac, maximised over
// 4001 points of each box:
//
//   box        d                       kappa          FPTaylor (lower)            budget     gate there
//   branch     x in [2, 2 pi]                         2.986e-16 = 2.69u (2.67u)   2.67u
//   lens_p2    1.2220462 .. 1.2232089  119 .. 181     3.624e-14 = 326.4u (324.6)  324.6u     379
//   lens_p3    1.2232089 .. 1.2255341  181 .. 336     7.617e-14 = 686.0u (679.7)  679.7u     690
//   lens_p4    1.2255341 .. 1.2282334  336 .. 898     1.692e-13 = 1523u (1510)    1508u      1815
//   lens_p5    1.2278593 .. 1.2289832  745 .. 1491    2.441e-13 = 2198u (2179)    2179u      3001
//
// FPTaylor's lower estimate is the budget's maximum to four digits on every box but lens_p4, whose
// box FPTaylor evaluates on the direct branch below x_S = 2 as well, where the budget counts the
// series. Two tools, one model: the closed forms of shadow_lens_budget.mac (1) are FPTaylor's
// derivatives. At lens_p3's maximum x_S = 3.138: the occulter's edge runs through the Sun's centre,
// where the budget's c2 = 2 is reached, and it comes within 1.5 % of the gate. The boxes are wider
// than the gate is flat, so these bounds do not prove the gate; shadow_lens_budget_arb.c does,
// pointwise over the whole penumbra.

{
Variables
  float64 x in [2, 6.2832]
;
Expressions
  branch = rnd64(x - rnd[64, ne, 2](sin(x)))
;
}
{
Variables
  float64 d in [1.2220462317796053, 1.2232088527855092],
  real p in [3.141592653589793238462643383279502884, 3.141592653589793238462643383279502885]
;
Definitions
  ac = 0x1.39bc9a3949959p+0,
  as = 0x1.30c62ccac04dap-8,
  sm = rnd64(ac + as),
  df = rnd64(ac - as),
  heron = rnd64(sqrt(rnd64(rnd64(rnd64(rnd64(sm - d) * rnd64(d - df)) * rnd64(d + df)) * rnd64(d + sm)))),
  squares = rnd64(df * sm),
  d2 = rnd64(d * d),
  xs = 2 * rnd[64, ne, 2](p / 2 - atan(rnd64(d2 - squares) / heron)),
  xc = 2 * rnd[64, ne, 2](atan(heron / rnd64(d2 + squares))),
  xsX = rnd64(xs - rnd[64, ne, 2](sin(xs))),
  xcX = rnd[64, ne, 1.245](xc - sin(xc)),
  sun = rnd64(rnd64(as * as) * xsX),
  central = rnd64(rnd64(ac * ac) * xcX)
;
Expressions
  lens_p2 = 0.5 * rnd64(sun + central)
;
}
{
Variables
  float64 d in [1.2232088527855092, 1.2255340947973166],
  real p in [3.141592653589793238462643383279502884, 3.141592653589793238462643383279502885]
;
Definitions
  ac = 0x1.39bc9a3949959p+0,
  as = 0x1.30c62ccac04dap-8,
  sm = rnd64(ac + as),
  df = rnd64(ac - as),
  heron = rnd64(sqrt(rnd64(rnd64(rnd64(rnd64(sm - d) * rnd64(d - df)) * rnd64(d + df)) * rnd64(d + sm)))),
  squares = rnd64(df * sm),
  d2 = rnd64(d * d),
  xs = 2 * rnd[64, ne, 2](p / 2 - atan(rnd64(d2 - squares) / heron)),
  xc = 2 * rnd[64, ne, 2](atan(heron / rnd64(d2 + squares))),
  xsX = rnd64(xs - rnd[64, ne, 2](sin(xs))),
  xcX = rnd[64, ne, 1.245](xc - sin(xc)),
  sun = rnd64(rnd64(as * as) * xsX),
  central = rnd64(rnd64(ac * ac) * xcX)
;
Expressions
  lens_p3 = 0.5 * rnd64(sun + central)
;
}
{
Variables
  float64 d in [1.2255340947973166, 1.228233364674623],
  real p in [3.141592653589793238462643383279502884, 3.141592653589793238462643383279502885]
;
Definitions
  ac = 0x1.39bc9a3949959p+0,
  as = 0x1.30c62ccac04dap-8,
  sm = rnd64(ac + as),
  df = rnd64(ac - as),
  heron = rnd64(sqrt(rnd64(rnd64(rnd64(rnd64(sm - d) * rnd64(d - df)) * rnd64(d + df)) * rnd64(d + sm)))),
  squares = rnd64(df * sm),
  d2 = rnd64(d * d),
  xs = 2 * rnd[64, ne, 2](p / 2 - atan(rnd64(d2 - squares) / heron)),
  xc = 2 * rnd[64, ne, 2](atan(heron / rnd64(d2 + squares))),
  xsX = rnd64(xs - rnd[64, ne, 2](sin(xs))),
  xcX = rnd[64, ne, 1.245](xc - sin(xc)),
  sun = rnd64(rnd64(as * as) * xsX),
  central = rnd64(rnd64(ac * ac) * xcX)
;
Expressions
  lens_p4 = 0.5 * rnd64(sun + central)
;
}
{
Variables
  float64 d in [1.227859336809124, 1.2289832266931768],
  real p in [3.141592653589793238462643383279502884, 3.141592653589793238462643383279502885]
;
Definitions
  ac = 0x1.39bc9a3949959p+0,
  as = 0x1.30c62ccac04dap-8,
  sm = rnd64(ac + as),
  df = rnd64(ac - as),
  heron = rnd64(sqrt(rnd64(rnd64(rnd64(rnd64(sm - d) * rnd64(d - df)) * rnd64(d + df)) * rnd64(d + sm)))),
  squares = rnd64(df * sm),
  d2 = rnd64(d * d),
  xs = 2 * rnd[64, ne, 2](p / 2 - atan(rnd64(d2 - squares) / heron)),
  xc = 2 * rnd[64, ne, 2](atan(heron / rnd64(d2 + squares))),
  xsX = rnd[64, ne, 1.245](xs - sin(xs)),
  xcX = rnd[64, ne, 1.245](xc - sin(xc)),
  sun = rnd64(rnd64(as * as) * xsX),
  central = rnd64(rnd64(ac * ac) * xcX)
;
Expressions
  lens_p5 = 0.5 * rnd64(sun + central)
;
}
