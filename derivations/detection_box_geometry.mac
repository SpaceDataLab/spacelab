/* The box geometry of spacelab-vision/src/detect.rs -- IoU, greedy NMS, anchors and the box
 * decoding -- in exact arithmetic, with the reference values of the gates in its test module.
 *
 * The code takes IoU = inter/(area_a + area_b - inter) with extents x2 - x1 (no "+1"), keeps boxes
 * greedily in descending score and suppresses a later box whose IoU with a kept one is strictly
 * above the threshold, lays anchors w = s/sqrt(r), h = s sqrt(r) about each cell centre, and
 * decodes a delta as cx = cxa + dx wa, cy = cya + dy ha, w = wa e^dw, h = ha e^dh.
 *
 * Shown here, every line printing `<name>: 0`:
 *   1. an anchor has area s^2 and aspect h/w = r for every s, r > 0 (G2);
 *   2. decoding is the inverse of the Faster-R-CNN encoding dx = (cx - cxa)/wa, dw = log(w/wa):
 *      encode(decode(delta)) = delta (G1);
 *   3. IoU is unchanged by translating and scaling both boxes by s > 0, for an overlapping pair
 *      written with its overlap pattern explicit (G4);
 *   4. the fifteen IoUs of the six-box fixture as exact rationals, and the greedy NMS of that
 *      fixture at thresholds 3/10, 1/2 and exactly 1/7 -- the IoU of boxes 0 and 4, where strict
 *      suppression keeps box 0 (G2);
 *   5. a decoded box at 40 digits (G2).
 * derivations/detection_box_geometry.gp recomputes the IoUs by counting unit cells.
 *
 * Run: timeout 300 maxima --very-quiet --suppress-input-echo -Q -b \
 *          derivations/detection_box_geometry.mac </dev/null
 */

zero(name, expr) := block([d : expr],
  printf(true, "~a: ~a~%", name, d),
  if d # 0 then error("identity does not reduce to zero:", name))$
assume(s > 0, r > 0, wa > 0, ha > 0, k > 0)$

/* 1. */
aw : s/sqrt(r)$  ah : s*sqrt(r)$
zero("anchor_area_is_scale_squared", radcan(aw*ah - s^2))$
zero("anchor_aspect_is_ratio", radcan(ah/aw - r))$

/* 2. */
dec : [cxa + dx*wa, cya + dy*ha, wa*exp(dw), ha*exp(dh)]$
enc : [(dec[1] - cxa)/wa, (dec[2] - cya)/ha, log(dec[3]/wa), log(dec[4]/ha)]$
for i : 1 thru 4 do zero(sconcat("encode_inverts_decode_", i), radcan(enc[i] - [dx, dy, dw, dh][i]))$

/* 3. A = [0, a1] x [0, a2], B = [b1, b1 + c1] x [b2, b2 + c2] with 0 < b < a < b + c: the overlap is
   (a1 - b1)(a2 - b2). Every quantity is a difference of coordinates, so a translation cancels
   from each of them and only the scale k > 0 is left to show. */
iou_pattern(A1, A2, B1, B2, C1, C2) := block([inter : (A1 - B1)*(A2 - B2)],
  inter/(A1*A2 + C1*C2 - inter))$
zero("iou_scale_translation_invariance",
     ratsimp(iou_pattern(k*a1, k*a2, k*b1, k*b2, k*c1, k*c2) - iou_pattern(a1, a2, b1, b2, c1, c2)))$

/* 4. */
boxes : [[10, 10, 50, 50], [12, 11, 52, 51], [90, 90, 140, 140], [92, 93, 141, 139],
         [30, 30, 70, 70], [200, 200, 260, 255]]$
area(b) := max(b[3] - b[1], 0)*max(b[4] - b[2], 0)$
iou(a, b) := block([w : max(min(a[3], b[3]) - max(a[1], b[1]), 0),
                    h : max(min(a[4], b[4]) - max(a[2], b[2]), 0), u],
  u : area(a) + area(b) - w*h, if u > 0 then w*h/u else 0)$
for i : 1 thru 6 do for j : i + 1 thru 6 do
  printf(true, "iou(~a, ~a) = ~a~%", i - 1, j - 1, iou(boxes[i], boxes[j]))$
zero("iou_0_4_is_one_seventh", iou(boxes[1], boxes[5]) - 1/7)$
scores : [9/10, 3/4, 4/5, 3/5, 19/20, 1/2]$
nms(th) := block([order, kept : [], sup : makelist(false, i, 1, 6)],
  order : map(second, sort(makelist([-scores[i], i], i, 1, 6))),
  for a in order do if not sup[a] then (
    kept : endcons(a - 1, kept),
    for b in order do if b # a and not sup[b] and not member(b - 1, kept)
                         and iou(boxes[a], boxes[b]) > th then sup[b] : true),
  kept)$
print("nms_3/10:", nms(3/10))$
print("nms_1/2:", nms(1/2))$
print("nms_1/7:", nms(1/7))$
print("nms_1/8:", nms(1/8))$
zero("nms_keeps_box_0_at_exactly_its_iou_with_box_4", if member(0, nms(1/7)) then 0 else 1)$
zero("nms_drops_box_0_just_below_it", if member(0, nms(1/8)) then 1 else 0)$

/* 5. */
fpprec : 40$
anchor : [20, 40, 60, 100]$
delta : [3/10, -1/5, 7/10, -2/5]$
w_ : (anchor[3] - anchor[1])*exp(delta[3])$
h_ : (anchor[4] - anchor[2])*exp(delta[4])$
cx_ : (anchor[1] + anchor[3])/2 + delta[1]*(anchor[3] - anchor[1])$
cy_ : (anchor[2] + anchor[4])/2 + delta[2]*(anchor[4] - anchor[2])$
printf(true, "decoded:")$
for x in bfloat([cx_ - w_/2, cy_ - h_/2, cx_ + w_/2, cy_ + h_/2]) do printf(true, " ~h", x)$
printf(true, "~%")$
