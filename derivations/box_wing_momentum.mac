/* The flat-plate forces of crates/spacelab-propagation/src/spacecraft.rs from the momentum balance
   (plans/17 Ф17.N).

   A facet of area A with outward unit normal n meets a stream of photons or molecules. What it
   receives per unit time is the stream's momentum flux through its projected area minus what leaves
   it. Three fates, each a fraction of what arrives:
   - absorbed: everything it carried stays (molecules re-emitted at negligible speed count here);
   - reflected specularly: it leaves along u - 2 (u.n) n at the same speed, so the facet keeps
     2 (u.n) n per unit of incoming momentum;
   - reflected diffusely (photons, Lambert's law): it leaves with the mean direction (2/3) n, the
     cosine-weighted average of the outward hemisphere, derived in (1).

   SRP, Montenbruck & Gill (2000) eq. 3.75, Vallado eq. 8-44: absorption C_a, specular C_s,
   diffuse 1 - C_a - C_s, the stream along -s for s the unit satellite->Sun, cos(theta) = n.s > 0.
   Drag: molecules along the relative wind w at speed V, d = n.w < 0 on the windward side; a lift
   ratio lambda of them reflect specularly and the rest are absorbed, which is the model Orekit's
   `BoxAndSolarArraySpacecraft` describes. A specular molecule hands over 2 |d| of its momentum along
   the normal, and the number arriving is proportional to |d| again: the lift force goes as d^2.
   Orekit's code carries one factor |d| (F89); `spacecraft.rs` now carries both, (5)-(7).

   The Sun-tracking array turns about a unit axis a to bring its normal as close to s as one degree
   of freedom allows: the normalised projection of s on the plane normal to a, (8)-(11).

   (12)-(13) evaluate the lift-enabled box of the golden test at its own geometry: the momentum
   balance gives LIFT_DRAG_MAXIMA, and Orekit's single-|d| form gives Orekit's printed vector.

   Every check prints as `<name>: 0`, 13 of them.

   timeout 300 maxima --very-quiet -Q -b box_wing_momentum.mac                                    */

display2d : false$
fpprec : 40$
load("rust_literals.mac")$

zero3(v) := if every(lambda([x], is(ratsimp(x) = 0)), v) then 0 else v$
dotv(x, y) := x[1]*y[1] + x[2]*y[2] + x[3]*y[3]$

/* (1) Lambert: the cosine-weighted mean of the outward direction over the hemisphere is (2/3) n. */
lambert : integrate(integrate(cos(t)^2*sin(t), t, 0, %pi/2), p, 0, 2*%pi)
        / integrate(integrate(cos(t)*sin(t), t, 0, %pi/2), p, 0, 2*%pi)$
print("lambert_mean_direction:", ratsimp(lambert - 2/3))$

/* Unit normal and unit Sun direction, held unit by substitution. */
n : [n1, n2, n3]$
s : [s1, s2, s3]$
c : dotv(n, s)$
u : -s$
uout : u - 2*dotv(u, n)*n$

/* (2) a specular reflection keeps the speed */
print("specular_keeps_speed:",
      ratsimp(ratsubst(1 - s1^2 - s2^2, s3^2, ratsubst(1 - n1^2 - n2^2, n3^2,
                                                        expand(dotv(uout, uout) - dotv(u, u))))))$

/* (3) SRP from the three fates, Phi = P A cos(theta) the momentum arriving per unit time. */
Cd : 1 - Ca - Cs$
Phi : P*A*c$
F_srp : Ca*Phi*u + Cs*Phi*(u - uout) + Cd*Phi*(u - 2/3*n)$
print("srp_three_fates_are_eq_8_44:", zero3(F_srp - (-P*A*c*((Ca + Cd)*s + 2*(Cs*c + Cd/3)*n))))$

/* (4) the code's form: flux F = P u (Sun -> satellite), d = n.F = -P cos(theta), psr = P,
   cN = 2 A d (C_d/3 - C_s d/psr), cS = (A d/psr)(C_s - 1), force cN n + cS F. */
Fflux : P*u$
dS : dotv(n, Fflux)$
cN : 2*A*dS*(Cd/3 - Cs*dS/P)$
cS : (A*dS/P)*(Cs - 1)$
print("srp_code_form:", zero3(cN*n + cS*Fflux - F_srp))$

/* Drag: wind w, speed V, density rho, d = n.w < 0; mass flux rho V A |d| = -rho V A d. The
   coefficient C_D normalises the absorbed-only stream to C_D/2 of rho V^2 A |d|. */
w : [w1, w2, w3]$
dD : dotv(n, w)$
wout : w - 2*dD*n$
mflux : -rho*V*A*dD$
F_drag : (CD/2)*((1 - lam)*mflux*V*w + lam*mflux*V*(w - wout))$

/* (5) the shipped form: f = (rho V^2/2) C_D A d, (1 - lambda) |f| w + 2 lambda f |d| n */
f : (rho*V^2/2)*CD*A*dD$
print("drag_code_form:", zero3((1 - lam)*(-f)*w + 2*lam*f*(-dD)*n - F_drag))$

/* (6) Orekit's lift term 2 lambda f n is the specular force divided by |d| */
spec : (CD/2)*lam*mflux*V*(w - wout)$
print("orekit_lift_term_lacks_one_incidence_factor:", zero3(2*lam*f*n*(-dD) - spec))$

/* (7) head on, w = -n, all-specular drag is twice all-absorbed drag, as Orekit's description says;
   there |d| = 1 and the missing factor is invisible, which is the only case it describes. */
headon(x) := ratsimp(ratsubst(1 - n1^2 - n2^2, n3^2, expand(subst([w1 = -n1, w2 = -n2, w3 = -n3], x))))$
print("head_on_specular_is_twice_absorbed:",
      zero3(map(headon, subst(lam = 1, F_drag) - 2*subst(lam = 0, F_drag))))$

/* (8)-(11) the Sun-tracking normal m = (s - (s.a) a)/sqrt(1 - (s.a)^2) for unit a and s */
a : [a1, a2, a3]$
sa : dotv(s, a)$
sperp : s - sa*a$
m : sperp/sqrt(1 - sa^2)$
unit_as(x) := ratsubst(1 - a1^2 - a2^2, a3^2, ratsubst(1 - s1^2 - s2^2, s3^2, expand(x)))$
print("array_normal_on_the_plane:", ratsimp(unit_as(dotv(sperp, a))))$
print("array_normal_unit:", ratsimp(unit_as(dotv(sperp, sperp)) - unit_as(1 - sa^2)))$
print("array_normal_sun_cosine:", ratsimp(unit_as(dotv(sperp, s)) - unit_as(1 - sa^2)))$
/* any unit q in the plane sees s through s_perp, and Lagrange's identity bounds q.s_perp by
   |s_perp|: |q|^2 |s_perp|^2 - (q.s_perp)^2 = |q x s_perp|^2 >= 0 */
q : [q1, q2, q3]$
crossv(x, y) := [x[2]*y[3] - x[3]*y[2], x[3]*y[1] - x[1]*y[3], x[1]*y[2] - x[2]*y[1]]$
print("array_normal_is_the_best:",
      ratsimp(expand(dotv(q, q)*dotv(sperp, sperp) - dotv(q, sperp)^2
                     - dotv(crossv(q, sperp), crossv(q, sperp)))))$

/* (12)-(13) the lift-enabled box of the golden test, as `box_lift()` builds it: 1.5 x 2 x 3 m,
   1000 kg, C_D = 2.2, lambda = 1/4, rho = 2e-12, faces -X +X -Y +Y -Z +Z. */
src : "../crates/spacelab-propagation/src/spacecraft.rs"$
Mflat : map(rust_rational, rust_table(src, "LIFT_ATTITUDE"))$
M : genmatrix(lambda([i, j], Mflat[3*(i - 1) + j]), 3, 3)$
vin : map(rust_rational, rust_table(src, "LIFT_RELVEL"))$
faces : [[[-1, 0, 0], 6], [[1, 0, 0], 6], [[0, -1, 0], 9/2], [[0, 1, 0], 9/2],
         [[0, 0, -1], 3], [[0, 0, 1], 3]]$
box_drag(lift_power) := block([vb, V2, wb, acc : [0, 0, 0], dd, ff, coeff],
  vb : list_matrix_entries(M . transpose(matrix(vin))),
  V2 : dotv(vb, vb),
  wb : vb/sqrt(V2),
  coeff : (2/10^12)*V2/2,
  for fc in faces do (
    dd : dotv(fc[1], wb),
    if is(bfloat(dd) < 0) then (
      ff : coeff*(22/10)*fc[2]*dd,
      acc : acc + (1 - 1/4)*(-ff)*wb + 2*(1/4)*ff*(-dd)^lift_power*fc[1])),
  list_matrix_entries(transpose(M) . transpose(matrix(acc/1000))))$
print("lift_tilt_drag:", if certified("LIFT_DRAG_MAXIMA", rust_table(src, "LIFT_DRAG_MAXIMA"), box_drag(1)) then 0 else 1)$
/* Orekit 13.1.7's printed drag for this geometry (tools/orekit-oracle, orekit_box_wing.csv), the
   vector the golden test held before F89. */
orekit_printed : [1.05063598970169920b-06, 1.04319104803891920b-07, -1.05929245207931560b-07]$
block([orekit : orekit_printed, ours : bfloat(box_drag(0)), worst],
  worst : lmax(map(lambda([x, y], abs(x - y)/abs(y)), ours, orekit)),
  print("Orekit's lift_tilt vector against its own single-|d| form, worst relative:", worst),
  print("orekit_vector_is_its_formula:", if worst < 10^-12 then 0 else 1))$
