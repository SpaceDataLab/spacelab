/* Lambert's problem in the universal variable -- crates/spacelab-astro/src/lambert.rs -- shown to be
   the two-body boundary-value problem, and the two exact conics its gate is built on.

   The code (Curtis Alg. 5.2) works with A = sin(dnu) sqrt(r1 r2/(1 - cos dnu)), so that
   A^2 = r1 r2 (1 + cos dnu), the Stumpff pair C(z), S(z), and
       y(z) = r1 + r2 + A (z S - 1)/sqrt(C),        coded as  r1 + r2 - sqrt(2) A cos(sqrt(z)/2),
       F(z) = (y/C)^(3/2) S + A sqrt(y) - sqrt(mu) t,
       f = 1 - y/r1,  g = A sqrt(y/mu),  gdot = 1 - y/r2,
       v1 = (r2vec - f r1vec)/g,  v2 = (gdot r2vec - r1vec)/g.

   Printed `<name>: 0`, each a residual that must vanish:
     1-4.  sqrt(C) = sqrt(2) sin(w/2)/w (ellipse, z = w^2) or sqrt(2) sinh(w/2)/w (hyperbola,
           z = -w^2), and with it the coded closed form of y is Curtis's quotient (G1);
     5-8.  the Stumpff derivatives C' = (1 - zS - 2C)/(2z), S' = (C - 3S)/(2z) on both branches;
     9.    y' = A sqrt(C)/4 on the ellipse (the hyperbola follows by w -> i w);
     10.   the coded `dfdz` is dF/dz, given 5-9 -- with c = sqrt(C) and X = sqrt(y/C) the
           identity is rational (G1);
     11.   the coded z -> 0 branch of `dfdz` is the limit of the general one;
     12-13. the Stumpff identity 2C - (zS - 1)^2 = z C^2 on both branches;
     14.   the arc's v1 has 2/r1 - |v1|^2/mu = z C/y: the reciprocal semi-major axis alpha of the
           returned arc satisfies alpha chi^2 = z with chi = sqrt(y/C) (uses 12-13);
     15-17. the universal Kepler equation from (r1, v1) at chi = sqrt(y/C) reduces to F(z) = 0, and
           at that chi the universal f and g are the coded ones -- so (r1, v1) propagated by t lands
           on f r1vec + g v1 = r2vec: the returned arc solves the two-body BVP (G2);
     18.   f gdot - fdot g = 1 with Curtis's fdot = sqrt(mu)/(r1 r2) sqrt(y/C) (zS - 1) (G4);
     19-24. the exact ellipse of the gate, mu = 1, r1 = 1, e = 1/2 (p = 3/2, a = 2), from
           periapsis to nu = 90 deg, r2 = (0, 3/2, 0): tan(E/2) = sqrt((1-e)/(1+e)) tan(nu/2)
           gives E = pi/3, t = sqrt(a^3) (E - e sin E) = 2 sqrt(2) (pi/3 - sqrt(3)/4), and the
           Lagrange f, g in the transfer angle give v1 = (0, sqrt(3/2), 0),
           v2 = sqrt(2/3) (-1, 1/2, 0); the vis-viva and angular momentum of v1 close (G3);
     25-30. the exact hyperbola, mu = 1, r1 = 1, e = 2 (p = 3, |a| = 1), to nu = 90 deg,
           r2 = (0, 3, 0): tanh(H/2) = 1/sqrt(3), H = log(2 + sqrt(3)),
           t = e sinh H - H = 2 sqrt(3) - log(2 + sqrt(3)), v1 = (0, sqrt(3), 0),
           v2 = (-1/sqrt(3), 2/sqrt(3), 0) (G3).

   The 100-digit arcs for generic double inputs, by Lagrange's theorem rather than z, are in
   derivations/lambert_universal.gp.

   Run: timeout 300 maxima --very-quiet --suppress-input-echo -Q -b derivations/lambert_universal.mac </dev/null */

display2d : false$
zero(name, expr) := block([d : expr],
  printf(true, "~a: ~a~%", name, d),
  if d # 0 then error("identity does not reduce to zero:", name))$
assume(w > 0, w < 2*%pi, r1 > 0, r2 > 0, mu > 0)$
ell(x) := ratsimp(trigsimp(trigreduce(trigexpand(ratsimp(x)))))$
hyp(x) := ratsimp(radcan(exponentialize(ratsimp(x))))$

/* 1-4 */
Ce : (1 - cos(w))/w^2$  Se : (w - sin(w))/w^3$  sCe : sqrt(2)*sin(w/2)/w$
Ch : (cosh(w) - 1)/w^2$ Sh : (sinh(w) - w)/w^3$ sCh : sqrt(2)*sinh(w/2)/w$
zero("ellipse_sqrt_c", ell(sCe^2 - Ce))$
zero("ellipse_y_closed_form", ell(A*(w^2*Se - 1)/sCe + sqrt(2)*A*cos(w/2)))$
zero("hyperbola_sqrt_c", hyp(sCh^2 - Ch))$
zero("hyperbola_y_closed_form", hyp(A*(-w^2*Sh - 1)/sCh + sqrt(2)*A*cosh(w/2)))$

/* 5-8: d/dz = (1/(2w)) d/dw for z = w^2, and -(1/(2w)) d/dw for z = -w^2. */
zero("ellipse_stumpff_c_derivative", ell(diff(Ce, w)/(2*w) - (1 - w^2*Se - 2*Ce)/(2*w^2)))$
zero("ellipse_stumpff_s_derivative", ell(diff(Se, w)/(2*w) - (Ce - 3*Se)/(2*w^2)))$
zero("hyperbola_stumpff_c_derivative", hyp(-diff(Ch, w)/(2*w) - (1 + w^2*Sh - 2*Ch)/(-2*w^2)))$
zero("hyperbola_stumpff_s_derivative", hyp(-diff(Sh, w)/(2*w) - (Ch - 3*Sh)/(-2*w^2)))$

/* 9 */
ye : r1 + r2 - sqrt(2)*A*cos(w/2)$
zero("ellipse_y_derivative", ell(diff(ye, w)/(2*w) - A*sCe/4))$

/* 10: abstract z, with c = sqrt(C), X = sqrt(y/C); C' and S' from 5-8, y' from 9. */
block([C : c^2, y, dC, dS, dy, dF, coded],
  y : c^2*X^2,
  dC : (1 - z*S - 2*C)/(2*z), dS : (C - 3*S)/(2*z), dy : A*c/4,
  /* F = (y/C)^(3/2) S + A sqrt(y): differentiate through y and C, with (y/C)^(1/2) = X. */
  dF : (3/2)*X*(dy*C - y*dC)/C^2*S + X^3*dS + A*dy/(2*c*X),
  coded : X^3*((1/(2*z))*(C - 3*S/(2*C)) + 3*S^2/(4*C)) + A/8*(3*S/C*c*X + A/X),
  zero("dfdz_is_the_derivative_of_the_residual", ratsimp(dF - coded)))$

/* 11: series of C and S at z = 0. The singular factor (C - 3S/(2C))/(2z) is rational in z once the
   series are in, and its numerator 2C^2 - 3S has no constant term, so ratsimp cancels the z. */
block([Cz, Sz, K, lim],
  Cz : sum((-z)^k/(2*k + 2)!, k, 0, 6), Sz : sum((-z)^k/(2*k + 3)!, k, 0, 6),
  K : ratsimp((2*Cz^2 - 3*Sz)/(4*z*Cz)),
  assume(y0 > 0),
  lim : subst(z = 0, (y0/Cz)^(3/2)*(K + 3*Sz^2/(4*Cz)) + A/8*(3*Sz/Cz*sqrt(y0) + A*sqrt(Cz/y0))),
  zero("dfdz_small_z_branch_is_the_limit",
       radcan(lim - (sqrt(2)/40*y0^(3/2) + A/8*(sqrt(y0) + A*sqrt(1/(2*y0)))))))$

/* 12-13 */
zero("ellipse_stumpff_alpha_identity", ell(2*Ce - (w^2*Se - 1)^2 - w^2*Ce^2))$
zero("hyperbola_stumpff_alpha_identity", hyp(2*Ch - (-w^2*Sh - 1)^2 + w^2*Ch^2))$

/* 14-17: plane coordinates, r1vec = (r1, 0), r2vec = r2 (cos, sin), with r1 r2 cos = A^2 - r1 r2.
   Everything is expressed in c = sqrt(C), S, z and A; y is its definition. */
block([C : c^2, y, f, g, gd, rr, v1sq, r1v1, alpha, chi, kep],
  y : r1 + r2 + A*(z*S - 1)/c,
  f : 1 - y/r1, g : A*sqrt(y)/sqrt(mu), gd : 1 - y/r2,
  rr : A^2 - r1*r2,                                   /* r1vec . r2vec */
  v1sq : (r2^2 - 2*f*rr + f^2*r1^2)/g^2,
  r1v1 : (rr - f*r1^2)/g,
  /* 14: with 2C - (zS - 1)^2 = z C^2 substituted for C^2. */
  alpha : 2/r1 - v1sq/mu,
  zero("arc_reciprocal_semi_major_axis_is_z_c_over_y",
       ratsimp(ratsubst((2*C - (z*S - 1)^2)/z, c^4, ratsimp((alpha - z*C/y)*y)))),
  /* 15: universal Kepler time from (r1, v1) at chi = sqrt(y)/c, alpha = zC/y, against F + sqrt(mu) t. */
  chi : sqrt(y)/c,
  kep : (r1v1/sqrt(mu))*chi^2*C + (1 - (z*C/y)*r1)*chi^3*S + r1*chi,
  zero("kepler_equation_of_the_arc_is_the_lambert_residual",
       ratsimp(radcan(kep - (chi^3*S + A*sqrt(y))))),
  zero("universal_f_is_the_coded_f", ratsimp((1 - chi^2*C/r1) - f)),
  zero("universal_g_at_the_root_is_the_coded_g",
       ratsimp(radcan(((chi^3*S + A*sqrt(y))/sqrt(mu) - chi^3*S/sqrt(mu)) - g))))$

/* 18 */
block([C : c^2, y, f, g, gd, fd],
  y : r1 + r2 + A*(z*S - 1)/c,
  f : 1 - y/r1, g : A*sqrt(y)/sqrt(mu), gd : 1 - y/r2,
  fd : sqrt(mu)/(r1*r2)*sqrt(y)/c*(z*S - 1),
  zero("lagrange_wronskian", ratsimp(radcan(f*gd - fd*g - 1))))$

/* 19-30: the two exact conics, mu = 1, r1vec = (1, 0, 0), r2vec at nu = 90 deg. */
exact_conic(tag, e, p, t_closed, v1_closed, v2_closed, anomaly) := block(
  [r2v, r2n, dnu : %pi/2, f, g, gd, v1, v2, h],
  r2n : p/(1 + e*cos(dnu)),
  r2v : [0, r2n, 0],
  /* The Lagrange coefficients in the transfer angle (Curtis Eq. 2.158). */
  f : 1 - r2n/p*(1 - cos(dnu)), g : 1*r2n*sin(dnu)/sqrt(p), gd : 1 - 1/p*(1 - cos(dnu)),
  v1 : (r2v - f*[1, 0, 0])/g, v2 : (gd*r2v - [1, 0, 0])/g,
  zero(sconcat(tag, "_time_of_flight"),
       ev(ratsimp(logcontract(radcan(anomaly - t_closed))), algebraic : true)),
  zero(sconcat(tag, "_departure_velocity"), radcan(lsum(q^2, q, v1 - v1_closed))),
  zero(sconcat(tag, "_arrival_velocity"), radcan(lsum(q^2, q, v2 - v2_closed))),
  zero(sconcat(tag, "_periapsis_speed_is_vis_viva"),
       radcan(v1.v1 - (2 - (1 - e^2)/p))),
  h : v1[2]*1,
  zero(sconcat(tag, "_angular_momentum"), radcan(h^2 - p)),
  zero(sconcat(tag, "_arrival_radius"), radcan(r2n - p)))$

/* Ellipse: a = 2, E = pi/3 from tan(E/2) = sqrt(1/3) tan(pi/4). */
block([e : 1/2, a : 2, E : 2*atan(sqrt(1/3)*tan(%pi/4))],
  exact_conic("ellipse", e, 3/2, 2*sqrt(2)*(%pi/3 - sqrt(3)/4),
              [0, sqrt(3/2), 0], sqrt(2/3)*[-1, 1/2, 0], sqrt(a^3)*(E - e*sin(E))))$
/* Hyperbola: |a| = 1, H = 2 atanh(sqrt(1/3) tan(pi/4)). */
block([e : 2, H : radcan(logarc(2*atanh(sqrt(1/3)*tan(%pi/4))))],
  exact_conic("hyperbola", e, 3, 2*sqrt(3) - log(2 + sqrt(3)),
              [0, sqrt(3), 0], [-1/sqrt(3), 2/sqrt(3), 0],
              radcan(exponentialize(e*sinh(H) - H))))$
