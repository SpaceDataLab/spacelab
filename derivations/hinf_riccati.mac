/* The H-infinity filter -- spacelab-estimation/src/hinf.rs -- its symmetric reformulation, its
 * Kalman limit, and its exact values on a rational fixture.
 *
 * Simon, Optimal State Estimation, sec. 11.4, writes the one-step predictor as
 *     L = [I - g Qbar P + H^T V^-1 H P]^-1,  K = F P L H^T V^-1,  P+ = F P L F^T + W,
 * and the code evaluates instead
 *     M = P^-1 - g Qbar + H^T V^-1 H,  K = F M^-1 H^T V^-1,  P+ = F M^-1 F^T + W.
 * Each line printing `<name>: 0`, on a general 2-state prior, performance weight, 2-channel
 * measurement and bound g:
 *   1. P L = M^-1, so the two gains and the two Riccati recursions are the same (G1);
 *   2. at g = 0, M^-1 = P - P H^T (H P H^T + V)^-1 H P, the Kalman posterior, and K is the Kalman
 *      one-step predictor gain F P H^T (H P H^T + V)^-1 (G3);
 *   3. the existence condition M > 0 at the prior: for Qbar = I, P0^-1 - g I > 0 exactly when
 *      g < 1/lambda_max(P0) (G3), printed for the fixture.
 * Then two steps of the recursion on the fixture of
 * `hinf.rs::the_recursion_is_the_exact_rational_riccati_recursion`, in exact rationals, at 25
 * digits; derivations/linear_filters.gp recomputes them.
 *
 * Run: timeout 300 maxima --very-quiet --suppress-input-echo -Q -b derivations/hinf_riccati.mac
 */

zero(name, expr) := block([d : expr],
  printf(true, "~a: ~a~%", name, d),
  if d # 0 then error("identity does not reduce to zero:", name))$
nonzero(m) := length(sublist(flatten(args(ratsimp(m))), lambda([e], e # 0)))$
rnum(x) := ssubst("e", "b", string(bfloat(x)))$
fpprec : 25$

s : matrix([s11, 0], [s21, s22])$
p : s . transpose(s)$
qbar : matrix([w11, w12], [w12, w22])$
h : matrix([h11, h12], [h21, h22])$
v : matrix([v11, v12], [v12, v22])$
f : matrix([f11, f12], [f21, f22])$
vi : invert(v)$
m : invert(p) - g * qbar + transpose(h) . vi . h$
l : invert(ident(2) - g * qbar . p + transpose(h) . vi . h . p)$
zero("p_l_is_m_inverse", nonzero(p . l - invert(m)))$
zero("the_two_gains_agree", nonzero(f . p . l . transpose(h) . vi - f . invert(m) . transpose(h) . vi))$
zero("the_two_riccati_recursions_agree", nonzero(f . p . l . transpose(f) - f . invert(m) . transpose(f)))$

m0 : subst(g = 0, m)$
innov : h . p . transpose(h) + v$
zero("zero_bound_m_inverse_is_the_kalman_posterior",
  nonzero(invert(m0) - (p - p . transpose(h) . invert(innov) . h . p)))$
zero("zero_bound_gain_is_the_kalman_predictor_gain",
  nonzero(f . invert(m0) . transpose(h) . vi - f . p . transpose(h) . invert(innov)))$

/* The fixture. Dyadic inputs, bound g = 1/8 with Qbar = I. */
fx : matrix([1, 1/2], [0, 1])$
hx : matrix([1, 1/4], [0, 1])$
vx : matrix([1/2, 1/8], [1/8, 1/4])$
sw : matrix([1/4, 0], [1/8, 1/2])$
l0 : matrix([2, 0], [1/2, 1])$
gx : 1/8$
cov : l0 . transpose(l0)$
x : matrix([1/2], [-1])$
/* 3. The existence threshold at the prior. */
gmax : 1 / lmax(eigenvalues(cov)[1])$
zero("threshold_is_where_p0_inverse_minus_g_loses_definiteness",
  ratsimp(radcan(determinant(invert(cov) - gmax * ident(2)))))$
printf(true, "existence threshold g_max = 1/lambda_max(P0) = ~a~%", rnum(gmax))$
hinf_advance(z) := block([mm, mi, kk, nu],
  mm : invert(cov) - gx * ident(2) + transpose(hx) . invert(vx) . hx,
  mi : invert(mm),
  kk : fx . mi . transpose(hx) . invert(vx),
  nu : z - hx . x,
  x : fx . x + kk . nu,
  cov : fx . mi . transpose(fx) + sw . transpose(sw),
  nu)$
show(tag, nu) := (
  printf(true, "~a innovation = [~a, ~a]~%", tag, rnum(nu[1,1]), rnum(nu[2,1])),
  printf(true, "~a x = [~a, ~a]~%", tag, rnum(x[1,1]), rnum(x[2,1])),
  printf(true, "~a P = [[~a, ~a], [~a, ~a]]~%", tag, rnum(cov[1,1]), rnum(cov[1,2]),
    rnum(cov[2,1]), rnum(cov[2,2])))$
show("step 1", hinf_advance(matrix([3/4], [1/2])))$
show("step 2", hinf_advance(matrix([7/4], [-1/4])))$
